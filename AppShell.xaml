<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MusicScoreManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MusicScoreManager"
    Title="MusicScoreManager"
    Shell.NavBarIsVisible="False">

    <TabBar x:Name="MainTabBar">
        <Tab x:Name="TabScores" Title="Partitions" Icon="🎵">
            <ShellContent ContentTemplate="{DataTemplate local:ScoresPage}" Route="ScoresPage" />
        </Tab>
        <Tab x:Name="TabSetlists" Title="Setlists" Icon="📋">
            <ShellContent ContentTemplate="{DataTemplate local:SetlistsPage}" Route="SetlistsPage" />
        </Tab>
        <Tab x:Name="TabTools" Title="Outils" Icon="🛠️">
            <ShellContent ContentTemplate="{DataTemplate local:ToolsPage}" Route="ToolsPage" />
        </Tab>
        <Tab x:Name="TabSettings" Title="Paramètres" Icon="⚙️">
            <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" Route="SettingsPage" />
        </Tab>
        <Tab x:Name="TabQuit" Title="Quitter" Icon="🚪">
            <ShellContent ContentTemplate="{DataTemplate local:QuitPage}" Route="QuitPage" />
        </Tab>
    </TabBar>

</Shell>
