<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MusicScoreManager.Models"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.ScoresPage"
             x:Name="ScoresPageRoot"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto, Auto, Auto" Margin="15,15,15,10" ColumnSpacing="10">
            <SearchBar Grid.Column="0"
                       x:Name="SearchScoreBar"
                       Placeholder="Rechercher..."
                       PlaceholderColor="#888888"
                       TextColor="#FFFFFF"
                       BackgroundColor="#1E1E1E"
                       TextChanged="OnSearchBarTextChanged" />
            
            <Button Grid.Column="1"
                    Text="🏷️"
                    FontSize="20"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="#333333"
                    TextColor="White"
                    Clicked="OnTagsFilterButtonClicked" />
            
            <Button Grid.Column="2"
                    Text="⇅"
                    FontSize="20"
                    FontAttributes="Bold"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="#333333"
                    TextColor="White"
                    Clicked="OnSortClicked" />

            <Button Grid.Column="3"
                    x:Name="MultiSelectToggleButton"
                    Text="☑"
                    FontSize="20"
                    FontAttributes="Bold"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="#333333"
                    TextColor="White"
                    Clicked="OnMultiSelectToggleClicked" />

            <Button Grid.Column="4"
                    Text="+"
                    FontSize="24"
                    FontAttributes="Bold"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="#007ACC"
                    TextColor="White"
                    Clicked="OnImportClicked" />
        </Grid>

        <ScrollView Grid.Row="1" 
                    Orientation="Horizontal" 
                    Margin="15,0,15,15" 
                    HeightRequest="40" 
                    x:Name="ActiveTagsScrollView" 
                    IsVisible="False">
            <HorizontalStackLayout x:Name="ActiveTagsStack" Spacing="10" VerticalOptions="Center" />
        </ScrollView>

        <CollectionView Grid.Row="2"
                        x:Name="ScoresCollectionView"
                        Margin="15,0"
                        SelectionMode="Single"
                        SelectionChanged="OnScoreSelected">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Score">
                    <Border Stroke="#333333" 
                            StrokeThickness="1" 
                            BackgroundColor="#1E1E1E" 
                            Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *, Auto">
                            <CheckBox Grid.Column="0" Grid.RowSpan="3"
                                      IsChecked="{Binding IsSelected}"
                                      IsVisible="{Binding Source={x:Reference ScoresPageRoot}, Path=IsMultiSelectActive}"
                                      VerticalOptions="Center"
                                      Margin="0,0,10,0"
                                      Color="#007ACC" />

                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                                <Label Text="⚠️" 
                                       TextColor="Red" 
                                       FontSize="16" 
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsFileMissing}" />
                                <Label Text="🔗" 
                                       TextColor="#007ACC" 
                                       FontSize="16" 
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsExternal}" />
                                <Label Text="{Binding Title}" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       VerticalOptions="Center" 
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsFileMissing}" Value="True">
                                            <Setter Property="TextColor" Value="Red" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsFileMissing}" Value="False">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>

                            <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                                    Text="⋮"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnScoreOptionsClicked" />
                                               <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding DisplaySubtitle}" 
                                   FontSize="12" 
                                   TextColor="#888888" 
                                   Margin="0,0,0,10"/>
                                   
                            <FlexLayout Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                        BindableLayout.ItemsSource="{Binding AppliedTags}"
                                        Wrap="Wrap"
                                        Direction="Row">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Tag">
                                        <Border BackgroundColor="{Binding ColorHex}"
                                                StrokeThickness="0"
                                                Padding="8,4,5,4"
                                                Margin="0,0,5,5">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Name, StringFormat='{0}  '}" 
                                                   TextColor="White" 
                                                   FontSize="12" 
                                                   FontAttributes="Bold" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label x:Name="EmptyScoresLabel"
                           Text="Chargement des partitions en cours..."
                           TextColor="#888888"
                           HorizontalOptions="Center" />
                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Overlay Menu Contextuel Partition Moderne & Ergonomique -->
        <ContentView x:Name="ScoreMenuOverlay" 
                     Grid.RowSpan="3"
                     IsVisible="False" 
                     BackgroundColor="#B0000000" 
                     ZIndex="1000">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuCancelClicked" />
            </ContentView.GestureRecognizers>
            <Border BackgroundColor="#1E1E1E" 
                    Stroke="#3A3A3A"
                    StrokeThickness="1"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    WidthRequest="350"
                    Padding="20"
                    Shadow="{Shadow Brush=Black, Offset='0,10', Radius=25, Opacity=0.6}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer /> <!-- Empêche la fermeture au clic dans la carte -->
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="10">
                    <!-- En-tête avec titre et bouton fermer -->
                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,6">
                        <Label Grid.Column="0" Text="🎵" FontSize="20" VerticalOptions="Center" Margin="0,0,8,0" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="ScoreMenuTitleLabel" 
                                   TextColor="White" 
                                   FontAttributes="Bold"
                                   FontSize="16" 
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label x:Name="ScoreMenuSubtitleLabel"
                                   TextColor="#888888"
                                   FontSize="12"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" 
                                Text="✕" 
                                TextColor="#AAAAAA" 
                                BackgroundColor="Transparent" 
                                FontSize="16" 
                                FontAttributes="Bold"
                                WidthRequest="36" 
                                HeightRequest="36" 
                                Padding="0"
                                Clicked="OnMenuCancelClicked" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#333333" Margin="0,0,0,4" />
                    
                    <!-- Action Principale : Ouvrir -->
                    <Button Text="📖  Ouvrir la partition" 
                            BackgroundColor="#007ACC" 
                            TextColor="White" 
                            FontSize="14" 
                            FontAttributes="Bold" 
                            CornerRadius="10" 
                            HeightRequest="46" 
                            Clicked="OnMenuOpenClicked" />

                    <!-- Action : Modifier les informations (En vert) -->
                    <Button Text="✏️  Éditer les informations" 
                            BackgroundColor="#1B3828" 
                            TextColor="#2ECC71" 
                            FontSize="14" 
                            FontAttributes="Bold"
                            CornerRadius="10" 
                            HeightRequest="44" 
                            Clicked="OnMenuEditClicked" />

                    <!-- Action : Modifier l'assemblage PDF (En dessous) -->
                    <Button x:Name="ScoreMenuModifyAssemblyButton"
                            Text="📑  Modifier l'assemblage PDF" 
                            BackgroundColor="#2A2A2A" 
                            TextColor="White" 
                            FontSize="14" 
                            CornerRadius="10" 
                            HeightRequest="44" 
                            Clicked="OnMenuModifyAssemblyClicked" />

                    <!-- Action : Wi-Fi Direct -->
                    <Button Text="📡  Envoyer en Wi-Fi Direct" 
                            BackgroundColor="#2A2A2A" 
                            TextColor="White" 
                            FontSize="14" 
                            CornerRadius="10" 
                            HeightRequest="44" 
                            Clicked="OnMenuExchangeClicked" />

                    <!-- Action : Exporter -->
                    <Button Text="📦  Exporter (.msmscore)" 
                            BackgroundColor="#2A2A2A" 
                            TextColor="White" 
                            FontSize="14" 
                            CornerRadius="10" 
                            HeightRequest="44" 
                            Clicked="OnMenuExportClicked" />

                    <!-- Action : Renommer -->
                    <Button Text="🏷️  Renommer" 
                            BackgroundColor="#2A2A2A" 
                            TextColor="White" 
                            FontSize="14" 
                            CornerRadius="10" 
                            HeightRequest="44" 
                            Clicked="OnMenuRenameClicked" />

                    <!-- Action : Supprimer (Stylisé destructif) -->
                    <Button Text="🗑️  Supprimer la partition" 
                            BackgroundColor="#3A1E1E" 
                            TextColor="#FF6B6B" 
                            FontSize="14" 
                            FontAttributes="Bold"
                            CornerRadius="10" 
                            HeightRequest="44" 
                            Clicked="OnMenuDeleteClicked" />
                </VerticalStackLayout>
            </Border>
        </ContentView>
        <!-- Overlay de Filtrage et Tri des Étiquettes -->
        <ContentView x:Name="TagsFilterOverlay" 
                     Grid.RowSpan="3"
                     IsVisible="False" 
                     BackgroundColor="#A0000000" 
                     ZIndex="999">
            <Border BackgroundColor="#1E1E1E" 
                    Stroke="#333333"
                    StrokeThickness="1.5"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    WidthRequest="360"
                    MaximumHeightRequest="600"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" RowSpacing="15">
                    
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="Filtrer par étiquettes" 
                               TextColor="White" 
                               FontAttributes="Bold"
                               FontSize="18" 
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="✕"
                               TextColor="#888888"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="5">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTagsFilterCloseClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Barre de recherche pour étiquettes -->
                    <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               x:Name="TagSearchEntry"
                               Placeholder="Rechercher une étiquette..."
                               PlaceholderColor="#888888"
                               TextColor="White"
                               BackgroundColor="#2A2A2A"
                               HeightRequest="40"
                               TextChanged="OnTagSearchEntryTextChanged" />
                        <Button Grid.Column="1"
                                Text="⇅"
                                ToolTipProperties.Text="Trier les étiquettes"
                                BackgroundColor="#333333"
                                TextColor="White"
                                WidthRequest="40"
                                HeightRequest="40"
                                Clicked="OnTagSortClicked" />
                    </Grid>

                    <!-- Infos de tri actuel -->
                    <Label Grid.Row="2"
                           x:Name="TagSortIndicatorLabel"
                           Text="Tri : A-Z"
                           TextColor="#888888"
                           FontSize="12"
                           Margin="0,-5,0,0" />

                    <!-- Liste des étiquettes (Scrollable) -->
                    <ScrollView Grid.Row="3" VerticalScrollBarVisibility="Always" HeightRequest="200" Margin="0,5">
                        <FlexLayout x:Name="OverlayTagsContainer" 
                                    Wrap="Wrap" 
                                    Direction="Row" 
                                    JustifyContent="Start" 
                                    AlignItems="Start" 
                                    AlignContent="Start" />
                    </ScrollView>

                    <!-- Actions bas de page -->
                    <Grid Grid.Row="4" ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,5,0,0">
                        <Button Grid.Column="0"
                                Text="Tout effacer"
                                BackgroundColor="#333333"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="44"
                                Clicked="OnClearAllTagsClicked" />
                        <Button Grid.Column="1"
                                Text="Appliquer"
                                BackgroundColor="#007ACC"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="44"
                                Clicked="OnApplyTagsFilterClicked" />
                    </Grid>
                </Grid>
            </Border>
        </ContentView>

        <!-- Barre d'actions Multi-Sélection -->
        <Border Grid.Row="2"
                x:Name="MultiSelectActionBar"
                IsVisible="False"
                BackgroundColor="#1A1A1A"
                Stroke="#007ACC"
                StrokeThickness="1.5"
                HeightRequest="80"
                Margin="15,0,15,15"
                VerticalOptions="End"
                ZIndex="500">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" Padding="10,10" ColumnSpacing="6" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label x:Name="SelectedCountLabel"
                           Text="0 sélectionné"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="12" />
                    <Label Text="Actions groupées"
                           TextColor="#888888"
                           FontSize="10" />
                </VerticalStackLayout>
                
                <Button Grid.Column="1"
                        Text="🗑️"
                        BackgroundColor="#CC2929"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="42"
                        WidthRequest="42"
                        CornerRadius="8"
                        Clicked="OnBulkDeleteClicked" />
                <Button Grid.Column="2"
                        Text="🏷️ Étiquettes"
                        BackgroundColor="#8E44AD"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="42"
                        CornerRadius="8"
                        Clicked="OnBulkTagsClicked" />
                <Button Grid.Column="3"
                        Text="📦 Exporter"
                        BackgroundColor="#2ECC71"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="42"
                        CornerRadius="8"
                        Clicked="OnBulkExportClicked" />
                <Button Grid.Column="4"
                        Text="📤 Envoyer"
                        BackgroundColor="#007ACC"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="42"
                        CornerRadius="8"
                        Clicked="OnBulkExchangeClicked" />
            </Grid>
        </Border>

        <!-- Modal Overlay Attribuer des Étiquettes en masse -->
        <ContentView x:Name="BulkTagsOverlay" 
                     Grid.RowSpan="3"
                     IsVisible="False" 
                     BackgroundColor="#A0000000" 
                     ZIndex="1010">
            <Border BackgroundColor="#1E1E1E" 
                    Stroke="#8E44AD"
                    StrokeThickness="1.5"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    WidthRequest="360"
                    MaximumHeightRequest="600"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" RowSpacing="14">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               x:Name="BulkTagsHeaderLabel"
                               Text="🏷️ Ajouter des étiquettes" 
                               TextColor="White" 
                               FontAttributes="Bold"
                               FontSize="17" 
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="✕"
                               TextColor="#888888"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="5">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBulkTagsCloseClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <Label Grid.Row="1"
                           Text="Sélectionnez les étiquettes à appliquer à toutes les partitions cochées :" 
                           TextColor="#AAAAAA" 
                           FontSize="12" />

                    <!-- Barre de recherche -->
                    <Entry Grid.Row="2"
                           x:Name="BulkTagSearchEntry"
                           Placeholder="Rechercher une étiquette..."
                           PlaceholderColor="#888888"
                           TextColor="White"
                           BackgroundColor="#2A2A2A"
                           HeightRequest="40"
                           TextChanged="OnBulkTagSearchEntryTextChanged" />

                    <!-- Liste des étiquettes sélectionnables -->
                    <ScrollView Grid.Row="3" HeightRequest="200">
                        <FlexLayout x:Name="BulkTagsContainer" 
                                    Wrap="Wrap" 
                                    Direction="Row" 
                                    AlignItems="Start" 
                                    AlignContent="Start" />
                    </ScrollView>

                    <!-- Boutons Annuler / Appliquer -->
                    <Grid Grid.Row="4" ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,5,0,0">
                        <Button Grid.Column="0" 
                                Text="Annuler" 
                                BackgroundColor="#444444" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                HeightRequest="44" 
                                CornerRadius="8" 
                                Clicked="OnBulkTagsCloseClicked" />
                        <Button Grid.Column="1" 
                                Text="Appliquer" 
                                BackgroundColor="#8E44AD" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                HeightRequest="44" 
                                CornerRadius="8" 
                                Clicked="OnApplyBulkTagsClicked" />
                    </Grid>
                </Grid>
            </Border>
        </ContentView>

        <!-- Overlay Transfert Wi-Fi Direct & Diffusion Groupe (P2P) -->
        <ContentView x:Name="WifiOverlay"
                     IsVisible="False"
                     BackgroundColor="#AA000000"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill"
                     ZIndex="1005">
            <Border BackgroundColor="#1E1E1E"
                    Stroke="#333333"
                    StrokeThickness="1"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="380"
                    HeightRequest="650"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto, *, Auto" RowSpacing="15">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <Label x:Name="WifiOverlayTitle"
                               Text="📡 Transfert Wi-Fi Direct" 
                               TextColor="White" 
                               FontAttributes="Bold"
                               FontSize="18" 
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="✕"
                               TextColor="#888888"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="5">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWifiCloseClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Content Area -->
                    <Grid Grid.Row="1" x:Name="WifiContentGrid">
                        <!-- Mode Choix Initial (Si ouvert hors d'une sélection de scores) -->
                        <VerticalStackLayout x:Name="WifiChoiceView" Spacing="15" IsVisible="True" VerticalOptions="Center">
                            <Label Text="Que souhaitez-vous faire ?" TextColor="#AAAAAA" HorizontalOptions="Center" Margin="0,0,0,10" />
                            <Button Text="🟢 Se mettre en mode Écoute (Recevoir)"
                                    BackgroundColor="#2A2A2A"
                                    TextColor="White"
                                    BorderColor="#2ECC71"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    HeightRequest="50"
                                    Clicked="OnWifiStartListeningClicked" />
                            <Label Text="Pour envoyer des partitions, sélectionnez-les d'abord avec le mode Multi-Sélection (bouton ☑)." 
                                   TextColor="#888888" 
                                   FontSize="12" 
                                   HorizontalOptions="Center" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Mode Écoute (Receveur) -->
                        <VerticalStackLayout x:Name="WifiListeningView" Spacing="20" IsVisible="False" VerticalOptions="Center">
                            <ActivityIndicator IsRunning="True" Color="#2ECC71" HeightRequest="50" WidthRequest="50" HorizontalOptions="Center" />
                            <Label Text="En attente de connexion..." TextColor="White" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
                            <Label x:Name="WifiListeningStatusLabel" 
                                   Text="Prêt à recevoir des partitions d'un émetteur en Wi-Fi Direct." 
                                   TextColor="#AAAAAA" 
                                   HorizontalOptions="Center" 
                                   HorizontalTextAlignment="Center" />
                            <Button Text="Arrêter l'écoute"
                                    BackgroundColor="#CC2929"
                                    TextColor="White"
                                    CornerRadius="8"
                                    HeightRequest="40"
                                    Clicked="OnWifiStopListeningClicked" />
                        </VerticalStackLayout>

                        <!-- Mode Envoi (Émetteur : Liste 1-à-1 ET Bouton Mode Groupe QR) -->
                        <Grid x:Name="WifiSendingView" RowDefinitions="Auto, *, Auto, Auto" RowSpacing="10" IsVisible="False">
                            <VerticalStackLayout Grid.Row="0" Spacing="4">
                                <Label Text="Appareils Wi-Fi Direct détectés :" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                <Label Text="Cliquez sur un destinataire pour lui envoyer directement." TextColor="#888888" FontSize="11" />
                                <ActivityIndicator x:Name="WifiScanSpinner" IsRunning="True" Color="#007ACC" HeightRequest="18" WidthRequest="18" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                            
                            <!-- Liste d'appareils -->
                            <ListView Grid.Row="1" 
                                      x:Name="WifiDevicesListView" 
                                      BackgroundColor="Transparent"
                                      SeparatorColor="#333333"
                                      HasUnevenRows="True"
                                      ItemSelected="OnWifiDeviceSelected">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="services:WifiDeviceInfo">
                                        <ViewCell>
                                            <Grid ColumnDefinitions="Auto, *, Auto" Padding="10,6" ColumnSpacing="10">
                                                <Label Grid.Column="0" Text="📱" FontSize="20" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                                    <Label Text="{Binding IpAddress}" TextColor="#888888" FontSize="11" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="2" 
                                                        Text="Envoyer" 
                                                        BackgroundColor="#007ACC" 
                                                        TextColor="White" 
                                                        FontSize="12" 
                                                        FontAttributes="Bold" 
                                                        HeightRequest="34" 
                                                        CornerRadius="6" 
                                                        Clicked="OnSendToDeviceButtonClicked" 
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            
                            <!-- Bouton Diffusion Groupe QR Code -->
                            <Button Grid.Row="2" 
                                    x:Name="ToggleGroupShareButton"
                                    Text="📲 Mode Diffusion Groupe (QR Code)"
                                    BackgroundColor="#2C2C2C"
                                    BorderColor="#FF3366"
                                    BorderWidth="1"
                                    TextColor="#FF3366"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="42"
                                    Clicked="OnToggleGroupShareClicked" />

                            <Button Grid.Row="3" 
                                    Text="🔄 Relancer la recherche"
                                    BackgroundColor="#1A1A1A"
                                    TextColor="#AAAAAA"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    Clicked="OnWifiRescanClicked" />
                        </Grid>

                        <!-- Vue Partage de Groupe QR Code (Leader) -->
                        <VerticalStackLayout x:Name="WifiGroupQrView" Spacing="12" IsVisible="False" VerticalOptions="Center">
                            <Label Text="Scannez pour télécharger la sélection" TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                            <Border Stroke="#007ACC" StrokeThickness="2" BackgroundColor="White" Padding="8" WidthRequest="220" HeightRequest="220" HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Image x:Name="QrCodeImageView" WidthRequest="200" HeightRequest="200" Aspect="AspectFit" />
                            </Border>
                            <Label x:Name="QrGroupInfoLabel" Text="En attente de musiciens..." TextColor="#2ECC71" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label x:Name="QrGroupUrlLabel" Text="http://..." TextColor="#888888" FontSize="11" HorizontalOptions="Center" />
                            <Label Text="💡 Les tablettes doivent être sur le même Wi-Fi ou connectées au point d'accès de cette tablette" 
                                   TextColor="#AAAAAA" 
                                   FontSize="11" 
                                   HorizontalOptions="Center" 
                                   HorizontalTextAlignment="Center" 
                                   Margin="10,0" />
                            <Button Text="Fermer le partage de groupe"
                                    BackgroundColor="#CC2929"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="40"
                                    Clicked="OnStopGroupShareClicked" />
                        </VerticalStackLayout>

                        <!-- Mode Transfert en cours -->
                        <VerticalStackLayout x:Name="WifiTransferProgressView" Spacing="16" IsVisible="False" VerticalOptions="Center">
                            <ActivityIndicator IsRunning="True" Color="#007ACC" HeightRequest="50" WidthRequest="50" HorizontalOptions="Center" />
                            <Label x:Name="WifiTransferStatusLabel" 
                                   Text="Transfert en cours... 0%" 
                                   TextColor="White" 
                                   FontAttributes="Bold" 
                                   FontSize="15" 
                                   HorizontalOptions="Center" 
                                   HorizontalTextAlignment="Center" />
                            <ProgressBar x:Name="WifiTransferProgressBar" Progress="0" ProgressColor="#007ACC" HeightRequest="8" HorizontalOptions="Fill" />
                            <Label x:Name="WifiTransferSpeedLabel" Text="0.0 Mo/s" TextColor="#00B0FF" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Status Bar / Footer -->
                    <Label Grid.Row="2"
                           x:Name="WifiOverlayFooter"
                           Text="Wi-Fi Direct P2P &amp; Local Hotspot (Haute Vitesse)"
                           TextColor="#555555"
                           FontSize="10"
                           HorizontalOptions="Center" />
                </Grid>
            </Border>
        </ContentView>
    </Grid>

</ContentPage>
