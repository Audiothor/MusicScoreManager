<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MusicScoreManager.Models"
             x:Class="MusicScoreManager.ScoresPage"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto, Auto" Margin="15,15,15,10" ColumnSpacing="10">
            <SearchBar Grid.Column="0"
                       x:Name="SearchScoreBar"
                       Placeholder="Rechercher..."
                       PlaceholderColor="#888888"
                       TextColor="#FFFFFF"
                       BackgroundColor="#1E1E1E"
                       TextChanged="OnSearchBarTextChanged" />
            
            <Button Grid.Column="1"
                    Text="🏷️"
                    FontSize="20"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="#333333"
                    TextColor="White"
                    Clicked="OnTagsFilterButtonClicked" />
            
            <Button Grid.Column="2"
                    Text="⇅"
                    FontSize="20"
                    FontAttributes="Bold"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="#333333"
                    TextColor="White"
                    Clicked="OnSortClicked" />

            <Button Grid.Column="3"
                    Text="+"
                    FontSize="24"
                    FontAttributes="Bold"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="#007ACC"
                    TextColor="White"
                    Clicked="OnImportClicked" />
        </Grid>

        <ScrollView Grid.Row="1" 
                    Orientation="Horizontal" 
                    Margin="15,0,15,15" 
                    HeightRequest="40" 
                    x:Name="ActiveTagsScrollView" 
                    IsVisible="False">
            <HorizontalStackLayout x:Name="ActiveTagsStack" Spacing="10" VerticalOptions="Center" />
        </ScrollView>

        <CollectionView Grid.Row="2"
                        x:Name="ScoresCollectionView"
                        Margin="15,0"
                        SelectionMode="Single"
                        SelectionChanged="OnScoreSelected">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Score">
                    <Border Stroke="#333333" 
                            StrokeThickness="1" 
                            BackgroundColor="#1E1E1E" 
                            Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto, Auto">
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                                <Label Text="⚠️" 
                                       TextColor="Red" 
                                       FontSize="16" 
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsFileMissing}" />
                                <Label Text="🔗" 
                                       TextColor="#007ACC" 
                                       FontSize="16" 
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsExternal}" />
                                <Label Text="{Binding Title}" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       VerticalOptions="Center" 
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsFileMissing}" Value="True">
                                            <Setter Property="TextColor" Value="Red" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsFileMissing}" Value="False">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                                   
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Type}" 
                                   FontSize="12" 
                                   TextColor="#AAAAAA" 
                                   VerticalOptions="Center"
                                   Margin="0,0,10,0" />

                            <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                                    Text="⋮"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnScoreOptionsClicked" />
                                   
                            <Label Grid.Row="1" Grid.ColumnSpan="2"
                                   Text="{Binding DateAdded, StringFormat='{0:dd/MM/yyyy}'}" 
                                   FontSize="12" 
                                   TextColor="#888888" 
                                   Margin="0,0,0,10"/>
                                   
                            <FlexLayout Grid.Row="2" Grid.ColumnSpan="3"
                                        BindableLayout.ItemsSource="{Binding AppliedTags}"
                                        Wrap="Wrap"
                                        Direction="Row">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Tag">
                                        <Border BackgroundColor="{Binding ColorHex}"
                                                StrokeThickness="0"
                                                Padding="8,4"
                                                Margin="0,0,5,5">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Name}" 
                                                   TextColor="White" 
                                                   FontSize="12" 
                                                   FontAttributes="Bold" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="Aucune partition trouvée."
                           TextColor="#888888"
                           HorizontalOptions="Center" />
                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Croix ultra-discrète en bas à droite -->
        <Label Grid.Row="2"
               Text="✕"
               TextColor="#444444"
               FontSize="20"
               HorizontalOptions="End"
               VerticalOptions="End"
               Margin="0,0,5,5"
               ZIndex="100">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnExitClicked" />
            </Label.GestureRecognizers>
        </Label>

        <!-- Overlay Menu Contextuel Partition -->
        <ContentView x:Name="ScoreMenuOverlay" 
                     Grid.RowSpan="3"
                     IsVisible="False" 
                     BackgroundColor="#80000000" 
                     ZIndex="1000">
            <Border BackgroundColor="White" 
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    WidthRequest="320"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="2" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="18">
                    <Label x:Name="ScoreMenuTitleLabel" 
                           TextColor="Black" 
                           FontSize="16" 
                           Margin="0,0,0,5" />
                    
                    <Label Text="Éditer" TextColor="#444444" FontSize="15">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuEditClicked" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Renommer" TextColor="#444444" FontSize="15">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuRenameClicked" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Supprimer" TextColor="#444444" FontSize="15">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuDeleteClicked" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Annuler" 
                           TextColor="Black" 
                           FontAttributes="Bold" 
                           FontSize="15" 
                           HorizontalOptions="End" 
                           Margin="0,10,5,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuCancelClicked" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </ContentView>
        <!-- Overlay de Filtrage et Tri des Étiquettes -->
        <ContentView x:Name="TagsFilterOverlay" 
                     Grid.RowSpan="3"
                     IsVisible="False" 
                     BackgroundColor="#A0000000" 
                     ZIndex="999">
            <Border BackgroundColor="#1E1E1E" 
                    Stroke="#333333"
                    StrokeThickness="1.5"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    WidthRequest="360"
                    MaximumHeightRequest="600"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" RowSpacing="15">
                    
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="Filtrer par étiquettes" 
                               TextColor="White" 
                               FontAttributes="Bold"
                               FontSize="18" 
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="✕"
                               TextColor="#888888"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="5">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTagsFilterCloseClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Barre de recherche pour étiquettes -->
                    <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               x:Name="TagSearchEntry"
                               Placeholder="Rechercher une étiquette..."
                               PlaceholderColor="#888888"
                               TextColor="White"
                               BackgroundColor="#2A2A2A"
                               HeightRequest="40"
                               TextChanged="OnTagSearchEntryTextChanged" />
                        <Button Grid.Column="1"
                                Text="⇅"
                                ToolTipProperties.Text="Trier les étiquettes"
                                BackgroundColor="#333333"
                                TextColor="White"
                                WidthRequest="40"
                                HeightRequest="40"
                                Clicked="OnTagSortClicked" />
                    </Grid>

                    <!-- Infos de tri actuel -->
                    <Label Grid.Row="2"
                           x:Name="TagSortIndicatorLabel"
                           Text="Tri : A-Z"
                           TextColor="#888888"
                           FontSize="12"
                           Margin="0,-5,0,0" />

                    <!-- Liste des étiquettes (Scrollable) -->
                    <ScrollView Grid.Row="3" VerticalScrollBarVisibility="Always" HeightRequest="200" Margin="0,5">
                        <FlexLayout x:Name="OverlayTagsContainer" 
                                    Wrap="Wrap" 
                                    Direction="Row" 
                                    JustifyContent="Start" 
                                    AlignItems="Start" 
                                    AlignContent="Start" />
                    </ScrollView>

                    <!-- Actions bas de page -->
                    <Grid Grid.Row="4" ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,5,0,0">
                        <Button Grid.Column="0"
                                Text="Tout effacer"
                                BackgroundColor="#333333"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="44"
                                Clicked="OnClearAllTagsClicked" />
                        <Button Grid.Column="1"
                                Text="Appliquer"
                                BackgroundColor="#007ACC"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="44"
                                Clicked="OnApplyTagsFilterClicked" />
                    </Grid>
                </Grid>
            </Border>
        </ContentView>
    </Grid>

</ContentPage>
