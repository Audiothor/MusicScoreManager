<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicScoreManager.WifiTransferPage"
             BackgroundColor="#121212"
             Title="Transfert Wi-Fi Direct">

    <Grid RowDefinitions="Auto, *">
        <!-- Header personnalisé avec bouton Retour -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="← Retour" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" 
                   Text="Transfert Wi-Fi Direct (P2P)" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"
                   Margin="0,0,80,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="20">
                <!-- Présentation / État Wi-Fi -->
                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Grid.Column="0" Text="📡" FontSize="26" VerticalOptions="Center" Margin="0,0,10,0" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Échange Ultra-Rapide Sans Box ni Internet" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Transférez des partitions et setlists complètes entre tablettes en quelques secondes." TextColor="#888888" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#2A2A2A" Margin="0,5" />

                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Nom de votre appareil :" TextColor="#888888" FontSize="12" />
                                <Label x:Name="DeviceNameLabel" Text="Tablette Musique" TextColor="#00B0FF" FontSize="14" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <Label x:Name="StatusBadgeLabel" Grid.Column="1" Text="⚫ En veille" TextColor="#AAAAAA" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Section 1 : Réception 1-à-1 Directe -->
                <Label Text="1. Réception Directe (1-à-1)" TextColor="#007ACC" FontSize="16" FontAttributes="Bold" />
                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Activez la réception pour que les musiciens autour de vous puissent vous envoyer directement leurs partitions ou setlists." TextColor="#AAAAAA" FontSize="12" />

                        <Button x:Name="ToggleReceiveButton"
                                Text="🟢 Activer la Réception (Se rendre visible)"
                                BackgroundColor="#2ECC71"
                                TextColor="White"
                                FontAttributes="Bold"
                                HeightRequest="48"
                                CornerRadius="8"
                                Clicked="OnToggleReceiveClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section 2 : Scanner un Partage de Groupe (QR Code) -->
                <Label Text="2. Partage de Groupe (Flashcode / QR Code)" TextColor="#FF3366" FontSize="16" FontAttributes="Bold" />
                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Si le chef de groupe ou un collègue diffuse une setlist via QR Code, entrez l'adresse ou scannez pour télécharger instantanément." TextColor="#AAAAAA" FontSize="12" />

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Entry x:Name="QrAddressEntry"
                                   Placeholder="ex: http://192.168.49.1:8765/msm_package/"
                                   PlaceholderColor="#666666"
                                   TextColor="White"
                                   BackgroundColor="#2A2A2A"
                                   FontSize="13"
                                   HeightRequest="45" />
                            <Button Grid.Column="1"
                                    Text="📥 Télécharger"
                                    BackgroundColor="#007ACC"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    HeightRequest="45"
                                    CornerRadius="8"
                                    Clicked="OnDownloadQrClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Zone de progression en temps réel -->
                <Border x:Name="ProgressBorder" IsVisible="false" Stroke="#007ACC" StrokeThickness="1" BackgroundColor="#1E2836" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label x:Name="ProgressStatusLabel" Text="Transfert en cours..." TextColor="White" FontSize="13" FontAttributes="Bold" />
                            <Label x:Name="ProgressSpeedLabel" Grid.Column="1" Text="0.0 Mo/s" TextColor="#00B0FF" FontSize="13" FontAttributes="Bold" />
                        </Grid>
                        <ProgressBar x:Name="TransferProgressBar" Progress="0.0" ProgressColor="#007ACC" HeightRequest="8" />
                        <Label x:Name="ProgressDetailsLabel" Text="0 / 0 Mo" TextColor="#888888" FontSize="11" HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="20" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
