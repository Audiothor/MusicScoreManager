<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.ScoreEditPage"
             BackgroundColor="#121212"
             Title="{Binding [Score_Edit_Title], Source={x:Static services:LocalizationService.Instance}}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header personnalisé avec titre grand et lisible -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="12,14" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="{Binding [Common_Back], Source={x:Static services:LocalizationService.Instance}}" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontSize="16"
                    FontAttributes="Bold"
                    Clicked="OnCancelClicked" />
            <Label Grid.Column="1" 
                   Text="{Binding [Score_Edit_Header], Source={x:Static services:LocalizationService.Instance}}" 
                   TextColor="White" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"
                   Margin="0,0,70,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18" Margin="20">
                
                <!-- Alerte Fichier PDF manquant / introuvable -->
                <Border x:Name="MissingFileWarningBorder"
                        BackgroundColor="#331A1A" 
                        Stroke="#FF3B30" 
                        StrokeThickness="1.5" 
                        Padding="14,12"
                        IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <Border Grid.Column="0" 
                                BackgroundColor="#FF3B30" 
                                StrokeThickness="0" 
                                WidthRequest="28" 
                                HeightRequest="28" 
                                VerticalOptions="Center" 
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label Text="!" 
                                   TextColor="White" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   Margin="0,-1,0,0" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding [Score_Edit_MissingFile_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="#FF6B6B" FontSize="14" FontAttributes="Bold" />
                            <Label Text="{Binding [Score_Edit_MissingFile_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#DDDDDD" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 1. TITRE -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding [Score_Edit_Field_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="14" FontAttributes="Bold" />
                    <Entry x:Name="TitleEntry" 
                           TextColor="White" 
                           BackgroundColor="#1E1E1E" 
                           FontSize="16"
                           HeightRequest="48"
                           Placeholder="{Binding [Score_Edit_Placeholder_Title], Source={x:Static services:LocalizationService.Instance}}"
                           PlaceholderColor="#555555"
                           ClearButtonVisibility="WhileEditing" />
                </VerticalStackLayout>

                <!-- 2. COMPOSITEUR -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding [Score_Edit_Field_Composer], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="14" FontAttributes="Bold" />
                    <Entry x:Name="ComposerEntry" 
                           TextColor="White" 
                           BackgroundColor="#1E1E1E" 
                           FontSize="15"
                           HeightRequest="48"
                           Placeholder="{Binding [Score_Edit_Placeholder_Composer], Source={x:Static services:LocalizationService.Instance}}"
                           PlaceholderColor="#555555"
                           ClearButtonVisibility="WhileEditing" />
                </VerticalStackLayout>

                <!-- Informations non modifiables du fichier (Taille, Modifié le, Ajouté le, Annotations) -->
                <Border BackgroundColor="#1A1E24" Stroke="#2A303C" StrokeThickness="1" Padding="12,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="6" ColumnSpacing="10">
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding [Score_Edit_Meta_Size], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="12" />
                            <Label x:Name="FileSizeLabel" Text="--" TextColor="#4CAF50" FontSize="12" FontAttributes="Bold" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding [Score_Edit_Meta_Modified], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="12" />
                            <Label x:Name="FileModifiedDateLabel" Text="--" TextColor="#007ACC" FontSize="12" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding [Score_Edit_Meta_Created], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="12" />
                            <Label x:Name="FileCreatedDateLabel" Text="--" TextColor="#E0E0E0" FontSize="12" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding [Score_Edit_Meta_Annotations], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="12" />
                            <Label x:Name="AnnotationsLabel" Text="--" TextColor="#FFA500" FontSize="12" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Raccourci vers l'Atelier d'Assemblage PDF -->
                <Border x:Name="ModifyAssemblyBorder"
                        BackgroundColor="#1A2F4C" Stroke="#007ACC" StrokeThickness="1" Padding="12,10"
                        IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding [Score_Edit_Assembly_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="#64B5F6" FontSize="13" FontAttributes="Bold" />
                            <Label Text="{Binding [Score_Edit_Assembly_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="11" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="{Binding [Score_Edit_Assembly_Btn], Source={x:Static services:LocalizationService.Instance}}"
                                BackgroundColor="#007ACC"
                                TextColor="White"
                                FontSize="12"
                                FontAttributes="Bold"
                                HeightRequest="36"
                                CornerRadius="6"
                                Clicked="OnModifyAssemblyClicked" />
                    </Grid>
                </Border>

                <!-- 3. ÉTIQUETTES / TAGS (Au dessus de Tempo & Tonalité) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding [Score_Edit_Tags], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="14" FontAttributes="Bold" />
                    
                    <FlexLayout x:Name="SelectedTagsFlexLayout" Wrap="Wrap" Direction="Row" AlignItems="Start">
                        <Button Text="+" 
                                BackgroundColor="#333333" 
                                TextColor="White" 
                                FontSize="20" 
                                FontAttributes="Bold"
                                WidthRequest="40" 
                                HeightRequest="40" 
                                CornerRadius="20"
                                Margin="0,0,0,10"
                                Clicked="OnAddTagClicked" />
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- 4. TEMPO & TONALITÉ (2 colonnes) -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                    <!-- Tempo -->
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="{Binding [Score_Edit_Tempo], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="14" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                            <Entry x:Name="BpmEntry" 
                                   Text="120" 
                                   Keyboard="Numeric" 
                                   TextColor="White" 
                                   BackgroundColor="#1E1E1E" 
                                   HorizontalTextAlignment="Center" 
                                   HeightRequest="48" 
                                   FontSize="15" />
                            <Stepper Grid.Column="1" 
                                     x:Name="BpmStepper" 
                                     Minimum="40" 
                                     Maximum="250" 
                                     Increment="1" 
                                     Value="120"
                                     VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Tonalité -->
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="{Binding [Score_Edit_Key], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="14" FontAttributes="Bold" />
                        <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" HeightRequest="48" Padding="10,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Picker x:Name="KeyPicker" 
                                    TextColor="White" 
                                    BackgroundColor="Transparent" 
                                    Title="{Binding [Score_Edit_Key_Placeholder], Source={x:Static services:LocalizationService.Instance}}" 
                                    TitleColor="#777777" 
                                    FontSize="14"
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- 5. ÉVALUATION (Étoiles) -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding [Score_Edit_Rating], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="14" FontAttributes="Bold" />
                    <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="12,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Button x:Name="Star1Btn" Text="★" TextColor="#555555" BackgroundColor="Transparent" FontSize="26" WidthRequest="40" HeightRequest="40" Padding="0" Clicked="OnStarClicked" CommandParameter="1" />
                                <Button x:Name="Star2Btn" Text="★" TextColor="#555555" BackgroundColor="Transparent" FontSize="26" WidthRequest="40" HeightRequest="40" Padding="0" Clicked="OnStarClicked" CommandParameter="2" />
                                <Button x:Name="Star3Btn" Text="★" TextColor="#555555" BackgroundColor="Transparent" FontSize="26" WidthRequest="40" HeightRequest="40" Padding="0" Clicked="OnStarClicked" CommandParameter="3" />
                                <Button x:Name="Star4Btn" Text="★" TextColor="#555555" BackgroundColor="Transparent" FontSize="26" WidthRequest="40" HeightRequest="40" Padding="0" Clicked="OnStarClicked" CommandParameter="4" />
                                <Button x:Name="Star5Btn" Text="★" TextColor="#555555" BackgroundColor="Transparent" FontSize="26" WidthRequest="40" HeightRequest="40" Padding="0" Clicked="OnStarClicked" CommandParameter="5" />
                            </HorizontalStackLayout>
                            
                            <Label Grid.Column="1" x:Name="RatingTextLabel" Text="Non notée" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center" Margin="10,0,0,0" />

                            <Button Grid.Column="2" 
                                    x:Name="ClearRatingBtn"
                                    Text="{Binding [Score_Edit_Rating_Clear], Source={x:Static services:LocalizationService.Instance}}" 
                                    TextColor="#888888" 
                                    BackgroundColor="Transparent" 
                                    FontSize="12" 
                                    Padding="8,0"
                                    HeightRequest="36" 
                                    Clicked="OnClearRatingClicked" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- 6. CHEMIN DU FICHIER -->
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="6">
                        <Label x:Name="FilePathTitleLabel" Text="{Binding [Score_Edit_FilePath], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                        <Label x:Name="ExternalScoreIcon" Text="🔗" TextColor="#007ACC" FontSize="16" VerticalOptions="Center" IsVisible="False" />
                        <Label x:Name="ExternalScoreLabel" Text="{Binding [Score_Edit_External], Source={x:Static services:LocalizationService.Instance}}" TextColor="#007ACC" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" IsVisible="False" />
                    </HorizontalStackLayout>
                    
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Entry x:Name="PathEntry" 
                               TextColor="White" 
                               BackgroundColor="#1E1E1E" 
                               FontSize="13"
                               HeightRequest="48"
                               ClearButtonVisibility="WhileEditing" />
                        <Button Grid.Column="1" 
                                x:Name="ImportScoreButton"
                                Text="{Binding [Score_Edit_Import], Source={x:Static services:LocalizationService.Instance}}" 
                                IsVisible="False"
                                BackgroundColor="#007ACC" 
                                TextColor="White" 
                                HeightRequest="48"
                                Padding="12,0"
                                Clicked="OnImportScoreToLibraryClicked" />
                    </Grid>
                </VerticalStackLayout>

                <!-- ACCORDÉON 1 : MÉTRONOME (Fermé par défaut) -->
                <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="14,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Label Grid.Column="0" Text="⏱️" FontSize="18" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Label Grid.Column="1" Text="{Binding [Score_Edit_Metronome], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="2" x:Name="MetronomeAccordionArrow" Text="▶" TextColor="#007ACC" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleMetronomeAccordionTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        
                        <VerticalStackLayout x:Name="MetronomeAccordionBody" IsVisible="False" Spacing="12" Margin="0,8,0,0">
                            <BoxView HeightRequest="1" Color="#333333" />
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding [Score_Edit_Metronome_Auto], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" VerticalOptions="Center" />
                                <Switch Grid.Column="1" x:Name="MetronomeSwitch" OnColor="#007ACC" ThumbColor="White" />
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding [Score_Edit_Metronome_Sound], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" VerticalOptions="Center" />
                                <Switch Grid.Column="1" x:Name="MetronomeSoundSwitch" OnColor="#007ACC" ThumbColor="White" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ACCORDÉON 2 : FICHIERS AUDIO (Fermé par défaut) -->
                <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="14,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Label Grid.Column="0" Text="🎵" FontSize="18" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Label Grid.Column="1" x:Name="AudioAccordionTitleLabel" Text="{Binding [Score_Edit_Audio_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="2" x:Name="AudioAccordionArrow" Text="▶" TextColor="#007ACC" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleAudioAccordionTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        
                        <VerticalStackLayout x:Name="AudioAccordionBody" IsVisible="False" Spacing="12" Margin="0,8,0,0">
                            <BoxView HeightRequest="1" Color="#333333" />
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding [Score_Edit_Audio_Auto], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" VerticalOptions="Center" />
                                <Switch Grid.Column="1" x:Name="AudioPlayerSwitch" OnColor="#007ACC" ThumbColor="White" />
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding [Score_Edit_Precount], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="10">
                                    <Entry x:Name="PreCountEntry" Text="4" Keyboard="Numeric" WidthRequest="60" TextColor="White" BackgroundColor="#121212" HorizontalTextAlignment="Center" />
                                    <Stepper x:Name="PreCountStepper" Minimum="0" Maximum="8" Increment="1" Value="4" />
                                </HorizontalStackLayout>
                            </Grid>

                            <VerticalStackLayout x:Name="AudioFilesList" Spacing="10" />

                            <Button Text="{Binding [Score_Edit_Add_Audio], Source={x:Static services:LocalizationService.Instance}}" 
                                    BackgroundColor="#333333" 
                                    TextColor="White" 
                                    HorizontalOptions="Start"
                                    Clicked="OnAddAudioClicked" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
 
                 <!-- ACCORDÉON 3 : ANNOTATIONS (Fermé par défaut) -->
                 <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="14,12">
                     <Border.StrokeShape>
                         <RoundRectangle CornerRadius="10" />
                     </Border.StrokeShape>
                     <VerticalStackLayout Spacing="10">
                         <Grid ColumnDefinitions="Auto, *, Auto">
                             <Label Grid.Column="0" Text="🖍️" FontSize="18" VerticalOptions="Center" Margin="0,0,8,0" />
                             <Label Grid.Column="1" Text="{Binding [Score_Edit_Annotations], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                             <Label Grid.Column="2" x:Name="AnnotationsAccordionArrow" Text="▶" TextColor="#007ACC" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                             <Grid.GestureRecognizers>
                                 <TapGestureRecognizer Tapped="OnToggleAnnotationsAccordionTapped" />
                             </Grid.GestureRecognizers>
                         </Grid>
                         
                         <VerticalStackLayout x:Name="AnnotationsAccordionBody" IsVisible="False" Spacing="12" Margin="0,8,0,0">
                             <BoxView HeightRequest="1" Color="#333333" />
                             <Grid ColumnDefinitions="*, Auto">
                                 <Label Text="{Binding [Score_Edit_Annotations_Show], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" VerticalOptions="Center" />
                                 <Switch Grid.Column="1" x:Name="AnnotationsSwitch" OnColor="#007ACC" ThumbColor="White" />
                             </Grid>
                         </VerticalStackLayout>
                     </VerticalStackLayout>
                 </Border>

                 <!-- BOUTONS D'ACTION -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,15,0,20">
                    <Button Grid.Column="0"
                            Text="{Binding [Common_Cancel], Source={x:Static services:LocalizationService.Instance}}" 
                            BackgroundColor="#333333" 
                            TextColor="White" 
                            CornerRadius="8"
                            HeightRequest="50"
                            FontSize="16"
                            Clicked="OnCancelClicked" />
                    <Button Grid.Column="1"
                            Text="{Binding [Common_Save], Source={x:Static services:LocalizationService.Instance}}" 
                            BackgroundColor="#007ACC" 
                            TextColor="White" 
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="50"
                            FontSize="16"
                            Clicked="OnSaveClicked" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Overlay de sélection des étiquettes -->
        <ContentView x:Name="TagPickerOverlay" 
                     Grid.RowSpan="2"
                     IsVisible="False" 
                     BackgroundColor="#E6000000" 
                     ZIndex="1000">
            <Border BackgroundColor="#1E1E1E" 
                    VerticalOptions="Fill" 
                    HorizontalOptions="Fill" 
                    Margin="20,50"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto, Auto, *, Auto">
                    <Label Grid.Row="0" Text="{Binding [Score_Edit_TagPicker_Title], Source={x:Static services:LocalizationService.Instance}}" 
                           TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,0,0,15" />
                    
                    <SearchBar Grid.Row="1" x:Name="TagSearchBar" 
                               Placeholder="{Binding [Score_Edit_TagPicker_Search], Source={x:Static services:LocalizationService.Instance}}" 
                               PlaceholderColor="#888888" TextColor="White"
                               BackgroundColor="#333333" Margin="0,0,0,15"
                               TextChanged="OnTagSearchTextChanged" />

                    <ScrollView Grid.Row="2">
                        <FlexLayout x:Name="AllTagsFlexLayout" 
                                    Wrap="Wrap" 
                                    Direction="Row" 
                                    AlignItems="Start" 
                                    AlignContent="Start" />
                    </ScrollView>

                    <Button Grid.Row="3" Text="{Binding [Score_Edit_TagPicker_Done], Source={x:Static services:LocalizationService.Instance}}" 
                            BackgroundColor="#007ACC" TextColor="White" 
                            FontAttributes="Bold" Margin="0,15,0,0"
                            HeightRequest="50"
                            Clicked="OnClosePickerClicked" />
                </Grid>
            </Border>
        </ContentView>
    </Grid>
</ContentPage>
