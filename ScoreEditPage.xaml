<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicScoreManager.ScoreEditPage"
             BackgroundColor="#121212"
             Title="Éditer la partition">

    <Grid RowDefinitions="Auto, *">
        <!-- Header personnalisé -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="← Retour" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold"
                    Clicked="OnCancelClicked" />
            <Label Grid.Column="1" 
                   Text="Éditer la partition" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"
                   Margin="0,0,80,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Margin="20">
                
                <Label Text="Titre" TextColor="#AAAAAA" />
                <Entry x:Name="TitleEntry" 
                       TextColor="White" 
                       BackgroundColor="#1E1E1E" 
                       ClearButtonVisibility="WhileEditing" />

                <Label Text="Chemin du fichier (Optionnel, modification risquée)" TextColor="#AAAAAA" />
                <Entry x:Name="PathEntry" 
                       TextColor="White" 
                       BackgroundColor="#1E1E1E" 
                       ClearButtonVisibility="WhileEditing" />

                <Label Text="Étiquettes" TextColor="#AAAAAA" />
                
                <FlexLayout x:Name="SelectedTagsFlexLayout" Wrap="Wrap" Direction="Row">
                    <!-- Tags sélectionnés ici -->
                    <Button Text="+" 
                            BackgroundColor="#333333" 
                            TextColor="White" 
                            FontSize="20"
                            FontAttributes="Bold"
                            WidthRequest="40" 
                            HeightRequest="40" 
                            CornerRadius="20"
                            Margin="0,0,0,10"
                            Clicked="OnAddTagClicked" />
                </FlexLayout>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,20,0,0">
                    <Button Grid.Column="0"
                            Text="Annuler" 
                            BackgroundColor="#333333" 
                            TextColor="White" 
                            CornerRadius="8"
                            HeightRequest="50"
                            Clicked="OnCancelClicked" />
                    <Button Grid.Column="1"
                            Text="Enregistrer" 
                            BackgroundColor="#007ACC" 
                            TextColor="White" 
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="50"
                            Clicked="OnSaveClicked" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Overlay de sélection des étiquettes -->
        <ContentView x:Name="TagPickerOverlay" 
                     Grid.RowSpan="2"
                     IsVisible="False" 
                     BackgroundColor="#E6000000" 
                     ZIndex="1000">
            <Border BackgroundColor="#1E1E1E" 
                    VerticalOptions="Fill" 
                    HorizontalOptions="Fill" 
                    Margin="20,50"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto, Auto, *, Auto">
                    <Label Grid.Row="0" Text="Sélectionner les étiquettes" 
                           TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,0,0,15" />
                    
                    <SearchBar Grid.Row="1" x:Name="TagSearchBar" 
                               Placeholder="Rechercher une étiquette..." 
                               PlaceholderColor="#888888" TextColor="White"
                               BackgroundColor="#333333" Margin="0,0,0,15"
                               TextChanged="OnTagSearchTextChanged" />

                    <ScrollView Grid.Row="2">
                        <FlexLayout x:Name="AllTagsFlexLayout" Wrap="Wrap" Direction="Row" />
                    </ScrollView>

                    <Button Grid.Row="3" Text="Terminer" 
                            BackgroundColor="#007ACC" TextColor="White" 
                            FontAttributes="Bold" Margin="0,15,0,0"
                            HeightRequest="50"
                            Clicked="OnClosePickerClicked" />
                </Grid>
            </Border>
        </ContentView>
    </Grid>
</ContentPage>
