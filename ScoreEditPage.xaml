<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicScoreManager.ScoreEditPage"
             BackgroundColor="#121212"
             Title="Éditer la partition">

    <Grid RowDefinitions="Auto, *">
        <!-- Header personnalisé -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="← Retour" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold"
                    Clicked="OnCancelClicked" />
            <Label Grid.Column="1" 
                   Text="Éditer la partition" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"
                   Margin="0,0,80,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Margin="20">
                
                <Label Text="Titre" TextColor="#AAAAAA" />
                <Entry x:Name="TitleEntry" 
                       TextColor="White" 
                       BackgroundColor="#1E1E1E" 
                       ClearButtonVisibility="WhileEditing" />

                <Label Text="Chemin du fichier (Optionnel, modification risquée)" TextColor="#AAAAAA" />
                <Entry x:Name="PathEntry" 
                       TextColor="White" 
                       BackgroundColor="#1E1E1E" 
                       ClearButtonVisibility="WhileEditing" />

                <Label Text="Étiquettes (Appuyez pour affecter)" TextColor="#AAAAAA" />
                
                <FlexLayout x:Name="TagsFlexLayout" Wrap="Wrap" Direction="Row" />

                <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                <Label Text="Affichage" TextColor="White" FontSize="16" FontAttributes="Bold" />
                
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0">
                        <Label x:Name="RotationLabel" Text="Rotation : 0°" TextColor="White" FontSize="14" />
                        <Label Text="Pivote l'affichage par paliers de 90°" TextColor="#888888" FontSize="11" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" 
                            Text="⟳ Tourner" 
                            BackgroundColor="#333333" 
                            TextColor="White"
                            HeightRequest="40"
                            Padding="10,0"
                            Clicked="OnRotateClicked" />
                </Grid>

                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Mémoriser la rotation" TextColor="White" FontSize="14" />
                        <Label Text="Applique cette rotation automatiquement à l'ouverture" TextColor="#888888" FontSize="11" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="SaveRotationSwitch" OnColor="#007ACC" ThumbColor="White" />
                </Grid>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,20,0,0">
                    <Button Grid.Column="0"
                            Text="Annuler" 
                            BackgroundColor="#333333" 
                            TextColor="White" 
                            CornerRadius="8"
                            HeightRequest="50"
                            Clicked="OnCancelClicked" />
                    <Button Grid.Column="1"
                            Text="Enregistrer" 
                            BackgroundColor="#007ACC" 
                            TextColor="White" 
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="50"
                            Clicked="OnSaveClicked" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
