<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicScoreManager.ScoreEditPage"
             BackgroundColor="#121212"
             Title="Éditer la partition">

    <Grid RowDefinitions="Auto, *">
        <!-- Header personnalisé -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="← Retour" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold"
                    Clicked="OnCancelClicked" />
            <Label Grid.Column="1" 
                   Text="Éditer la partition" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"
                   Margin="0,0,80,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Margin="20">
                
                <Label Text="Titre" TextColor="#AAAAAA" />
                <Entry x:Name="TitleEntry" 
                       TextColor="White" 
                       BackgroundColor="#1E1E1E" 
                       ClearButtonVisibility="WhileEditing" />

                <HorizontalStackLayout Spacing="5">
                    <Label Text="Chemin du fichier" TextColor="#AAAAAA" VerticalOptions="Center" />
                    <Label x:Name="ExternalScoreIcon" Text="🔗" TextColor="#007ACC" FontSize="18" VerticalOptions="Center" IsVisible="False" />
                    <Label x:Name="ExternalScoreLabel" Text="(Externe)" TextColor="#007ACC" FontSize="10" VerticalOptions="Center" IsVisible="False" />
                </HorizontalStackLayout>
                
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Entry x:Name="PathEntry" 
                           TextColor="White" 
                           BackgroundColor="#1E1E1E" 
                           ClearButtonVisibility="WhileEditing" />
                    <Button Grid.Column="1" 
                            x:Name="ImportScoreButton"
                            Text="Rapatrier" 
                            IsVisible="False"
                            BackgroundColor="#007ACC" 
                            TextColor="White" 
                            HeightRequest="35"
                            Padding="10,0"
                            Clicked="OnImportScoreToLibraryClicked" />
                </Grid>

                <Label Text="Étiquettes" TextColor="#AAAAAA" />
                
                <FlexLayout x:Name="SelectedTagsFlexLayout" Wrap="Wrap" Direction="Row" AlignItems="Start">
                    <!-- Tags sélectionnés ici -->
                    <Button Text="+" 
                            BackgroundColor="#333333" 
                            TextColor="White" 
                            FontSize="20"
                            FontAttributes="Bold"
                            WidthRequest="40" 
                            HeightRequest="40" 
                            CornerRadius="20"
                            Margin="0,0,0,10"
                            Clicked="OnAddTagClicked" />
                </FlexLayout>

                <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                <!-- SECTION MÉTRONOME -->
                <Label Text="Métronome" TextColor="White" FontSize="18" FontAttributes="Bold" />
                
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Activer par défaut sur cette partition" TextColor="#AAAAAA" VerticalOptions="Center" />
                    <Switch Grid.Column="1" x:Name="MetronomeSwitch" OnColor="#007ACC" ThumbColor="White" />
                </Grid>

                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Tempo (BPM)" TextColor="#AAAAAA" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="10">
                        <Entry x:Name="BpmEntry" Text="120" Keyboard="Numeric" WidthRequest="80" TextColor="White" BackgroundColor="#1E1E1E" HorizontalTextAlignment="Center" />
                        <Stepper x:Name="BpmStepper" Minimum="60" Maximum="200" Increment="1" Value="120" />
                    </HorizontalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" Color="#333333" Margin="0,10" />

                <!-- SECTION AUDIO -->
                <Label Text="Fichiers Audio" TextColor="White" FontSize="18" FontAttributes="Bold" />
                
                <Label Text="Pré-compte (Mesures)" TextColor="#AAAAAA" />
                <HorizontalStackLayout Spacing="10">
                    <Entry x:Name="PreCountEntry" Text="4" Keyboard="Numeric" WidthRequest="60" TextColor="White" BackgroundColor="#1E1E1E" HorizontalTextAlignment="Center" />
                    <Stepper x:Name="PreCountStepper" Minimum="0" Maximum="8" Increment="1" Value="4" />
                </HorizontalStackLayout>

                <VerticalStackLayout x:Name="AudioFilesList" Spacing="10">
                    <!-- Liste des fichiers audio générée dynamiquement -->
                </VerticalStackLayout>

                <Button Text="Ajouter un fichier audio (.mp3, .wav, .aiff)" 
                        BackgroundColor="#333333" 
                        TextColor="White" 
                        HorizontalOptions="Start"
                        Clicked="OnAddAudioClicked" />

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,20,0,0">
                    <Button Grid.Column="0"
                            Text="Annuler" 
                            BackgroundColor="#333333" 
                            TextColor="White" 
                            CornerRadius="8"
                            HeightRequest="50"
                            Clicked="OnCancelClicked" />
                    <Button Grid.Column="1"
                            Text="Enregistrer" 
                            BackgroundColor="#007ACC" 
                            TextColor="White" 
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="50"
                            Clicked="OnSaveClicked" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Overlay de sélection des étiquettes -->
        <ContentView x:Name="TagPickerOverlay" 
                     Grid.RowSpan="2"
                     IsVisible="False" 
                     BackgroundColor="#E6000000" 
                     ZIndex="1000">
            <Border BackgroundColor="#1E1E1E" 
                    VerticalOptions="Fill" 
                    HorizontalOptions="Fill" 
                    Margin="20,50"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto, Auto, *, Auto">
                    <Label Grid.Row="0" Text="Sélectionner les étiquettes" 
                           TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,0,0,15" />
                    
                    <SearchBar Grid.Row="1" x:Name="TagSearchBar" 
                               Placeholder="Rechercher une étiquette..." 
                               PlaceholderColor="#888888" TextColor="White"
                               BackgroundColor="#333333" Margin="0,0,0,15"
                               TextChanged="OnTagSearchTextChanged" />

                    <ScrollView Grid.Row="2">
                        <FlexLayout x:Name="AllTagsFlexLayout" 
                                    Wrap="Wrap" 
                                    Direction="Row" 
                                    AlignItems="Start" 
                                    AlignContent="Start" />
                    </ScrollView>

                    <Button Grid.Row="3" Text="Terminer" 
                            BackgroundColor="#007ACC" TextColor="White" 
                            FontAttributes="Bold" Margin="0,15,0,0"
                            HeightRequest="50"
                            Clicked="OnClosePickerClicked" />
                </Grid>
            </Border>
        </ContentView>
    </Grid>
</ContentPage>
