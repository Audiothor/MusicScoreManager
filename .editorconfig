# Configuration EditorConfig pour MusicScoreManager
root = true

[*.cs]
# Style de code C#
# Desactivation des suggestions de style purement cosmetiques dans la fenetre "Problemes" de l'editeur
# Note : Les commentaires EditorConfig doivent obligatoirement etre sur leur propre ligne.
# L'initialisation des collections peut etre simplifiee
dotnet_diagnostic.IDE0028.severity = none
# Simplifier l'initialisation de collection (expression de collection [])
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0301.severity = none
dotnet_diagnostic.IDE0305.severity = none
# Utiliser le constructeur principal
dotnet_diagnostic.IDE0290.severity = none
# Directive using inutile
dotnet_diagnostic.IDE0005.severity = none
# 'new' peut etre simplifie
dotnet_diagnostic.IDE0090.severity = none
# Champs en lecture seule
dotnet_diagnostic.IDE0044.severity = none
# Membres prives non utilises ou jamais lus
dotnet_diagnostic.IDE0051.severity = none
dotnet_diagnostic.IDE0052.severity = none
# Parametres et affectations inutiles
dotnet_diagnostic.IDE0060.severity = none
dotnet_diagnostic.IDE0059.severity = none
# Formulations de code et espaces de noms
dotnet_diagnostic.IDE0063.severity = none
dotnet_diagnostic.IDE0130.severity = none
dotnet_diagnostic.IDE0160.severity = none
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.IDE0270.severity = none
dotnet_diagnostic.IDE0079.severity = none



