# Configuration EditorConfig pour MusicScoreManager
root = true

[*.cs]
# Style de code C#
# Désactivation des suggestions de style purement cosmétiques dans la fenêtre "Problèmes" de l'éditeur
dotnet_diagnostic.IDE0028.severity = none    # L'initialisation des collections peut être simplifiée
dotnet_diagnostic.IDE0300.severity = none    # Simplifier l'initialisation de collection (expression de collection)
dotnet_diagnostic.IDE0301.severity = none    # Simplifier l'initialisation de collection
dotnet_diagnostic.IDE0305.severity = none    # Simplifier l'initialisation de collection
dotnet_diagnostic.IDE0290.severity = none    # Utiliser le constructeur principal
dotnet_diagnostic.IDE0005.severity = none    # Directive using inutile
dotnet_diagnostic.IDE0090.severity = none    # 'new' peut être simplifié

