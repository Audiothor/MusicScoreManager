<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.SettingsPage"
             BackgroundColor="#121212"
             Title="{Binding [Settings_Title], Source={x:Static services:LocalizationService.Instance}}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Margin="20">
                <!-- En-tête -->
                <VerticalStackLayout HorizontalOptions="Center" Margin="0,0,0,20">
                    <Label Text="Music Score Manager" 
                           TextColor="White" 
                           FontSize="24" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label x:Name="VersionLabel" 
                           Text="v0.0.0" 
                           TextColor="#888888" 
                           FontSize="14" 
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Liste des sous-paramètres -->
                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    
                    <VerticalStackLayout>
                        <Grid Padding="15" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsScoresTapped" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding [Settings_Scores], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="16" VerticalOptions="Center" />
                            <Label Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>
                        
                        <BoxView HeightRequest="1" Color="#333333" />
                        
                        <Grid Padding="15" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsSetlistsTapped" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding [Settings_Setlists], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="16" VerticalOptions="Center" />
                            <Label Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#333333" />

                        <Grid Padding="15" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsTagsTapped" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding [Settings_Tags], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="16" VerticalOptions="Center" />
                            <Label Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#333333" />

                        <Grid Padding="15" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsAnnotationsTapped" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding [Settings_Annotations], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="16" VerticalOptions="Center" />
                            <Label Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#333333" />

                        <Grid Padding="15" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsAppTapped" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding [Settings_App], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="16" VerticalOptions="Center" />
                            <Label Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#333333" />

                        <Grid Padding="15" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsHelpTapped" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding [Settings_Help], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="16" VerticalOptions="Center" />
                            <Label Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#333333" />

                        <Grid Padding="15" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsAboutTapped" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding [Settings_About], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="16" VerticalOptions="Center" />
                            <Label Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
