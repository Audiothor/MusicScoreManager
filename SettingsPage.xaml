<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicScoreManager.SettingsPage"
             BackgroundColor="#121212"
             Title="Paramètres">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Margin="20">
            <!-- En-tête -->
            <VerticalStackLayout HorizontalOptions="Center" Margin="0,0,0,20">
                <Label Text="Music Score Manager" 
                       TextColor="White" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="v0.1.4" 
                       TextColor="#888888" 
                       FontSize="14" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Liste des sous-paramètres -->
            <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                
                <VerticalStackLayout>
                    <Grid Padding="15" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsScoresTapped" />
                        </Grid.GestureRecognizers>
                        <Label Text="Paramètres Partitions" TextColor="White" FontSize="16" VerticalOptions="Center" />
                        <Label Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                    </Grid>
                    
                    <BoxView HeightRequest="1" Color="#333333" />
                    
                    <Grid Padding="15" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotImplementedTapped" />
                        </Grid.GestureRecognizers>
                        <Label Text="Paramètres Setlists" TextColor="White" FontSize="16" VerticalOptions="Center" />
                        <Label Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#333333" />

                    <Grid Padding="15" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotImplementedTapped" />
                        </Grid.GestureRecognizers>
                        <Label Text="Paramètres Etiquettes" TextColor="White" FontSize="16" VerticalOptions="Center" />
                        <Label Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#333333" />

                    <Grid Padding="15" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotImplementedTapped" />
                        </Grid.GestureRecognizers>
                        <Label Text="Paramètres application" TextColor="White" FontSize="16" VerticalOptions="Center" />
                        <Label Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
