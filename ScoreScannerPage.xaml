<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.ScoreScannerPage"
             BackgroundColor="#121212"
             Title="{Binding [ScoreScanner_Title], Source={x:Static services:LocalizationService.Instance}}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header personnalisé -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="12,10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="{Binding [Common_Back], Source={x:Static services:LocalizationService.Instance}}" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold" 
                    Clicked="OnBackClicked" />

            <Label Grid.Column="1" 
                   Text="{Binding [ScoreScanner_Title], Source={x:Static services:LocalizationService.Instance}}" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center" />

            <Button Grid.Column="2"
                    x:Name="GenerateScoreTopButton"
                    Text="{Binding [ScoreScanner_Generate_Short], Source={x:Static services:LocalizationService.Instance}}"
                    FontSize="13"
                    FontAttributes="Bold"
                    BackgroundColor="#2ECC71"
                    TextColor="White"
                    CornerRadius="6"
                    Padding="12,0"
                    HeightRequest="36"
                    IsEnabled="False"
                    Clicked="OnGenerateScoreClicked" />
        </Grid>

        <!-- Contenu principal -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Margin="16,12,16,24">

                <!-- Carte : Actions de capture et Filtre -->
                <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding [ScoreScanner_Capture_Header], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="#007ACC" FontSize="14" FontAttributes="Bold" />

                        <!-- Boutons Prendre Photo / Importer -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    x:Name="TakePhotoButton"
                                    Text="{Binding [ScoreScanner_TakePhoto], Source={x:Static services:LocalizationService.Instance}}"
                                    BackgroundColor="#007ACC"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HeightRequest="44"
                                    CornerRadius="8"
                                    Clicked="OnTakePhotoClicked" />

                            <Button Grid.Column="1"
                                    x:Name="PickImageButton"
                                    Text="{Binding [ScoreScanner_PickImage], Source={x:Static services:LocalizationService.Instance}}"
                                    BackgroundColor="#2E3348"
                                    TextColor="#B0C4DE"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HeightRequest="44"
                                    CornerRadius="8"
                                    Clicked="OnPickImageClicked" />
                        </Grid>

                        <!-- Filtre d'amélioration -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="{Binding [ScoreScanner_Filter_Label], Source={x:Static services:LocalizationService.Instance}}" 
                                   TextColor="#AAAAAA" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            <Border Grid.Column="1" BackgroundColor="#141418" Stroke="#3A3A4C" StrokeThickness="1" Padding="10,2" MinimumHeightRequest="44">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Picker x:Name="EnhancementFilterPicker"
                                        TextColor="White"
                                        TitleColor="#888899"
                                        FontSize="13"
                                        VerticalOptions="Center"
                                        SelectedIndexChanged="OnEnhancementFilterChanged" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding [ScoreScanner_Filter_Tip], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="#777777" FontSize="11" FontAttributes="Italic" />
                    </VerticalStackLayout>
                </Border>

                <!-- Carte : Métadonnées Partition -->
                <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding [ScoreScanner_Metadata_Header], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="#007ACC" FontSize="14" FontAttributes="Bold" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding [ScoreScanner_Score_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="12" FontAttributes="Bold" />
                            <Entry x:Name="ScoreTitleEntry"
                                   Placeholder="{Binding [ScoreScanner_Title_Placeholder], Source={x:Static services:LocalizationService.Instance}}"
                                   PlaceholderColor="#666666"
                                   TextColor="White"
                                   BackgroundColor="#141418"
                                   HeightRequest="40" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding [ScoreScanner_Score_Composer], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="12" FontAttributes="Bold" />
                            <Entry x:Name="ScoreComposerEntry"
                                   Placeholder="{Binding [ScoreScanner_Composer_Placeholder], Source={x:Static services:LocalizationService.Instance}}"
                                   PlaceholderColor="#666666"
                                   TextColor="White"
                                   BackgroundColor="#141418"
                                   HeightRequest="40" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Section : Pages numérisées -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                    <Label Grid.Column="0" 
                           x:Name="PagesCountLabel"
                           Text="{Binding [ScoreScanner_No_Pages], Source={x:Static services:LocalizationService.Instance}}"
                           TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />

                    <Button Grid.Column="1"
                            x:Name="ClearAllButton"
                            Text="{Binding [Common_Delete], Source={x:Static services:LocalizationService.Instance}}"
                            TextColor="#FF4D4D"
                            BackgroundColor="Transparent"
                            FontSize="12"
                            FontAttributes="Bold"
                            IsVisible="False"
                            Clicked="OnClearAllPagesClicked" />
                </Grid>

                <!-- Liste dynamique des pages -->
                <VerticalStackLayout x:Name="PagesContainer" Spacing="10" />

                <!-- Message si vide -->
                <Border x:Name="EmptyPagesBox" BackgroundColor="#1A1A1A" Stroke="#333333" StrokeThickness="1" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="📷" FontSize="36" HorizontalOptions="Center" />
                        <Label Text="{Binding [ScoreScanner_Empty_Hint], Source={x:Static services:LocalizationService.Instance}}"
                               TextColor="#888888" FontSize="13" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Grand bouton de finalisation en bas -->
                <Button x:Name="GenerateScoreBottomButton"
                        Text="{Binding [ScoreScanner_Generate_Full], Source={x:Static services:LocalizationService.Instance}}"
                        BackgroundColor="#2ECC71"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="15"
                        HeightRequest="48"
                        CornerRadius="8"
                        Margin="0,8,0,0"
                        IsEnabled="False"
                        Clicked="OnGenerateScoreClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
