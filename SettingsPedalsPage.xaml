<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MusicScoreManager.Models"
             xmlns:local="clr-namespace:MusicScoreManager"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.SettingsPedalsPage"
             BackgroundColor="#121212"
             Title="{Binding [Settings_Pedals_Title], Source={x:Static services:LocalizationService.Instance}}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="{Binding [Common_Back], Source={x:Static services:LocalizationService.Instance}}" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold" 
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" 
                    Text="{Binding [Settings_Pedals_Header], Source={x:Static services:LocalizationService.Instance}}" 
                    TextColor="White" 
                    FontSize="18" 
                    FontAttributes="Bold" 
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    Margin="0,0,80,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="22" Padding="20">
                
                <!-- CHAPITRE 1 : Profil de pédale actif (1ère position) -->
                <Label Text="{Binding [Settings_Pedals_Profile_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="#007ACC" FontSize="18" FontAttributes="Bold" />

                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding [Settings_Pedals_Profile_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="13" />

                        <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#2C2C2C" Padding="8,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Picker x:Name="ProfilesPicker" 
                                    TextColor="White" 
                                    TitleColor="#888888" 
                                    FontSize="15" 
                                    SelectedIndexChanged="OnProfileSelectionChanged" />
                        </Border>

                        <Label x:Name="ProfileDescLabel" Text="Description du profil..." TextColor="#9E9E9E" FontSize="12" FontAttributes="Italic" />

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Button x:Name="NewProfileBtn"
                                    Grid.Column="0"
                                    Text="{Binding [Settings_Pedals_New_Profile], Source={x:Static services:LocalizationService.Instance}}" 
                                    BackgroundColor="#2C2C2C" 
                                    TextColor="#007ACC" 
                                    BorderColor="#007ACC" 
                                    BorderWidth="1" 
                                    CornerRadius="8" 
                                    HeightRequest="42" 
                                    Clicked="OnNewCustomProfileClicked" />
                            
                            <Button x:Name="DeleteProfileBtn" 
                                    Grid.Column="1"
                                    Text="{Binding [Settings_Pedals_Delete_Profile], Source={x:Static services:LocalizationService.Instance}}" 
                                    BackgroundColor="#2C2C2C" 
                                    TextColor="#FF6B6B" 
                                    BorderColor="#FF6B6B" 
                                    BorderWidth="1" 
                                    CornerRadius="8" 
                                    HeightRequest="42" 
                                    Clicked="OnDeleteProfileClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- CHAPITRE 2 : Paramètres supplémentaires (Sécurité scène & Sensibilité) -->
                <Label Text="{Binding [Settings_Pedals_Security_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="#007ACC" FontSize="18" FontAttributes="Bold" />

                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <!-- Anti-double saut de page -->
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding [Settings_Pedals_Block_Fast_Turn], Source={x:Static services:LocalizationService.Instance}}" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold" />
                                <Label Text="{Binding [Settings_Pedals_Block_Fast_Turn_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                                       TextColor="#888888" FontSize="11" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" 
                                    x:Name="BlockFastTurnSwitch" 
                                    IsToggled="True" 
                                    OnColor="#007ACC" 
                                    VerticalOptions="Center" 
                                    Toggled="OnBlockFastTurnToggled" />
                        </Grid>

                        <!-- Sélecteur de délai anti-rebond -->
                        <Grid x:Name="FastTurnDelayRow" ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Label Text="{Binding [Settings_Pedals_Security_Delay], Source={x:Static services:LocalizationService.Instance}}" TextColor="#CCCCCC" FontSize="13" VerticalOptions="Center" />
                            <Border Grid.Column="1" Stroke="#444444" StrokeThickness="1" BackgroundColor="#2C2C2C" Padding="8,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Picker x:Name="FastTurnDelayPicker" 
                                        TextColor="#4FC3F7" 
                                        FontSize="13" 
                                        SelectedIndexChanged="OnFastTurnDelayChanged" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#333333" Margin="0,4" />

                        <!-- Seuil d'appui long -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="{Binding [Settings_Pedals_Long_Press_Delay], Source={x:Static services:LocalizationService.Instance}}" TextColor="#CCCCCC" FontSize="13" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="ThresholdValueLabel" Text="450 ms" TextColor="#007ACC" FontSize="14" FontAttributes="Bold" />
                        </Grid>
                        
                        <Slider x:Name="ThresholdSlider" 
                                Minimum="200" 
                                Maximum="1000" 
                                Value="450" 
                                MinimumTrackColor="#007ACC" 
                                MaximumTrackColor="#444444" 
                                ValueChanged="OnThresholdSliderChanged" />
                        
                        <Label Text="{Binding [Settings_Pedals_Long_Press_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="#777777" 
                               FontSize="11" />
                    </VerticalStackLayout>
                </Border>

                <!-- CHAPITRE 3 : Diagnostic & Testeur en direct (3ème position) -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="{Binding [Settings_Pedals_Diagnostic_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="#007ACC" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Label Text="Actif" TextColor="#AAAAAA" FontSize="14" VerticalOptions="Center" />
                        <Switch x:Name="ServiceEnabledSwitch" IsToggled="True" Toggled="OnServiceEnabledToggled" OnColor="#007ACC" />
                    </HorizontalStackLayout>
                </Grid>

                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="{Binding [Settings_Pedals_Diagnostic_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                                   TextColor="#CCCCCC" 
                                   FontSize="13" 
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1" x:Name="ListeningBadge" Stroke="#007ACC" StrokeThickness="1" BackgroundColor="#1A334D" Padding="8,3">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label x:Name="ListeningLabel" Text="🟢 En écoute..." TextColor="#4FC3F7" FontSize="11" FontAttributes="Bold" />
                            </Border>
                        </Grid>

                        <!-- Boîte du dernier événement reçu -->
                        <Border x:Name="LastEventCard" Stroke="#444444" StrokeThickness="1" BackgroundColor="#262626" Padding="15">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label x:Name="EventKeyLabel" Text="{Binding [Settings_Pedals_Waiting_Input], Source={x:Static services:LocalizationService.Instance}}" TextColor="#FFFFFF" FontSize="18" FontAttributes="Bold" />
                                    <Label Grid.Column="1" x:Name="EventSourceLabel" Text="Bluetooth / MIDI" TextColor="#888888" FontSize="12" VerticalOptions="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                    <Label x:Name="EventCodeLabel" Text="Code : --" TextColor="#AAAAAA" FontSize="13" />
                                    <Label Grid.Column="1" x:Name="EventTimeLabel" Text="Heure : --" TextColor="#666666" FontSize="12" />
                                    <Label Grid.Column="2" x:Name="EventLongPressBadge" Text="⏱️ Pression Longue" TextColor="#FFA726" FontSize="12" FontAttributes="Bold" IsVisible="False" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#3A3A3A" Margin="0,4" />
                                <Grid ColumnDefinitions="Auto, *">
                                    <Label Text="Action déclenchée : " TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center" />
                                    <Label Grid.Column="1" x:Name="EventActionLabel" Text="Aucune action associée" TextColor="#4CAF50" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- CHAPITRE 4 : Raccourcis du profil (Accordéon rabattu par défaut) -->
                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <!-- En-tête de l'accordéon cliquable -->
                        <Grid ColumnDefinitions="*, Auto, Auto" Padding="15" BackgroundColor="#222222">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleShortcutsAccordionClicked" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label x:Name="ProfileShortcutsTitleLabel" 
                                       Text="{Binding [Settings_Pedals_Shortcuts_Default], Source={x:Static services:LocalizationService.Instance}}" 
                                       TextColor="#007ACC" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       LineBreakMode="TailTruncation" />
                                <Label x:Name="ShortcutsSubtitleLabel"
                                       Text="{Binding [Settings_Pedals_Shortcuts_Toggle_Hint], Source={x:Static services:LocalizationService.Instance}}" 
                                       TextColor="#888888" 
                                       FontSize="12" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1" 
                                    Text="{Binding [Settings_Pedals_Learn_Btn], Source={x:Static services:LocalizationService.Instance}}" 
                                    BackgroundColor="#007ACC" 
                                    TextColor="White" 
                                    FontSize="12" 
                                    CornerRadius="8" 
                                    Padding="10,4" 
                                    HeightRequest="36"
                                    Margin="8,0"
                                    VerticalOptions="Center"
                                    Clicked="OnLearnKeyClicked" />

                            <Label Grid.Column="2" 
                                   x:Name="AccordionChevronLabel" 
                                   Text="▶" 
                                   TextColor="#007ACC" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   VerticalOptions="Center" 
                                   HorizontalOptions="Center" />
                        </Grid>

                        <!-- Contenu de l'accordéon (rabattu / masqué par défaut) -->
                        <VerticalStackLayout x:Name="ShortcutsContentLayout" IsVisible="False" Padding="12" Spacing="10">
                            <CollectionView x:Name="BindingsCollection" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="local:PedalBindingViewModel">
                                        <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#252525" Padding="12,10" Margin="0,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="8">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                        <Border BackgroundColor="#1E3A5F" Stroke="#007ACC" StrokeThickness="1" Padding="8,3">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="6" />
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding KeyName}" TextColor="White" FontSize="13" FontAttributes="Bold" />
                                                        </Border>
                                                        <Label Text="{Binding InputTypeDisplay}" TextColor="#888888" FontSize="12" VerticalOptions="Center" />
                                                    </HorizontalStackLayout>

                                                    <Button Grid.Column="1" 
                                                            Text="✕" 
                                                            BackgroundColor="Transparent" 
                                                            TextColor="#FF6B6B" 
                                                            FontSize="16" 
                                                            Clicked="OnDeleteBindingClicked" 
                                                            CommandParameter="{Binding .}" />
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                                    <Label Text="{Binding [Settings_Pedals_Normal_Press], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="12" VerticalOptions="Center" />
                                                    <Border Grid.Column="1" Stroke="#444444" StrokeThickness="1" BackgroundColor="#2C2C2C" Padding="6,0">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="6" />
                                                        </Border.StrokeShape>
                                                        <Picker ItemsSource="{Binding AvailableActions}" 
                                                                SelectedItem="{Binding SelectedActionDisplay, Mode=TwoWay}" 
                                                                TextColor="#4CAF50" 
                                                                FontSize="13" />
                                                    </Border>
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                                    <Label Text="{Binding [Settings_Pedals_Long_Press_Action], Source={x:Static services:LocalizationService.Instance}}" TextColor="#FFA726" FontSize="12" VerticalOptions="Center" />
                                                    <Border Grid.Column="1" Stroke="#444444" StrokeThickness="1" BackgroundColor="#2C2C2C" Padding="6,0">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="6" />
                                                        </Border.StrokeShape>
                                                        <Picker ItemsSource="{Binding AvailableActions}" 
                                                                SelectedItem="{Binding SelectedLongPressActionDisplay, Mode=TwoWay}" 
                                                                TextColor="#FFB74D" 
                                                                FontSize="13" />
                                                    </Border>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
