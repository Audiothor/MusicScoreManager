<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MusicScoreManager.Models"
             xmlns:local="clr-namespace:MusicScoreManager"
             x:Class="MusicScoreManager.SettingsPedalsPage"
             BackgroundColor="#121212"
             Title="Paramètres Pédales &amp; MIDI">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="← Retour" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold" 
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" 
                    Text="Pédales &amp; Événements MIDI" 
                    TextColor="White" 
                    FontSize="18" 
                    FontAttributes="Bold" 
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    Margin="0,0,80,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="22" Padding="20">
                
                <!-- CHAPITRE 1 : Activation & Testeur / Diagnostic en direct -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Diagnostic &amp; Testeur en direct" TextColor="#007ACC" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Label Text="Actif" TextColor="#AAAAAA" FontSize="14" VerticalOptions="Center" />
                        <Switch x:Name="ServiceEnabledSwitch" IsToggled="True" Toggled="OnServiceEnabledToggled" OnColor="#007ACC" />
                    </HorizontalStackLayout>
                </Grid>

                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Actionnez une pédale Bluetooth ou contrôleur MIDI pour tester le signal :" 
                                   TextColor="#CCCCCC" 
                                   FontSize="13" 
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1" x:Name="ListeningBadge" Stroke="#007ACC" StrokeThickness="1" BackgroundColor="#1A334D" Padding="8,3">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label x:Name="ListeningLabel" Text="🟢 En écoute..." TextColor="#4FC3F7" FontSize="11" FontAttributes="Bold" />
                            </Border>
                        </Grid>

                        <!-- Boîte du dernier événement reçu -->
                        <Border x:Name="LastEventCard" Stroke="#444444" StrokeThickness="1" BackgroundColor="#262626" Padding="15">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label x:Name="EventKeyLabel" Text="En attente d'un appui..." TextColor="#FFFFFF" FontSize="18" FontAttributes="Bold" />
                                    <Label Grid.Column="1" x:Name="EventSourceLabel" Text="Bluetooth / MIDI" TextColor="#888888" FontSize="12" VerticalOptions="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                    <Label x:Name="EventCodeLabel" Text="Code : --" TextColor="#AAAAAA" FontSize="13" />
                                    <Label Grid.Column="1" x:Name="EventTimeLabel" Text="Heure : --" TextColor="#666666" FontSize="12" />
                                    <Label Grid.Column="2" x:Name="EventLongPressBadge" Text="⏱️ Pression Longue" TextColor="#FFA726" FontSize="12" FontAttributes="Bold" IsVisible="False" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#3A3A3A" Margin="0,4" />
                                <Grid ColumnDefinitions="Auto, *">
                                    <Label Text="Action déclenchée : " TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center" />
                                    <Label Grid.Column="1" x:Name="EventActionLabel" Text="Aucune action associée" TextColor="#4CAF50" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- CHAPITRE 2 : Profils de Pédales Préconfigurés -->
                <Label Text="Profil de pédale actif" TextColor="#007ACC" FontSize="18" FontAttributes="Bold" />

                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Sélectionnez le modèle de votre pédalier pour charger sa configuration optimale :" TextColor="#AAAAAA" FontSize="13" />

                        <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#2C2C2C" Padding="8,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Picker x:Name="ProfilesPicker" 
                                    TextColor="White" 
                                    TitleColor="#888888" 
                                    FontSize="15" 
                                    SelectedIndexChanged="OnProfileSelectionChanged" />
                        </Border>

                        <Label x:Name="ProfileDescLabel" Text="Description du profil..." TextColor="#9E9E9E" FontSize="12" FontAttributes="Italic" />

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Button Text="➕ Nouveau profil" 
                                    BackgroundColor="#2C2C2C" 
                                    TextColor="#007ACC" 
                                    BorderColor="#007ACC" 
                                    BorderWidth="1" 
                                    CornerRadius="8" 
                                    Clicked="OnNewCustomProfileClicked" />
                            
                            <Button x:Name="DeleteProfileBtn" 
                                    Text="🗑️ Supprimer" 
                                    BackgroundColor="#2C2C2C" 
                                    TextColor="#FF6B6B" 
                                    BorderColor="#FF6B6B" 
                                    BorderWidth="1" 
                                    CornerRadius="8" 
                                    Clicked="OnDeleteProfileClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- CHAPITRE 3 : Configuration des Touches & Actions -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Raccourcis du profil" TextColor="#007ACC" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button Grid.Column="1" 
                            Text="➕ Apprendre une touche" 
                            BackgroundColor="#007ACC" 
                            TextColor="White" 
                            FontSize="13" 
                            CornerRadius="8" 
                            Padding="12,6" 
                            Clicked="OnLearnKeyClicked" />
                </Grid>

                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <CollectionView x:Name="BindingsCollection" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="local:PedalBindingViewModel">
                                    <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#252525" Padding="12,10" Margin="0,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                    <Border BackgroundColor="#1E3A5F" Stroke="#007ACC" StrokeThickness="1" Padding="8,3">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="6" />
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding KeyName}" TextColor="White" FontSize="13" FontAttributes="Bold" />
                                                    </Border>
                                                    <Label Text="{Binding InputTypeDisplay}" TextColor="#888888" FontSize="12" VerticalOptions="Center" />
                                                </HorizontalStackLayout>

                                                <Button Grid.Column="1" 
                                                        Text="✕" 
                                                        BackgroundColor="Transparent" 
                                                        TextColor="#FF6B6B" 
                                                        FontSize="16" 
                                                        Clicked="OnDeleteBindingClicked" 
                                                        CommandParameter="{Binding .}" />
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                                <Label Text="Appui normal :" TextColor="#AAAAAA" FontSize="12" VerticalOptions="Center" />
                                                <Border Grid.Column="1" Stroke="#444444" StrokeThickness="1" BackgroundColor="#2C2C2C" Padding="6,0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>
                                                    <Picker ItemsSource="{Binding AvailableActions}" 
                                                            SelectedItem="{Binding SelectedActionDisplay, Mode=TwoWay}" 
                                                            TextColor="#4CAF50" 
                                                            FontSize="13" />
                                                </Border>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                                <Label Text="Appui long :" TextColor="#FFA726" FontSize="12" VerticalOptions="Center" />
                                                <Border Grid.Column="1" Stroke="#444444" StrokeThickness="1" BackgroundColor="#2C2C2C" Padding="6,0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>
                                                    <Picker ItemsSource="{Binding AvailableActions}" 
                                                            SelectedItem="{Binding SelectedLongPressActionDisplay, Mode=TwoWay}" 
                                                            TextColor="#FFB74D" 
                                                            FontSize="13" />
                                                </Border>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- CHAPITRE 4 : Réglages du seuil d'appui long -->
                <Label Text="Sensibilité &amp; Réglages avancés" TextColor="#007ACC" FontSize="18" FontAttributes="Bold" />

                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Délai de détection de l'appui long :" TextColor="#CCCCCC" FontSize="13" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="ThresholdValueLabel" Text="450 ms" TextColor="#007ACC" FontSize="14" FontAttributes="Bold" />
                        </Grid>
                        
                        <Slider x:Name="ThresholdSlider" 
                                Minimum="200" 
                                Maximum="1000" 
                                Value="450" 
                                MinimumTrackColor="#007ACC" 
                                MaximumTrackColor="#444444" 
                                ValueChanged="OnThresholdSliderChanged" />
                        
                        <Label Text="Un appui maintenu au-delà de cette durée déclenchera l'action secondaire configurée (ex: Morceau suivant dans la setlist)." 
                               TextColor="#777777" 
                               FontSize="11" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
