<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MusicScoreManager.Models"
             xmlns:local="clr-namespace:MusicScoreManager"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.SettingsPedalsPage"
             BackgroundColor="#121212"
             Title="{Binding [Settings_Pedals_Title], Source={x:Static services:LocalizationService.Instance}}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="{Binding [Common_Back], Source={x:Static services:LocalizationService.Instance}}" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold" 
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" 
                    Text="{Binding [Settings_Pedals_Header], Source={x:Static services:LocalizationService.Instance}}" 
                    TextColor="White" 
                    FontSize="18" 
                    FontAttributes="Bold" 
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    Margin="0,0,80,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="22" Padding="20">
                
                <!-- CHAPITRE 1 : Profil de pédale actif par défaut (1ère position) -->
                <Label Text="{Binding [Settings_Pedals_Profile_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="#007ACC" FontSize="18" FontAttributes="Bold" />

                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding [Settings_Pedals_Profile_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="13" />

                        <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#2C2C2C" Padding="8,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Picker x:Name="ProfilesPicker" 
                                    TextColor="White" 
                                    TitleColor="#888888" 
                                    FontSize="15" 
                                    SelectedIndexChanged="OnProfileSelectionChanged" />
                        </Border>

                        <Border Stroke="#3A3A3A" StrokeThickness="1" BackgroundColor="#252525" Padding="12,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="💡 Notes &amp; Réglages du profil :" TextColor="#4FC3F7" FontSize="11" FontAttributes="Bold" />
                                <Label x:Name="ProfileDescLabel" Text="Description du profil..." TextColor="#CCCCCC" FontSize="12" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Button x:Name="EditProfileBtn"
                                Text="✏️ Modifier le profil sélectionné" 
                                BackgroundColor="#007ACC" 
                                TextColor="White" 
                                FontAttributes="Bold"
                                CornerRadius="8" 
                                HeightRequest="44" 
                                Clicked="OnEditProfileClicked" />

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Button x:Name="NewProfileBtn"
                                    Grid.Column="0"
                                    Text="➕ Nouveau profil" 
                                    BackgroundColor="#2C2C2C" 
                                    TextColor="#007ACC" 
                                    BorderColor="#007ACC" 
                                    BorderWidth="1" 
                                    CornerRadius="8" 
                                    HeightRequest="42" 
                                    Clicked="OnNewCustomProfileClicked" />
                            
                            <Button x:Name="DeleteProfileBtn" 
                                    Grid.Column="1"
                                    Text="🗑️ Supprimer" 
                                    BackgroundColor="#2C2C2C" 
                                    TextColor="#FF6B6B" 
                                    BorderColor="#FF6B6B" 
                                    BorderWidth="1" 
                                    CornerRadius="8" 
                                    HeightRequest="42" 
                                    Clicked="OnDeleteProfileClicked" />
                        </Grid>

                        <Button x:Name="ResetProfilesBtn"
                                Text="🔄 Réinitialiser tous les profils d'usine"
                                BackgroundColor="Transparent"
                                TextColor="#888888"
                                FontSize="12"
                                HeightRequest="36"
                                Clicked="OnResetFactoryProfilesClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- CHAPITRE 2 : Paramètres supplémentaires (Sécurité scène & Sensibilité) -->
                <Label Text="{Binding [Settings_Pedals_Security_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="#007ACC" FontSize="18" FontAttributes="Bold" />

                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <!-- Anti-double saut de page -->
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding [Settings_Pedals_Block_Fast_Turn], Source={x:Static services:LocalizationService.Instance}}" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold" />
                                <Label Text="{Binding [Settings_Pedals_Block_Fast_Turn_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                                       TextColor="#888888" FontSize="11" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" 
                                    x:Name="BlockFastTurnSwitch" 
                                    IsToggled="True" 
                                    OnColor="#007ACC" 
                                    VerticalOptions="Center" 
                                    Toggled="OnBlockFastTurnToggled" />
                        </Grid>

                        <!-- Sélecteur de délai anti-rebond -->
                        <Grid x:Name="FastTurnDelayRow" ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Label Text="{Binding [Settings_Pedals_Security_Delay], Source={x:Static services:LocalizationService.Instance}}" TextColor="#CCCCCC" FontSize="13" VerticalOptions="Center" />
                            <Border Grid.Column="1" Stroke="#444444" StrokeThickness="1" BackgroundColor="#2C2C2C" Padding="8,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Picker x:Name="FastTurnDelayPicker" 
                                        TextColor="#4FC3F7" 
                                        FontSize="13" 
                                        SelectedIndexChanged="OnFastTurnDelayChanged" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#333333" Margin="0,4" />

                        <!-- Seuil d'appui long -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="{Binding [Settings_Pedals_Long_Press_Delay], Source={x:Static services:LocalizationService.Instance}}" TextColor="#CCCCCC" FontSize="13" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="ThresholdValueLabel" Text="450 ms" TextColor="#007ACC" FontSize="14" FontAttributes="Bold" />
                        </Grid>
                        
                        <Slider x:Name="ThresholdSlider" 
                                Minimum="200" 
                                Maximum="1000" 
                                Value="450" 
                                MinimumTrackColor="#007ACC" 
                                MaximumTrackColor="#444444" 
                                ValueChanged="OnThresholdSliderChanged" />
                        
                        <Label Text="{Binding [Settings_Pedals_Long_Press_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="#777777" 
                               FontSize="11" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
