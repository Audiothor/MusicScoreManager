<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.SettingsScoresPage"
             BackgroundColor="#121212"
             Title="{Binding [Settings_Scores], Source={x:Static services:LocalizationService.Instance}}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header personnalisé avec bouton Retour -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="{Binding [Common_Back], Source={x:Static services:LocalizationService.Instance}}" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold" 
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" 
                   Text="{Binding [Settings_Scores], Source={x:Static services:LocalizationService.Instance}}" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"
                   Margin="0,0,80,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Margin="20">
            
            <Label Text="{Binding [Settings_Scores_Section_General], Source={x:Static services:LocalizationService.Instance}}" 
                   TextColor="#007ACC" 
                   FontSize="18" 
                   FontAttributes="Bold" />

            <!-- Option : Tri par défaut des partitions -->
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding [Settings_Scores_Default_Sort], Source={x:Static services:LocalizationService.Instance}}" 
                       TextColor="White" 
                       FontSize="16" />
                <Label Text="{Binding [Settings_Scores_Default_Sort_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                       TextColor="#888888" 
                       FontSize="12" />
                <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="10,2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Picker x:Name="DefaultSortPicker"
                            TextColor="White"
                            TitleColor="#888888"
                            SelectedIndexChanged="OnDefaultSortChanged" />
                </Border>
            </VerticalStackLayout>

            <!-- Option : Sans compositeur en premier lors du tri par compositeur -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding [Settings_Scores_Composer_Empty_First], Source={x:Static services:LocalizationService.Instance}}" 
                           TextColor="White" 
                           FontSize="15" />
                    <Label Text="{Binding [Settings_Scores_Composer_Empty_First_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                           TextColor="#888888" 
                           FontSize="12" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" 
                        x:Name="ComposerEmptyFirstSwitch" 
                        OnColor="#007ACC" 
                        ThumbColor="White" 
                        VerticalOptions="Center" 
                        Toggled="OnComposerEmptyFirstToggled" />
            </Grid>

            <BoxView HeightRequest="1" Color="#333333" />

            <Label Text="{Binding [Settings_Scores_Section_Display], Source={x:Static services:LocalizationService.Instance}}" 
                   TextColor="#007ACC" 
                   FontSize="18" 
                   FontAttributes="Bold" />

            <!-- Option : Informations sous le titre de la partition -->
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding [Settings_Scores_Subtitle_Info], Source={x:Static services:LocalizationService.Instance}}" 
                       TextColor="White" 
                       FontSize="16" 
                       FontAttributes="Bold" />
                <Label Text="{Binding [Settings_Scores_Subtitle_Info_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                       TextColor="#888888" 
                       FontSize="12" />

                <!-- Liste interactive et ordonnançable des éléments -->
                <VerticalStackLayout x:Name="SubtitleItemsLayout" Spacing="8" />

                <!-- Aperçu en temps réel -->
                <Border BackgroundColor="#181820" Stroke="#007ACC" StrokeThickness="1" Padding="12,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding [Settings_Scores_Subtitle_Preview], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888899" FontSize="11" FontAttributes="Bold" />
                        <Label Text="Nocturne Op. 9 No. 2" TextColor="White" FontSize="14" FontAttributes="Bold" />
                        <Label x:Name="SubtitlePreviewLabel" Text="Frédéric Chopin • 4 pages • 17/09/2026" TextColor="#00B4D8" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#333333" />

            <!-- Option : Affichage du numéro de page -->
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding [Settings_Scores_Show_Page_Number], Source={x:Static services:LocalizationService.Instance}}" 
                           TextColor="White" 
                           FontSize="16" />
                    <Label Text="{Binding [Settings_Scores_Show_Page_Number_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                           TextColor="#888888" 
                           FontSize="12" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" 
                        x:Name="ShowPageNumberSwitch"
                        OnColor="#007ACC"
                        ThumbColor="White"
                        Toggled="OnShowPageNumberToggled" />
            </Grid>

            <BoxView HeightRequest="1" Color="#333333" />

            <!-- Option : Affichage 2 pages en mode paysage -->
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding [Settings_Scores_Two_Pages_Landscape], Source={x:Static services:LocalizationService.Instance}}" 
                           TextColor="White" 
                           FontSize="16" />
                    <Label Text="{Binding [Settings_Scores_Two_Pages_Landscape_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                           TextColor="#888888" 
                           FontSize="12" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" 
                        x:Name="TwoPagesLandscapeSwitch"
                        OnColor="#007ACC"
                        ThumbColor="White"
                        Toggled="OnTwoPagesLandscapeToggled" />
            </Grid>

            <BoxView HeightRequest="1" Color="#333333" />

            <!-- Option : Maintien de l'écran allumé pendant la lecture -->
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding [Settings_Scores_Keep_Screen_On], Source={x:Static services:LocalizationService.Instance}}" 
                           TextColor="White" 
                           FontSize="16" />
                    <Label Text="{Binding [Settings_Scores_Keep_Screen_On_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                           TextColor="#888888" 
                           FontSize="12" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" 
                        x:Name="KeepScreenOnSwitch"
                        OnColor="#007ACC"
                        ThumbColor="White"
                        Toggled="OnKeepScreenOnToggled" />
            </Grid>

            <BoxView HeightRequest="1" Color="#333333" />

            <!-- Option : Taille d'affichage -->
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding [Settings_Scores_Page_Number_Size], Source={x:Static services:LocalizationService.Instance}}" 
                       TextColor="White" 
                       FontSize="16" />
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Label Grid.Column="0" Text="A" FontSize="12" TextColor="#888888" VerticalOptions="Center" />
                    <Slider Grid.Column="1" 
                            x:Name="PageNumberSizeSlider"
                            Minimum="10" 
                            Maximum="40" 
                            MinimumTrackColor="#007ACC"
                            MaximumTrackColor="#555555"
                            ThumbColor="#007ACC"
                            Margin="10,0"
                            ValueChanged="OnPageNumberSizeChanged" />
                    <Label Grid.Column="2" Text="A" FontSize="24" TextColor="#888888" VerticalOptions="Center" />
                </Grid>
                <Label x:Name="SizeValueLabel" 
                       Text="{Binding Source={x:Reference PageNumberSizeSlider}, Path=Value, StringFormat='{0:F0} px'}" 
                       TextColor="#007ACC" 
                       HorizontalOptions="End" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#333333" Margin="0,5" />

            <!-- Section Ergonomie -->
            <Label Text="{Binding [Settings_Scores_Section_Ergonomics], Source={x:Static services:LocalizationService.Instance}}" 
                   TextColor="#007ACC" 
                   FontSize="18" 
                   FontAttributes="Bold" />

            <!-- Option : Aller vers page suivante -->
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding [Settings_Scores_Next_Page_Gesture], Source={x:Static services:LocalizationService.Instance}}" 
                       TextColor="White" 
                       FontSize="16" />
                <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="10,2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Picker x:Name="NextPageGesturePicker"
                            TextColor="White"
                            TitleColor="#888888"
                            SelectedIndexChanged="OnNextPageGestureChanged" />
                </Border>
            </VerticalStackLayout>

            <!-- Option : Aller vers page précédente -->
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding [Settings_Scores_Prev_Page_Gesture], Source={x:Static services:LocalizationService.Instance}}" 
                       TextColor="White" 
                       FontSize="16" />
                <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="10,2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Picker x:Name="PrevPageGesturePicker"
                            TextColor="White"
                            TitleColor="#888888"
                            SelectedIndexChanged="OnPrevPageGestureChanged" />
                </Border>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#333333" Margin="0,5" />

            <!-- Section Organisation -->
            <Label Text="{Binding [Settings_Scores_Section_Organization], Source={x:Static services:LocalizationService.Instance}}" 
                   TextColor="#007ACC" 
                   FontSize="18" 
                   FontAttributes="Bold" />

            <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="14,12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnManageTagsTapped" />
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" Text="🏷️" FontSize="22" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding [Settings_Scores_Manage_Tags], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="15" FontAttributes="Bold" />
                        <Label Text="{Binding [Settings_Scores_Manage_Tags_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="12" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" TextColor="#007ACC" FontSize="22" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

    </Grid>
</ContentPage>
