<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicScoreManager.SettingsScoresPage"
             BackgroundColor="#121212"
             Title="Paramètres Partitions">

    <Grid RowDefinitions="Auto, *">
        <!-- Header personnalisé avec bouton Retour -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="← Retour" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" 
                   Text="Paramètres Partitions" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"
                   Margin="0,0,80,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Margin="20">
            
            <Label Text="Général" 
                   TextColor="#007ACC" 
                   FontSize="18" 
                   FontAttributes="Bold" />

            <!-- Option : Tri par défaut des partitions -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Tri par défaut à l'ouverture" 
                       TextColor="White" 
                       FontSize="16" />
                <Label Text="Ordre de tri appliqué automatiquement à la liste des partitions" 
                       TextColor="#888888" 
                       FontSize="12" />
                <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="10,2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Picker x:Name="DefaultSortPicker"
                            TextColor="White"
                            TitleColor="#888888"
                            SelectedIndexChanged="OnDefaultSortChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Date d'ajout (Plus récent d'abord)</x:String>
                                <x:String>Date d'ajout (Plus ancien d'abord)</x:String>
                                <x:String>Titre (A-Z)</x:String>
                                <x:String>Titre (Z-A)</x:String>
                                <x:String>Date de modification (Récent)</x:String>
                                <x:String>Évaluation (Meilleures notes)</x:String>
                                <x:String>Compositeur (A-Z)</x:String>
                                <x:String>Sans étiquette d'abord</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Border>
            </VerticalStackLayout>

            <!-- Option : Sans compositeur en premier lors du tri par compositeur -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="Partitions sans compositeur en premier" 
                           TextColor="White" 
                           FontSize="15" />
                    <Label Text="Lors du tri par compositeur, place les partitions sans compositeur au début (désactivé : affichées à la fin)" 
                           TextColor="#888888" 
                           FontSize="12" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" 
                        x:Name="ComposerEmptyFirstSwitch" 
                        OnColor="#007ACC" 
                        ThumbColor="White" 
                        VerticalOptions="Center" 
                        Toggled="OnComposerEmptyFirstToggled" />
            </Grid>

            <BoxView HeightRequest="1" Color="#333333" />

            <Label Text="Affichage" 
                   TextColor="#007ACC" 
                   FontSize="18" 
                   FontAttributes="Bold" />

            <!-- Option : Informations sous le titre de la partition -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Informations sous le titre de la partition" 
                       TextColor="White" 
                       FontSize="16" 
                       FontAttributes="Bold" />
                <Label Text="Cochez les informations à afficher et réordonnez-les selon vos préférences (par glisser-déposer ou via les flèches ▲ / ▼) :" 
                       TextColor="#888888" 
                       FontSize="12" />

                <!-- Liste interactive et ordonnançable des éléments -->
                <VerticalStackLayout x:Name="SubtitleItemsLayout" Spacing="8" />

                <!-- Aperçu en temps réel -->
                <Border BackgroundColor="#181820" Stroke="#007ACC" StrokeThickness="1" Padding="12,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Aperçu dans la bibliothèque :" TextColor="#888899" FontSize="11" FontAttributes="Bold" />
                        <Label Text="Nocturne Op. 9 No. 2" TextColor="White" FontSize="14" FontAttributes="Bold" />
                        <Label x:Name="SubtitlePreviewLabel" Text="Frédéric Chopin • 4 pages • 17/09/2026" TextColor="#00B4D8" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#333333" />

            <!-- Option : Affichage du numéro de page -->
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Affichage du numéro de la page actuelle" 
                           TextColor="White" 
                           FontSize="16" />
                    <Label Text="Affiche l'indicateur de numéro de page en bas à droite" 
                           TextColor="#888888" 
                           FontSize="12" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" 
                        x:Name="ShowPageNumberSwitch"
                        OnColor="#007ACC"
                        ThumbColor="White"
                        Toggled="OnShowPageNumberToggled" />
            </Grid>

            <BoxView HeightRequest="1" Color="#333333" />

            <!-- Option : Affichage 2 pages en mode paysage -->
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Affichage 2 pages en mode paysage" 
                           TextColor="White" 
                           FontSize="16" />
                    <Label Text="Affiche deux pages côte à côte lorsque l'écran est orienté en mode paysage" 
                           TextColor="#888888" 
                           FontSize="12" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" 
                        x:Name="TwoPagesLandscapeSwitch"
                        OnColor="#007ACC"
                        ThumbColor="White"
                        Toggled="OnTwoPagesLandscapeToggled" />
            </Grid>

            <BoxView HeightRequest="1" Color="#333333" />

            <!-- Option : Taille d'affichage -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Taille d'affichage du numéro de page actuelle" 
                       TextColor="White" 
                       FontSize="16" />
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Label Grid.Column="0" Text="A" FontSize="12" TextColor="#888888" VerticalOptions="Center" />
                    <Slider Grid.Column="1" 
                            x:Name="PageNumberSizeSlider"
                            Minimum="10" 
                            Maximum="40" 
                            MinimumTrackColor="#007ACC"
                            MaximumTrackColor="#555555"
                            ThumbColor="#007ACC"
                            Margin="10,0"
                            ValueChanged="OnPageNumberSizeChanged" />
                    <Label Grid.Column="2" Text="A" FontSize="24" TextColor="#888888" VerticalOptions="Center" />
                </Grid>
                <Label x:Name="SizeValueLabel" 
                       Text="{Binding Source={x:Reference PageNumberSizeSlider}, Path=Value, StringFormat='{0:F0} px'}" 
                       TextColor="#007ACC" 
                       HorizontalOptions="End" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#333333" Margin="0,5" />

            <!-- Section Ergonomie -->
            <Label Text="Ergonomie" 
                   TextColor="#007ACC" 
                   FontSize="18" 
                   FontAttributes="Bold" />

            <!-- Option : Aller vers page suivante -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Aller vers page suivante" 
                       TextColor="White" 
                       FontSize="16" />
                <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="10,2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Picker x:Name="NextPageGesturePicker"
                            TextColor="White"
                            TitleColor="#888888"
                            SelectedIndexChanged="OnNextPageGestureChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Glisser vers la gauche</x:String>
                                <x:String>Taper à droite</x:String>
                                <x:String>Glisser vers le haut</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Border>
            </VerticalStackLayout>

            <!-- Option : Aller vers page précédente -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Aller vers page précédente" 
                       TextColor="White" 
                       FontSize="16" />
                <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="10,2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Picker x:Name="PrevPageGesturePicker"
                            TextColor="White"
                            TitleColor="#888888"
                            SelectedIndexChanged="OnPrevPageGestureChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Glisser vers la droite</x:String>
                                <x:String>Taper à gauche</x:String>
                                <x:String>Glisser vers le bas</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Border>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#333333" Margin="0,5" />

            <!-- Section Organisation & Étiquettes -->
            <Label Text="Organisation &amp; Taxonomie" 
                   TextColor="#007ACC" 
                   FontSize="18" 
                   FontAttributes="Bold" />

            <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="14,12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnManageTagsTapped" />
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" Text="🏷️" FontSize="22" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Gérer la liste des étiquettes" TextColor="White" FontSize="15" FontAttributes="Bold" />
                        <Label Text="Créer, colorer, renommer ou supprimer des étiquettes de la bibliothèque" TextColor="#888888" FontSize="12" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" TextColor="#007ACC" FontSize="22" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

    </Grid>
</ContentPage>
