<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MusicScoreManager.Models"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.TagsPage"
             BackgroundColor="#121212"
             Title="{Binding [Tags_Page_Title], Source={x:Static services:LocalizationService.Instance}}">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Header personnalisé avec bouton Retour et Bouton Ajouter (+) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="{Binding [Common_Back], Source={x:Static services:LocalizationService.Instance}}" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold" 
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" 
                    Text="{Binding [Tags_Page_Title], Source={x:Static services:LocalizationService.Instance}}" 
                    TextColor="White" 
                    FontSize="18" 
                    FontAttributes="Bold" 
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" />
            <Button Grid.Column="2"
                    Text="+"
                    FontSize="22"
                    FontAttributes="Bold"
                    WidthRequest="38"
                    HeightRequest="38"
                    CornerRadius="19"
                    BackgroundColor="#007ACC"
                    TextColor="White"
                    Padding="0"
                    Clicked="OnAddTagClicked" />
        </Grid>

        <SearchBar Grid.Row="1"
                   x:Name="SearchTagBar"
                   Placeholder="{Binding [Tags_Search_Placeholder], Source={x:Static services:LocalizationService.Instance}}"
                   PlaceholderColor="#888888"
                   TextColor="#FFFFFF"
                   BackgroundColor="#1E1E1E"
                   Margin="16,12,16,12"
                   TextChanged="OnSearchBarTextChanged" />

        <CollectionView Grid.Row="2"
                        x:Name="TagsCollectionView"
                        Margin="16,0"
                        SelectionMode="Single"
                        SelectionChanged="OnTagSelected">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Tag">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="{Binding [Tags_Swipe_Rename], Source={x:Static services:LocalizationService.Instance}}" 
                                           BackgroundColor="LightBlue" 
                                           Invoked="OnRenameTagInvoked" 
                                           CommandParameter="{Binding .}" />
                                <SwipeItem Text="{Binding [Tags_Swipe_Delete], Source={x:Static services:LocalizationService.Instance}}" 
                                           BackgroundColor="Red" 
                                           Invoked="OnDeleteTagInvoked" 
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Stroke="#333333" 
                                StrokeThickness="1" 
                                BackgroundColor="#1E1E1E" 
                                Padding="14,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <!-- Badge Étiquette avec le même design que la liste des partitions -->
                                <Border Grid.Column="0"
                                        BackgroundColor="{Binding ColorHex}"
                                        StrokeThickness="0"
                                        Padding="12,5"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Name}" 
                                           TextColor="White" 
                                           FontSize="13" 
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="2"
                                       Text="›" 
                                       TextColor="#666666" 
                                       FontSize="20" 
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                    <Label Text="{Binding [Tags_Empty], Source={x:Static services:LocalizationService.Instance}}"
                           TextColor="#888888"
                           HorizontalOptions="Center" />
                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
