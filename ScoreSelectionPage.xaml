<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MusicScoreManager"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.ScoreSelectionPage"
             Title="{Binding [Score_Selection_Title], Source={x:Static services:LocalizationService.Instance}}"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        
        <!-- Recherche et Tri -->
        <Grid Grid.Row="0" Margin="15,15,15,8" ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <SearchBar Grid.Column="0"
                       x:Name="SearchScoreBar"
                       Placeholder="{Binding [Score_Selection_Placeholder], Source={x:Static services:LocalizationService.Instance}}"
                       PlaceholderColor="#888888"
                       TextColor="#FFFFFF"
                       BackgroundColor="#1E1E1E"
                       TextChanged="OnSearchBarTextChanged" />

            <Button Grid.Column="1"
                    x:Name="SortButton"
                    Text="⇅"
                    FontSize="20"
                    FontAttributes="Bold"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="#333333"
                    TextColor="White"
                    Clicked="OnSortClicked" />
        </Grid>

        <!-- Filtres par Tags & Options -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" Margin="15,0,15,10" HeightRequest="40">
            <HorizontalStackLayout x:Name="TagFiltersStack" Spacing="8" VerticalOptions="Center" />
        </ScrollView>

        <!-- Liste des partitions -->
        <CollectionView Grid.Row="2"
                        x:Name="ScoresCollectionView"
                        Margin="15,0"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:SelectableScore">
                    <Border Stroke="#333333" 
                            StrokeThickness="1" 
                            BackgroundColor="#1E1E1E" 
                            Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="⚠️" 
                                           TextColor="Red" 
                                           FontSize="16" 
                                           VerticalOptions="Center"
                                           IsVisible="{Binding Score.IsFileMissing}" />
                                    <Label Text="{Binding Score.Title}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Score.IsFileMissing}" Value="True">
                                                <Setter Property="TextColor" Value="Red" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Score.IsFileMissing}" Value="False">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Score.Composer}" 
                                       TextColor="#AAAAAA" 
                                       FontSize="12" />
                                <FlexLayout BindableLayout.ItemsSource="{Binding Score.AppliedTags}"
                                            Wrap="Wrap"
                                            Direction="Row">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border BackgroundColor="{Binding ColorHex}"
                                                    StrokeThickness="0"
                                                    Padding="6,2"
                                                    Margin="0,2,4,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Name}" 
                                                       TextColor="White" 
                                                       FontSize="10" 
                                                       FontAttributes="Bold" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                            
                            <CheckBox Grid.Column="1" 
                                      IsChecked="{Binding IsSelected}"
                                      Color="#007ACC"
                                      VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Boutons d'action en bas -->
        <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="15" Padding="15" BackgroundColor="#121212">
            <Button Grid.Column="0"
                    Text="{Binding [Common_Cancel], Source={x:Static services:LocalizationService.Instance}}"
                    BackgroundColor="#333333"
                    TextColor="White"
                    Clicked="OnCancelClicked" />
            <Button Grid.Column="1"
                    x:Name="ConfirmButton"
                    Text="{Binding [Setlist_Edit_Add_Scores], Source={x:Static services:LocalizationService.Instance}}"
                    BackgroundColor="#007ACC"
                    TextColor="White"
                    FontAttributes="Bold"
                    Clicked="OnConfirmSelectionClicked" />
        </Grid>
    </Grid>
</ContentPage>
