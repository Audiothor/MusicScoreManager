<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MusicScoreManager.Models"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.SetlistEditPage"
             Title="{Binding [Setlist_Menu_Edit], Source={x:Static services:LocalizationService.Instance}}"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, *, Auto" Padding="{OnIdiom Phone='10,8', Tablet='15'}">
        
        <!-- En-tête : Détails Setlist -->
        <VerticalStackLayout Grid.Row="0" Spacing="{OnIdiom Phone=8, Tablet=12}" Margin="{OnIdiom Phone='0,0,0,8', Tablet='0,0,0,15'}">
            <Border Stroke="#333333" Padding="{OnIdiom Phone='10,8', Tablet='12'}" BackgroundColor="#1E1E1E">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="{OnIdiom Phone=6, Tablet=10}">
                    <!-- Nom de la Setlist -->
                    <Label Text="{Binding [Setlist_Name], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="11" />
                    <Entry x:Name="NameEntry" 
                           Placeholder="Ex: Concert d'été" 
                           TextColor="White" 
                           FontSize="{OnIdiom Phone=16, Tablet=18}" 
                           FontAttributes="Bold" />
                    
                    <!-- Date et Heure -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding [Setlist_Concert_Date_Label], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="11" />
                            <DatePicker x:Name="ConcertDatePicker" TextColor="White" MinimumDate="2020-01-01" FontSize="{OnIdiom Phone=13, Tablet=14}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{Binding [Setlist_Concert_Time], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="11" />
                            <TimePicker x:Name="ConcertTimePicker" TextColor="White" Format="HH:mm" FontSize="{OnIdiom Phone=13, Tablet=14}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Ligne Statut & Verrouillage -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center" Margin="0,2,0,0">
                        <Label Grid.Column="0" 
                               Text="{Binding [Setlist_Status], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="#888888" 
                               FontSize="11" 
                               VerticalOptions="Center" />
                        
                        <!-- Bouton Verrouillé / Déverrouillé -->
                        <Border Grid.Column="1" 
                                x:Name="LockBorder"
                                BackgroundColor="#28A745"
                                Padding="12,4"
                                StrokeThickness="1"
                                Stroke="#28A745"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLockTapped" />
                            </Border.GestureRecognizers>
                            <Label x:Name="LockIconLabel" 
                                   Text="{Binding [Setlist_Edit_Unlocked], Source={x:Static services:LocalizationService.Instance}}" 
                                   TextColor="White" 
                                   FontSize="11" 
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Chips de Statut + Indicateur Prêt -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <HorizontalStackLayout x:Name="StatusStack" Spacing="6" Grid.Column="0" VerticalOptions="Center">
                            <!-- Les chips seront générés dynamiquement dans le code-behind -->
                        </HorizontalStackLayout>

                        <!-- Indicateur de CACHE -->
                        <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" Margin="6,0,0,0">
                            <Label x:Name="CacheStatusIcon" Text="⏳" FontSize="14" VerticalOptions="Center" />
                            <Label x:Name="CacheStatusText" Text="Cache..." TextColor="#888888" FontSize="10" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#2A2A2A" Margin="0,2" />

                    <!-- Bouton Dépliant : Options Avancées -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,1" Padding="0,3">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleAdvancedOptionsClicked" />
                        </Grid.GestureRecognizers>
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="⚙️" FontSize="12" VerticalOptions="Center" />
                            <Label Text="{Binding [Setlist_Edit_Advanced_Options], Source={x:Static services:LocalizationService.Instance}}" 
                                   TextColor="#4FC3F7" 
                                   FontSize="12" 
                                   FontAttributes="Bold" 
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" 
                               x:Name="AdvancedOptionsChevron" 
                               Text="▼" 
                               TextColor="#4FC3F7" 
                               FontSize="11" 
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Zone Repliable des Options Avancées -->
                    <VerticalStackLayout x:Name="AdvancedOptionsLayout" 
                                         IsVisible="{OnIdiom Phone=False, Tablet=True}" 
                                         Spacing="8" 
                                         Margin="0,2,0,0">
                        <!-- Mode continu -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding [Setlist_Continuous_Mode], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="13" FontAttributes="Bold" />
                                <Label Text="{Binding [Setlist_Edit_Continuous_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="10" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" x:Name="ContinuousSwitch" IsToggled="True" OnColor="#007ACC" ThumbColor="White" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#2A2A2A" Margin="0,2" />

                        <!-- Profil de pédales -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding [Setlist_Pedal_Profile], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="13" FontAttributes="Bold" />
                            <Label Text="{Binding [Setlist_Pedal_Profile_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="10" />
                            <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#2C2C2C" Padding="8,2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Picker x:Name="PedalProfilePicker" 
                                        TextColor="White" 
                                        TitleColor="#888888" 
                                        FontSize="13" 
                                        SelectedIndexChanged="OnPedalProfilePickerChanged" />
                            </Border>
                            <Label x:Name="PedalProfileNoteLabel" TextColor="#4FC3F7" FontSize="10" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <!-- Bouton Supprimer la setlist -->
                        <Button x:Name="DeleteSetlistButton"
                                Text="{Binding [Setlist_Edit_Delete_Btn], Source={x:Static services:LocalizationService.Instance}}"
                                BackgroundColor="Transparent"
                                TextColor="#FF4444"
                                BorderColor="#FF4444"
                                BorderWidth="1"
                                HeightRequest="38"
                                FontSize="12"
                                Margin="0,4,0,0"
                                Clicked="OnDeleteSetlistClicked" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Ligne Titre Partitions & Bouton Ajouter -->
            <Grid ColumnDefinitions="*, Auto" Margin="2,4,2,0">
                <Label Grid.Column="0" 
                       Text="{Binding [Setlist_Edit_Scores], Source={x:Static services:LocalizationService.Instance}}" 
                       TextColor="White" 
                       FontSize="{OnIdiom Phone=17, Tablet=20}" 
                       FontAttributes="Bold" 
                       VerticalOptions="Center" />
                <Button Grid.Column="1" 
                        x:Name="AddScoreButton"
                        Text="{Binding [Setlist_Edit_Add], Source={x:Static services:LocalizationService.Instance}}" 
                        BackgroundColor="#007ACC" 
                        TextColor="White" 
                        FontSize="{OnIdiom Phone=12, Tablet=14}"
                        HeightRequest="{OnIdiom Phone=34, Tablet=40}"
                        CornerRadius="6"
                        Clicked="OnAddScoreClicked" />
            </Grid>
        </VerticalStackLayout>

        <!-- Liste des partitions (Réordonnable) -->
        <CollectionView Grid.Row="1"
                        x:Name="ScoresCollectionView"
                        SelectionMode="Single"
                        CanReorderItems="True"
                        ReorderCompleted="OnReorderCompleted">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" BackgroundColor="#1E1E1E" Margin="0,1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Zone Cliquable (Numéro + Titre) -->
                        <Grid Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto, *" ColumnSpacing="15">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnScoreRowTapped" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <!-- Numéro -->
                            <Label Grid.Column="0" 
                                   Text="{Binding DisplayOrder}"
                                   TextColor="#007ACC" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   VerticalOptions="Center" />
                            
                            <!-- Titre -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Score.Title}" FontSize="15" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Score.IsFileMissing}" Value="True">
                                            <Setter Property="TextColor" Value="#FF6B6B" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Score.IsFileMissing}" Value="False">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Score.Type}" TextColor="#888888" FontSize="11" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Icône d'erreur rouge (!) si le PDF est introuvable -->
                        <Border Grid.Column="2"
                                IsVisible="{Binding Score.IsFileMissing}"
                                BackgroundColor="#FF3B30"
                                StrokeThickness="0"
                                WidthRequest="22"
                                HeightRequest="22"
                                VerticalOptions="Center"
                                Margin="0,0,4,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="11" />
                            </Border.StrokeShape>
                            <Label Text="!" 
                                   TextColor="White" 
                                   FontAttributes="Bold" 
                                   FontSize="14" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   Margin="0,-1,0,0" />
                        </Border>

                        <!-- Actions : Dupliquer et Supprimer -->
                        <HorizontalStackLayout Grid.Column="3" Spacing="0" VerticalOptions="Center" IsVisible="{Binding IsNotLocked}">
                            <Button Text="⧉" 
                                    BackgroundColor="Transparent" 
                                    TextColor="#007ACC" 
                                    FontSize="16"
                                    WidthRequest="36"
                                    HeightRequest="40"
                                    Padding="0"
                                    Clicked="OnDuplicateScoreClicked" 
                                    CommandParameter="{Binding .}" />
                            <Button Text="✕" 
                                    BackgroundColor="Transparent" 
                                    TextColor="#FF4444" 
                                    FontSize="18"
                                    WidthRequest="36"
                                    HeightRequest="40"
                                    Padding="0"
                                    Clicked="OnRemoveScoreClicked" 
                                    CommandParameter="{Binding .}" />
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="{Binding [Setlist_Edit_Empty], Source={x:Static services:LocalizationService.Instance}}" 
                       TextColor="#555555" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       Margin="0,50,0,0" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Boutons d'action (Annuler / Enregistrer) -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="12" Margin="{OnIdiom Phone='0,8,0,0', Tablet='0,12,0,0'}">
            <Button Grid.Column="0" 
                    Text="{Binding [Common_Cancel], Source={x:Static services:LocalizationService.Instance}}" 
                    BackgroundColor="#333333" 
                    TextColor="White" 
                    HeightRequest="{OnIdiom Phone=40, Tablet=46}"
                    Clicked="OnCancelClicked" />
            <Button Grid.Column="1" 
                    Text="{Binding [Common_Save], Source={x:Static services:LocalizationService.Instance}}" 
                    BackgroundColor="#007ACC" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    HeightRequest="{OnIdiom Phone=40, Tablet=46}"
                    Clicked="OnSaveClicked" />
        </Grid>

        <!-- Overlay Indicateur de chargement Partition -->
        <ContentView x:Name="ScoreLoadingOverlay" 
                     Grid.Row="0"
                     Grid.RowSpan="3"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill"
                     IsVisible="False" 
                     BackgroundColor="#B0000000" 
                     ZIndex="2000"
                     InputTransparent="False">
            <Border x:Name="ScoreLoadingBorder"
                    BackgroundColor="#1E1E26" 
                    Stroke="#007ACC"
                    StrokeThickness="1.5"
                    WidthRequest="260"
                    HeightRequest="120"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    Padding="24,18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                    <ActivityIndicator IsRunning="True" Color="#00B4D8" HeightRequest="40" WidthRequest="40" HorizontalOptions="Center" />
                    <Label x:Name="ScoreLoadingText"
                           Text="{Binding [Score_Loading_Opening], Source={x:Static services:LocalizationService.Instance}}"
                           TextColor="White"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </ContentView>
    </Grid>
</ContentPage>
