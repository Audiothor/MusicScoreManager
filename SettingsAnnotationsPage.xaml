<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MusicScoreManager.Models"
             xmlns:local="clr-namespace:MusicScoreManager"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.SettingsAnnotationsPage"
             BackgroundColor="#121212"
             Title="{Binding [Settings_Annotations_Title], Source={x:Static services:LocalizationService.Instance}}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="{Binding [Common_Back], Source={x:Static services:LocalizationService.Instance}}" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold" 
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" 
                    Text="{Binding [Settings_Annotations_Title], Source={x:Static services:LocalizationService.Instance}}" 
                    TextColor="White" 
                    FontSize="18" 
                    FontAttributes="Bold" 
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    Margin="0,0,80,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="22" Padding="20">
                <!-- CHAPITRE 1 : Gestion des stickers Favoris -->
                <Label Text="{Binding [Settings_Annotations_Fav_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="#007ACC" FontSize="18" FontAttributes="Bold" />
                
                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding [Settings_Annotations_Fav_Add], Source={x:Static services:LocalizationService.Instance}}" TextColor="#CCCCCC" FontSize="13" />
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Entry x:Name="FavoriteEntry" 
                                   Placeholder="{Binding [Settings_Annotations_Fav_Placeholder], Source={x:Static services:LocalizationService.Instance}}" 
                                   PlaceholderColor="#666666" 
                                   TextColor="White" 
                                   BackgroundColor="#2C2C2C" />
                            <Button Grid.Column="1" 
                                    Text="+" 
                                    BackgroundColor="#007ACC" 
                                    TextColor="White" 
                                    WidthRequest="50" 
                                    Clicked="OnAddFavoriteClicked" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#333333" Margin="0,5" />

                        <Label Text="{Binding [Settings_Annotations_Fav_List], Source={x:Static services:LocalizationService.Instance}}" TextColor="#CCCCCC" FontSize="13" />
                        <CollectionView x:Name="FavoritesCollection" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:FavoriteSticker">
                                    <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#252525" Padding="10,6" Margin="0,2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Text="{Binding Text}" TextColor="White" VerticalOptions="Center" FontSize="15" />
                                            <Button Grid.Column="1" 
                                                    Text="✕" 
                                                    BackgroundColor="Transparent" 
                                                    TextColor="#FF6B6B" 
                                                    FontSize="16" 
                                                    Clicked="OnDeleteFavoriteClicked" 
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="{Binding [Settings_Annotations_Fav_Empty], Source={x:Static services:LocalizationService.Instance}}" 
                                       TextColor="#666666" 
                                       HorizontalOptions="Center" 
                                       Margin="0,10" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- CHAPITRE 2 : Sélection des catégories de stickers -->
                <Label Text="{Binding [Settings_Annotations_Categories_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="#007ACC" FontSize="18" FontAttributes="Bold" />
                
                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding [Settings_Annotations_Categories_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="#AAAAAA" 
                               FontSize="13" />
                        
                        <CollectionView x:Name="CategoriesCollection" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="local:StickerCategorySelectionItem">
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" Padding="0,6">
                                        <CheckBox IsChecked="{Binding IsSelected}" 
                                                  Color="#007ACC" 
                                                  VerticalOptions="Center" 
                                                  CheckedChanged="OnCategoryCheckedChanged" />
                                        <Label Grid.Column="1" 
                                               Text="{Binding DisplayName}" 
                                               TextColor="White" 
                                               FontSize="15" 
                                               VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
