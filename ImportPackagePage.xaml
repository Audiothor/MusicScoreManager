<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.ImportPackagePage"
             BackgroundColor="#121212"
             Title="{Binding [Import_Package_Page_Title], Source={x:Static services:LocalizationService.Instance}}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header personnalisé avec bouton Retour -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="{Binding [Common_Back], Source={x:Static services:LocalizationService.Instance}}" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold" 
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" 
                    Text="{Binding [Import_Package_Page_Title], Source={x:Static services:LocalizationService.Instance}}" 
                    TextColor="White" 
                    FontSize="18" 
                    FontAttributes="Bold" 
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    Margin="0,0,80,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18" Margin="20">
                <Label Text="{Binding [Import_Package_Subtitle], Source={x:Static services:LocalizationService.Instance}}" 
                       TextColor="White" 
                       FontSize="16" 
                       FontAttributes="Bold" />
                <Label Text="{Binding [Import_Package_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                       TextColor="#AAAAAA" 
                       FontSize="13" />

                <!-- Carte d'information sur les formats compatibles -->
                <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding [Import_Package_Formats_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="#64B5F6" FontSize="13" FontAttributes="Bold" />
                        <Label Text="{Binding [Import_Package_Format_Setlist], Source={x:Static services:LocalizationService.Instance}}" TextColor="#CCCCCC" FontSize="12" />
                        <Label Text="{Binding [Import_Package_Format_Score], Source={x:Static services:LocalizationService.Instance}}" TextColor="#CCCCCC" FontSize="12" />
                        <Label Text="{Binding [Import_Package_Format_Scores], Source={x:Static services:LocalizationService.Instance}}" TextColor="#CCCCCC" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- Bouton d'action principal -->
                <Button Text="{Binding [Import_Package_Action_Btn], Source={x:Static services:LocalizationService.Instance}}" 
                        BackgroundColor="#2ECC71" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        FontSize="15" 
                        HeightRequest="50" 
                        CornerRadius="8" 
                        Clicked="OnImportPackageClicked" />

                <!-- Indicateur de progression / état -->
                <VerticalStackLayout x:Name="ImportStatusSection" Spacing="10" IsVisible="False" Margin="0,10">
                    <ActivityIndicator IsRunning="True" Color="#2ECC71" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" />
                    <Label x:Name="ImportStatusLabel" Text="{Binding [Import_Package_Progress], Source={x:Static services:LocalizationService.Instance}}" TextColor="#2ECC71" FontSize="13" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
