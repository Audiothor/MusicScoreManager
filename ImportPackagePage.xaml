<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicScoreManager.ImportPackagePage"
             BackgroundColor="#121212"
             Title="Imports de Paquets">

    <Grid RowDefinitions="Auto, *">
        <!-- Header personnalisé avec bouton Retour -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="← Retour" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" 
                   Text="Imports de Paquets" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"
                   Margin="0,0,80,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18" Margin="20">
                <Label Text="Importer une archive ou setlist partagée" 
                       TextColor="White" 
                       FontSize="16"
                       FontAttributes="Bold" />
                <Label Text="Importez un fichier '.msmsetlist', '.msmscore' ou '.msmscores' exporté depuis un autre appareil pour intégrer automatiquement les partitions, métadonnées, annotations et setlists." 
                       TextColor="#AAAAAA" 
                       FontSize="13" />

                <!-- Carte d'information sur les formats compatibles -->
                <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Formats de paquets pris en charge :" TextColor="#64B5F6" FontSize="13" FontAttributes="Bold" />
                        <Label Text="• .msmsetlist : Setlist complète avec toutes ses partitions, métadonnées et annotations" TextColor="#CCCCCC" FontSize="12" />
                        <Label Text="• .msmscore : Partition individuelle avec ses fichiers audio et annotations" TextColor="#CCCCCC" FontSize="12" />
                        <Label Text="• .msmscores : Paquet groupé de plusieurs partitions" TextColor="#CCCCCC" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- Bouton d'action principal -->
                <Button Text="📥 Sélectionner et importer un paquet..."
                        BackgroundColor="#2ECC71"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="15"
                        HeightRequest="50"
                        CornerRadius="8"
                        Clicked="OnImportPackageClicked" />

                <!-- Indicateur de progression / état -->
                <VerticalStackLayout x:Name="ImportStatusSection" Spacing="10" IsVisible="False" Margin="0,10">
                    <ActivityIndicator IsRunning="True" Color="#2ECC71" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" />
                    <Label x:Name="ImportStatusLabel" Text="Importation en cours..." TextColor="#2ECC71" FontSize="13" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
