<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MusicScoreManager.Models"
             xmlns:local="clr-namespace:MusicScoreManager"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.PedalProfileEditPage"
             BackgroundColor="#121212"
             Title="{Binding [Pedal_Profile_Edit_Title], Source={x:Static services:LocalizationService.Instance}}">

    <Grid RowDefinitions="Auto, *">
        <!-- En-tête -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="12,10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="{Binding [Common_Back], Source={x:Static services:LocalizationService.Instance}}" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold" 
                    Clicked="OnBackClicked" />

            <Label Grid.Column="1" 
                   Text="{Binding [Pedal_Profile_Edit_Header], Source={x:Static services:LocalizationService.Instance}}" 
                   TextColor="White" 
                   FontSize="17" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center" />

            <Button Grid.Column="2" 
                    Text="{Binding [Common_Save], Source={x:Static services:LocalizationService.Instance}}" 
                    BackgroundColor="#007ACC" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="13"
                    Padding="12,6"
                    CornerRadius="8"
                    Clicked="OnSaveProfileClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="16">

                <!-- CARTE 1 : Informations générales du profil -->
                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding [Pedal_Profile_Section_Info], Source={x:Static services:LocalizationService.Instance}}" TextColor="#007ACC" FontSize="16" FontAttributes="Bold" />

                        <!-- Nom du profil -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding [Pedal_Profile_Name_Label], Source={x:Static services:LocalizationService.Instance}}" TextColor="#CCCCCC" FontSize="13" FontAttributes="Bold" />
                            <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#2A2A2A" Padding="10,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Entry x:Name="ProfileNameEntry" 
                                       TextColor="White" 
                                       FontSize="15" 
                                       Placeholder="{Binding [Pedal_Profile_Name_Placeholder], Source={x:Static services:LocalizationService.Instance}}" 
                                       PlaceholderColor="#777777" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Description & Commentaires libres -->
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding [Pedal_Profile_Desc_Label], Source={x:Static services:LocalizationService.Instance}}" TextColor="#CCCCCC" FontSize="13" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding [Pedal_Profile_Visible_Hint], Source={x:Static services:LocalizationService.Instance}}" TextColor="#777777" FontSize="11" />
                            </Grid>
                            <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#2A2A2A" Padding="10,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Editor x:Name="ProfileDescEditor" 
                                        TextColor="White" 
                                        FontSize="13" 
                                        AutoSize="TextChanges" 
                                        MinimumHeightRequest="75"
                                        Placeholder="{Binding [Pedal_Profile_Desc_Placeholder], Source={x:Static services:LocalizationService.Instance}}" 
                                        PlaceholderColor="#777777" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- CARTE 2 : Boutons & Pédales configurés -->
                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding [Pedal_Profile_Section_Buttons], Source={x:Static services:LocalizationService.Instance}}" TextColor="#007ACC" FontSize="16" FontAttributes="Bold" />
                                <Label x:Name="ButtonsCountLabel" Text="" TextColor="#888888" FontSize="12" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1" 
                                    Text="{Binding [Pedal_Profile_Add_Btn], Source={x:Static services:LocalizationService.Instance}}" 
                                    BackgroundColor="#2E7D32" 
                                    TextColor="White" 
                                    FontAttributes="Bold" 
                                    FontSize="13" 
                                    Padding="12,6" 
                                    CornerRadius="8" 
                                    HeightRequest="40"
                                    Clicked="OnAddButtonBindingClicked" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#2E2E2E" Margin="0,2" />

                        <!-- Message si aucun bouton -->
                        <Label x:Name="EmptyBindingsLabel" 
                               Text="{Binding [Pedal_Profile_Empty_Bindings], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="#888888" 
                               FontSize="13" 
                               HorizontalTextAlignment="Center" 
                               Margin="0,20" 
                               IsVisible="False" />

                        <!-- Liste dynamique des boutons/pédales -->
                        <VerticalStackLayout x:Name="BindingsListLayout" Spacing="10" />

                    </VerticalStackLayout>
                </Border>

                <!-- Bouton Enregistrer au bas également -->
                <Button Text="{Binding [Pedal_Profile_Save_Changes], Source={x:Static services:LocalizationService.Instance}}" 
                        BackgroundColor="#007ACC" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        HeightRequest="48" 
                        CornerRadius="10" 
                        Margin="0,10,0,20"
                        Clicked="OnSaveProfileClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
