<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicScoreManager.ViewerPage"
             BackgroundColor="#000000"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid BackgroundColor="Black">
        <!-- L'image avec zoom (ScrollView) -->
        <ScrollView x:Name="ImageScrollView" 
                    IsVisible="False" 
                    Orientation="Both"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
            <Image x:Name="ScoreImage" 
                   Aspect="AspectFit" 
                   HorizontalOptions="Fill" 
                   VerticalOptions="Fill" />
        </ScrollView>

        <!-- Zones tactiles pour les images (transparentes) -->
        <Grid x:Name="ImageTouchGrid" IsVisible="False" BackgroundColor="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <ContentView Grid.Column="0" BackgroundColor="Transparent">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPrevTapped" />
                </ContentView.GestureRecognizers>
            </ContentView>
            <ContentView Grid.Column="1" BackgroundColor="Transparent">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCenterTapped" />
                </ContentView.GestureRecognizers>
            </ContentView>
            <ContentView Grid.Column="2" BackgroundColor="Transparent">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNextTapped" />
                </ContentView.GestureRecognizers>
            </ContentView>
        </Grid>

        <!-- Le PDF -->
        <WebView x:Name="PdfWebView" 
                 IsVisible="False" 
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"
                 Navigated="OnPdfWebViewNavigated"
                 Navigating="OnPdfWebViewNavigating" />

        <!-- Indicateur de page -->
        <Label x:Name="PageIndicator" 
               IsVisible="False" 
               HorizontalOptions="End" 
               VerticalOptions="End" 
               Margin="20" 
               TextColor="White" 
               BackgroundColor="#80000000" 
               Padding="10,5" />

        <!-- Menu Central -->
        <Border x:Name="CentralMenuOverlay" 
                IsVisible="False" 
                BackgroundColor="#CC000000" 
                VerticalOptions="Center" 
                HorizontalOptions="Center" 
                Padding="30"
                WidthRequest="300">
            <VerticalStackLayout Spacing="15">
                <Label x:Name="MenuTitleLabel" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                <Label x:Name="MenuTypeLabel" FontSize="14" TextColor="LightGray" HorizontalTextAlignment="Center" />

                <Button x:Name="RotateBtn" Text="Rotation 90°" BackgroundColor="#007ACC" TextColor="White" Clicked="OnRotateClicked" />
                
                <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                    <Label Text="Mémoriser" TextColor="White" VerticalOptions="Center" />
                    <Switch Grid.Column="1" x:Name="SaveRotationSwitch" OnColor="#007ACC" ThumbColor="White" Toggled="OnSaveRotationToggled" />
                </Grid>

                <Button Text="Retour à l'accueil" BackgroundColor="#C0392B" TextColor="White" Clicked="OnBackClicked" />
                <Button Text="Annuler" BackgroundColor="#333333" TextColor="White" Clicked="OnCloseMenuClicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
