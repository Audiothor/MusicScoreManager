<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:conv="clr-namespace:MusicScoreManager.Converters"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.ViewerPage"
             BackgroundColor="#000000"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:ScaleToFontSizeConverter x:Key="ScaleToFontSizeConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="Black">
        <!-- MediaElement pour la lecture audio et les bips -->
        <toolkit:MediaElement x:Name="AudioPlayer" IsVisible="False" />

        <!-- L'affichage de partition avec zoom unifié (PDF & Image) -->
        <Grid x:Name="ImageContainer" 
              HorizontalOptions="Fill" 
              VerticalOptions="Fill" 
              BackgroundColor="Black">
            <Grid.GestureRecognizers>
                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                <TapGestureRecognizer Tapped="OnImageSingleTapped" NumberOfTapsRequired="1" />
                <TapGestureRecognizer Tapped="OnImageDoubleTapped" NumberOfTapsRequired="2" />
                <SwipeGestureRecognizer Direction="Left" Swiped="OnImageSwipedLeft" />
                <SwipeGestureRecognizer Direction="Right" Swiped="OnImageSwipedRight" />
                <SwipeGestureRecognizer Direction="Up" Swiped="OnImageSwipedUp" />
                <SwipeGestureRecognizer Direction="Down" Swiped="OnImageSwipedDown" />
            </Grid.GestureRecognizers>
            
            <Grid x:Name="ZoomLayout"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill">

                <!-- Le PDF -->
                <WebView x:Name="PdfWebView" 
                         IsVisible="False" 
                         BackgroundColor="Black"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill"
                         Navigated="OnPdfWebViewNavigated"
                         Navigating="OnPdfWebViewNavigating" />

                <!-- L'image -->
                <Image x:Name="ScoreImage" 
                       IsVisible="False"
                       Aspect="AspectFit" 
                       HorizontalOptions="Fill" 
                       VerticalOptions="Fill"
                       BackgroundColor="White"
                       InputTransparent="True" />

                <!-- Conteneur d'annotations unifié (qui zoom, dézoome et se déplace parfaitement avec le PDF ou l'Image) -->
                <AbsoluteLayout x:Name="AnnotationsContainer" 
                                HorizontalOptions="Fill" 
                                VerticalOptions="Fill" 
                                ZIndex="10"
                                Opacity="0"
                                InputTransparent="True"
                                CascadeInputTransparent="False">
                    <AbsoluteLayout.GestureRecognizers>
                        <DropGestureRecognizer Drop="OnStickerDrop" AllowDrop="True" />
                        <TapGestureRecognizer Tapped="OnPlacementTapped" />
                        <PanGestureRecognizer PanUpdated="OnHighlightPanUpdated" />
                        <PointerGestureRecognizer PointerPressed="OnHighlightPointerPressed" 
                                                  PointerMoved="OnHighlightPointerMoved" 
                                                  PointerReleased="OnHighlightPointerReleased" />
                    </AbsoluteLayout.GestureRecognizers>
                </AbsoluteLayout>
            </Grid>
        </Grid>

        <!-- Overlay MÉTRONOME (Haut-Droite) -->
        <Border x:Name="MetronomeOverlay" 
                IsVisible="False"
                HorizontalOptions="End" 
                VerticalOptions="Start" 
                Margin="10,5,10,0" 
                Padding="10,5"
                BackgroundColor="#80000000"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMetronomeOverlayTapped" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label x:Name="MetronomeBpmLabel" Text="120 BPM" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <BoxView x:Name="MetronomeLight" WidthRequest="20" HeightRequest="20" Color="#333333" CornerRadius="10" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- Overlay LECTEUR AUDIO Flottant & Amovible (Haut Gauche - Opposé du métronome) -->
        <Border x:Name="AudioPlayerOverlay" 
                IsVisible="False"
                VerticalOptions="Start" 
                HorizontalOptions="Start"
                Margin="10,5,0,0" 
                Padding="8,6"
                BackgroundColor="#EE1E1E1E"
                StrokeThickness="1"
                Stroke="#444444"
                WidthRequest="265"
                ZIndex="20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnAudioPlayerPanUpdated" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="3">
                <!-- Entête : Poignée de déplacement, Titre / Nom du morceau, Fermer -->
                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                    <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                        <Label Text="⠿" TextColor="#888888" FontSize="13" VerticalOptions="Center" />
                        <Label Text="🎵" FontSize="11" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Grid.Column="1" x:Name="AudioTrackNameLabel" Text="Audio" TextColor="#CCCCCC" FontSize="11" FontAttributes="Bold" LineBreakMode="TailTruncation" VerticalOptions="Center" Margin="4,0" />
                    <Button Grid.Column="2" Text="✕" TextColor="#888888" BackgroundColor="Transparent" FontSize="11" Padding="0" WidthRequest="22" HeightRequest="22" Clicked="OnAudioCloseClicked" />
                </Grid>

                <!-- Boutons de commande : Stop/Début, Reculer, Play/Pause, Avancer -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="5" HorizontalOptions="Fill">
                    <!-- Stop / Retour début -->
                    <Button Grid.Column="0" 
                            Text="⏮" 
                            ToolTipProperties.Text="Stop / Début"
                            BackgroundColor="#2D2D35" 
                            TextColor="White" 
                            FontSize="15" 
                            HeightRequest="32" 
                            Padding="0" 
                            CornerRadius="6"
                            Clicked="OnAudioToStartClicked" />

                    <!-- Reculer (-5s) -->
                    <Button Grid.Column="1" 
                            Text="⏪" 
                            ToolTipProperties.Text="Reculer de 5s"
                            BackgroundColor="#2D2D35" 
                            TextColor="White" 
                            FontSize="15" 
                            HeightRequest="32" 
                            Padding="0" 
                            CornerRadius="6"
                            Clicked="OnAudioRewindClicked" />

                    <!-- Play / Pause -->
                    <Button Grid.Column="2" 
                            x:Name="AudioPlayBtn" 
                            Text="▶" 
                            ToolTipProperties.Text="Lecture / Pause"
                            BackgroundColor="#007ACC" 
                            TextColor="White" 
                            FontSize="16" 
                            FontAttributes="Bold"
                            HeightRequest="32" 
                            Padding="0" 
                            CornerRadius="6"
                            Clicked="OnAudioPlayPauseClicked" />

                    <!-- Avancer (+5s) -->
                    <Button Grid.Column="3" 
                            Text="⏩" 
                            ToolTipProperties.Text="Avancer de 5s"
                            BackgroundColor="#2D2D35" 
                            TextColor="White" 
                            FontSize="15" 
                            HeightRequest="32" 
                            Padding="0" 
                            CornerRadius="6"
                            Clicked="OnAudioForwardClicked" />
                </Grid>

                <!-- Barre de déplacement dans le son (Slider) et durée -->
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="6" VerticalOptions="Center" Margin="0,1,0,0">
                    <Label Grid.Column="0" x:Name="AudioCurrentTimeLabel" Text="0:00" TextColor="#AAAAAA" FontSize="10" VerticalOptions="Center" />
                    <Slider Grid.Column="1" x:Name="AudioSlider" 
                            MinimumTrackColor="#007ACC" 
                            MaximumTrackColor="#555555" 
                            ThumbColor="White" 
                            HeightRequest="24"
                            DragStarted="OnAudioSliderDragStarted" 
                            DragCompleted="OnAudioSliderDragCompleted" 
                            ValueChanged="OnAudioSliderValueChanged" 
                            VerticalOptions="Center" />
                    <Label Grid.Column="2" x:Name="AudioTotalTimeLabel" Text="0:00" TextColor="#AAAAAA" FontSize="10" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Sélecteur de Stickers et Réglages (Drawer Unique Adaptatif) -->
        <Border x:Name="StickerPickerOverlay"
                IsVisible="False"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                BackgroundColor="#EE000000"
                Margin="10,0,10,45"
                Padding="10,8"
                StrokeThickness="1"
                Stroke="#444444"
                ZIndex="25">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            
            <ScrollView x:Name="StickerPickerScrollView" VerticalScrollBarVisibility="Never" Orientation="Vertical">
                <VerticalStackLayout Spacing="8">
                    <!-- Header : Titre et Bouton Fermer -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,2">
                        <Label Grid.Column="0" Text="Réglages des stickers" TextColor="#AAAAAA" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="✕" TextColor="#FF5555" BackgroundColor="Transparent" FontSize="18" FontAttributes="Bold" Padding="0" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" HorizontalOptions="Center" Clicked="OnCloseStickerPickerClicked" />
                    </Grid>

                    <!-- Ligne Couleurs Texte : Défilement fluide -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Texte:" TextColor="White" VerticalOptions="Center" FontSize="11" FontAttributes="Bold" />
                        <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <!-- Rouge (défaut) -->
                                <Ellipse WidthRequest="22" HeightRequest="22" Fill="#FF0000" Stroke="#666666" StrokeThickness="1">
                                    <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerColorTapped" CommandParameter="Red"/></Ellipse.GestureRecognizers>
                                </Ellipse>
                                <!-- Blanc -->
                                <Ellipse WidthRequest="22" HeightRequest="22" Fill="#FFFFFF" Stroke="#666666" StrokeThickness="1">
                                    <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerColorTapped" CommandParameter="White"/></Ellipse.GestureRecognizers>
                                </Ellipse>
                                <!-- Noir -->
                                <Ellipse WidthRequest="22" HeightRequest="22" Fill="#000000" Stroke="#888888" StrokeThickness="1.5">
                                    <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerColorTapped" CommandParameter="Black"/></Ellipse.GestureRecognizers>
                                </Ellipse>
                                <!-- Bleu -->
                                <Ellipse WidthRequest="22" HeightRequest="22" Fill="#007ACC" Stroke="#666666" StrokeThickness="1">
                                    <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerColorTapped" CommandParameter="Blue"/></Ellipse.GestureRecognizers>
                                </Ellipse>
                                <!-- Jaune -->
                                <Ellipse WidthRequest="22" HeightRequest="22" Fill="#FFD600" Stroke="#666666" StrokeThickness="1">
                                    <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerColorTapped" CommandParameter="Yellow"/></Ellipse.GestureRecognizers>
                                </Ellipse>
                                <!-- Vert -->
                                <Ellipse WidthRequest="22" HeightRequest="22" Fill="#2ECC71" Stroke="#666666" StrokeThickness="1">
                                    <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerColorTapped" CommandParameter="Green"/></Ellipse.GestureRecognizers>
                                </Ellipse>
                                <!-- Orange -->
                                <Ellipse WidthRequest="22" HeightRequest="22" Fill="#FF9800" Stroke="#666666" StrokeThickness="1">
                                    <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerColorTapped" CommandParameter="Orange"/></Ellipse.GestureRecognizers>
                                </Ellipse>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </Grid>

                    <!-- Ligne Couleurs Fond : Défilement fluide -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Fond:" TextColor="White" VerticalOptions="Center" FontSize="11" FontAttributes="Bold" />
                        <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <!-- Noir (défaut) -->
                                <Ellipse WidthRequest="22" HeightRequest="22" Fill="#000000" Stroke="#888888" StrokeThickness="1.5">
                                    <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerBgColorTapped" CommandParameter="Black"/></Ellipse.GestureRecognizers>
                                </Ellipse>
                                <!-- Transparent -->
                                <Grid WidthRequest="22" HeightRequest="22" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerBgColorTapped" CommandParameter="Transparent"/></Grid.GestureRecognizers>
                                    <Ellipse WidthRequest="22" HeightRequest="22" Fill="Transparent" Stroke="#888888" StrokeThickness="1" />
                                    <Label Text="∅" TextColor="#AAAAAA" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                                </Grid>
                                <!-- Gris Foncé -->
                                <Ellipse WidthRequest="22" HeightRequest="22" Fill="#333333" Stroke="#666666" StrokeThickness="1">
                                    <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerBgColorTapped" CommandParameter="DarkGray"/></Ellipse.GestureRecognizers>
                                </Ellipse>
                                <!-- Ivoire -->
                                <Ellipse WidthRequest="22" HeightRequest="22" Fill="#FFFFE0" Stroke="#666666" StrokeThickness="1">
                                    <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerBgColorTapped" CommandParameter="Ivory"/></Ellipse.GestureRecognizers>
                                </Ellipse>
                                <!-- Rouge -->
                                <Ellipse WidthRequest="22" HeightRequest="22" Fill="#FF0000" Stroke="#666666" StrokeThickness="1">
                                    <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerBgColorTapped" CommandParameter="Red"/></Ellipse.GestureRecognizers>
                                </Ellipse>
                                <!-- Jaune -->
                                <Ellipse WidthRequest="22" HeightRequest="22" Fill="#FFD600" Stroke="#666666" StrokeThickness="1">
                                    <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerBgColorTapped" CommandParameter="Yellow"/></Ellipse.GestureRecognizers>
                                </Ellipse>
                                <!-- Vert -->
                                <Ellipse WidthRequest="22" HeightRequest="22" Fill="#2ECC71" Stroke="#666666" StrokeThickness="1">
                                    <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerBgColorTapped" CommandParameter="Green"/></Ellipse.GestureRecognizers>
                                </Ellipse>
                                <!-- Bleu -->
                                <Ellipse WidthRequest="22" HeightRequest="22" Fill="#007ACC" Stroke="#666666" StrokeThickness="1">
                                    <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerBgColorTapped" CommandParameter="Blue"/></Ellipse.GestureRecognizers>
                                </Ellipse>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </Grid>

                    <!-- Ligne 3: Taille Slider large et tactile -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Taille:" TextColor="White" VerticalOptions="Center" FontSize="13" FontAttributes="Bold" />
                        <Slider Grid.Column="1" x:Name="StickerSizeSlider" 
                                Minimum="0.5" Maximum="3.0" Value="1.0" 
                                HeightRequest="36" 
                                MinimumTrackColor="#007ACC" MaximumTrackColor="#555555" ThumbColor="White" 
                                VerticalOptions="Center" HorizontalOptions="FillAndExpand" 
                                ValueChanged="OnStickerSizeChanged" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#444444" />

                    <!-- Catégories -->
                    <CollectionView x:Name="StickerCategoriesCollection" 
                                    HeightRequest="40"
                                    Margin="4,0"
                                    SelectionMode="Single"
                                    SelectionChanged="OnStickerCategoryChanged">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#2D2D35" 
                                        Padding="14,6" 
                                        Stroke="#444444"
                                        StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding DisplayName}" 
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           VerticalTextAlignment="Center"
                                           HorizontalTextAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1" Color="#444444" />

                    <!-- Stickers de la catégorie -->
                    <CollectionView x:Name="StickersCollection" 
                                    HeightRequest="65"
                                    Margin="4,0"
                                    SelectionMode="Single"
                                    SelectionChanged="OnStickerSelected"
                                    HorizontalOptions="Fill">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="StickerBorder"
                                        Margin="2,2" 
                                        BackgroundColor="{Binding BackgroundColor}" 
                                        Padding="14,6"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{Binding BorderColor}"
                                        StrokeThickness="{Binding BorderThickness}">
                                    <Border.GestureRecognizers>
                                        <DragGestureRecognizer DragStarting="OnStickerDragStarting" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Text}" 
                                           TextColor="{Binding Color}" 
                                           FontSize="{Binding Scale, Converter={StaticResource ScaleToFontSizeConverter}}" 
                                           FontAttributes="Bold"
                                           LineBreakMode="NoWrap"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center"
                                           VerticalTextAlignment="Center"
                                           HorizontalTextAlignment="Center"
                                           InputTransparent="True" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Panneau d'options de surlignage (Stabilo) -->
        <Border x:Name="HighlightOptionsOverlay"
                IsVisible="False"
                VerticalOptions="End"
                HorizontalOptions="Center"
                Margin="0,0,0,45"
                BackgroundColor="#EE1E1E24"
                Stroke="#44FFFFFF"
                StrokeThickness="1"
                Padding="8,5"
                ZIndex="25">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <StackLayout x:Name="HighlightOptionsLayout" Orientation="Horizontal" Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                <!-- Pastilles de couleurs (Jaune par défaut, Vert, Bleu, Rouge/Rose) -->
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                    <!-- Jaune (défaut) -->
                    <Border x:Name="HighlightYellowBtn" BackgroundColor="#FFFF00" WidthRequest="24" HeightRequest="24" Stroke="White" StrokeThickness="3">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnHighlightColorSelected" CommandParameter="#FFFF00" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Vert -->
                    <Border x:Name="HighlightGreenBtn" BackgroundColor="#00E676" WidthRequest="24" HeightRequest="24" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnHighlightColorSelected" CommandParameter="#00E676" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Bleu -->
                    <Border x:Name="HighlightBlueBtn" BackgroundColor="#00B0FF" WidthRequest="24" HeightRequest="24" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnHighlightColorSelected" CommandParameter="#00B0FF" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Rouge/Rose -->
                    <Border x:Name="HighlightRedBtn" BackgroundColor="#FF4081" WidthRequest="24" HeightRequest="24" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnHighlightColorSelected" CommandParameter="#FF4081" /></Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>

                <!-- Séparateur vertical (visible en paysage) -->
                <BoxView x:Name="HighlightOptionsSeparator" WidthRequest="1" HeightRequest="20" Color="#44FFFFFF" VerticalOptions="Center" />

                <!-- Choix de largeur de stabilo + Bouton fermer -->
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="Taille:" TextColor="#CCCCCC" FontSize="11" VerticalOptions="Center" />
                    <!-- Bouton Fin (5mm) -->
                    <Button x:Name="HighlightSizeSmallBtn" Text="5mm" BackgroundColor="#333333" TextColor="White" FontSize="11" HeightRequest="26" Padding="6,0" CornerRadius="5" Clicked="OnHighlightSizeSelected" CommandParameter="15" />
                    <!-- Bouton Moyen (10mm - Défaut) -->
                    <Button x:Name="HighlightSizeMediumBtn" Text="10mm" BackgroundColor="#007ACC" TextColor="White" FontSize="11" HeightRequest="26" Padding="6,0" CornerRadius="5" FontAttributes="Bold" Clicked="OnHighlightSizeSelected" CommandParameter="30" />
                    <!-- Bouton Large (18mm) -->
                    <Button x:Name="HighlightSizeLargeBtn" Text="18mm" BackgroundColor="#333333" TextColor="White" FontSize="11" HeightRequest="26" Padding="6,0" CornerRadius="5" Clicked="OnHighlightSizeSelected" CommandParameter="50" />
                    <!-- Bouton fermer le panneau -->
                    <Button Text="✕" BackgroundColor="Transparent" TextColor="#AAAAAA" FontSize="14" HeightRequest="26" WidthRequest="22" Padding="0" Clicked="OnCloseHighlightOptionsClicked" VerticalOptions="Center" Margin="3,0,0,0" />
                </HorizontalStackLayout>
            </StackLayout>
        </Border>

        <!-- Panneau d'options de dessin (Crayon) -->
        <Border x:Name="DrawOptionsOverlay"
                IsVisible="False"
                VerticalOptions="End"
                HorizontalOptions="Center"
                Margin="0,0,0,45"
                BackgroundColor="#EE1E1E24"
                Stroke="#44FFFFFF"
                StrokeThickness="1"
                Padding="8,5"
                ZIndex="25">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <StackLayout x:Name="DrawOptionsLayout" Orientation="Horizontal" Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                <!-- Pastilles de couleurs (Noir par défaut, Rouge, Bleu, Vert, Jaune, Blanc) -->
                <HorizontalStackLayout Spacing="5" VerticalOptions="Center" HorizontalOptions="Center">
                    <!-- Noir (défaut) -->
                    <Border x:Name="DrawBlackBtn" BackgroundColor="#000000" WidthRequest="22" HeightRequest="22" Stroke="White" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDrawColorSelected" CommandParameter="#000000" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Rouge -->
                    <Border x:Name="DrawRedBtn" BackgroundColor="#E53935" WidthRequest="22" HeightRequest="22" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDrawColorSelected" CommandParameter="#E53935" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Bleu -->
                    <Border x:Name="DrawBlueBtn" BackgroundColor="#1E88E5" WidthRequest="22" HeightRequest="22" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDrawColorSelected" CommandParameter="#1E88E5" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Vert -->
                    <Border x:Name="DrawGreenBtn" BackgroundColor="#43A047" WidthRequest="22" HeightRequest="22" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDrawColorSelected" CommandParameter="#43A047" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Jaune -->
                    <Border x:Name="DrawYellowBtn" BackgroundColor="#FFD600" WidthRequest="22" HeightRequest="22" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDrawColorSelected" CommandParameter="#FFD600" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Blanc -->
                    <Border x:Name="DrawWhiteBtn" BackgroundColor="#FFFFFF" WidthRequest="22" HeightRequest="22" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDrawColorSelected" CommandParameter="#FFFFFF" /></Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>

                <!-- Séparateur vertical (visible en paysage) -->
                <BoxView x:Name="DrawOptionsSeparator" WidthRequest="1" HeightRequest="20" Color="#44FFFFFF" VerticalOptions="Center" />

                <!-- Choix de largeur de crayon (1mm, 2mm, 3mm, 4mm, 5mm) + Bouton fermer -->
                <HorizontalStackLayout Spacing="3" VerticalOptions="Center" HorizontalOptions="Center">
                    <Button x:Name="DrawSize1Btn" Text="1mm" MinimumWidthRequest="0" WidthRequest="32" BackgroundColor="#333333" TextColor="White" FontSize="10" HeightRequest="26" Padding="0" CornerRadius="5" Clicked="OnDrawSizeSelected" CommandParameter="3" />
                    <Button x:Name="DrawSize2Btn" Text="2mm" MinimumWidthRequest="0" WidthRequest="32" BackgroundColor="#333333" TextColor="White" FontSize="10" HeightRequest="26" Padding="0" CornerRadius="5" Clicked="OnDrawSizeSelected" CommandParameter="6" />
                    <Button x:Name="DrawSize3Btn" Text="3mm" MinimumWidthRequest="0" WidthRequest="32" BackgroundColor="#007ACC" TextColor="White" FontSize="10" HeightRequest="26" Padding="0" CornerRadius="5" FontAttributes="Bold" Clicked="OnDrawSizeSelected" CommandParameter="9" />
                    <Button x:Name="DrawSize4Btn" Text="4mm" MinimumWidthRequest="0" WidthRequest="32" BackgroundColor="#333333" TextColor="White" FontSize="10" HeightRequest="26" Padding="0" CornerRadius="5" Clicked="OnDrawSizeSelected" CommandParameter="12" />
                    <Button x:Name="DrawSize5Btn" Text="5mm" MinimumWidthRequest="0" WidthRequest="32" BackgroundColor="#333333" TextColor="White" FontSize="10" HeightRequest="26" Padding="0" CornerRadius="5" Clicked="OnDrawSizeSelected" CommandParameter="15" />
                    <!-- Bouton fermer le panneau -->
                    <Button Text="✕" BackgroundColor="Transparent" TextColor="#AAAAAA" FontSize="14" HeightRequest="26" WidthRequest="22" Padding="0" Clicked="OnCloseDrawOptionsClicked" VerticalOptions="Center" Margin="3,0,0,0" />
                </HorizontalStackLayout>
            </StackLayout>
        </Border>

        <!-- Panneau d'options de Texte (T) -->
        <Border x:Name="TextOptionsOverlay"
                IsVisible="False"
                VerticalOptions="End"
                HorizontalOptions="Center"
                Margin="0,0,0,45"
                BackgroundColor="#EE1E1E24"
                Stroke="#44FFFFFF"
                StrokeThickness="1"
                Padding="8,5"
                ZIndex="25">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <StackLayout x:Name="TextOptionsLayout" Orientation="Horizontal" Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                <!-- Pastilles de couleurs (Noir par défaut, Rouge, Bleu, Vert, Jaune, Blanc) -->
                <HorizontalStackLayout Spacing="5" VerticalOptions="Center" HorizontalOptions="Center">
                    <!-- Noir (défaut) -->
                    <Border x:Name="TextBlackBtn" BackgroundColor="#000000" WidthRequest="22" HeightRequest="22" Stroke="White" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTextColorSelected" CommandParameter="#000000" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Rouge -->
                    <Border x:Name="TextRedBtn" BackgroundColor="#E53935" WidthRequest="22" HeightRequest="22" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTextColorSelected" CommandParameter="#E53935" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Bleu -->
                    <Border x:Name="TextBlueBtn" BackgroundColor="#1E88E5" WidthRequest="22" HeightRequest="22" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTextColorSelected" CommandParameter="#1E88E5" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Vert -->
                    <Border x:Name="TextGreenBtn" BackgroundColor="#43A047" WidthRequest="22" HeightRequest="22" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTextColorSelected" CommandParameter="#43A047" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Jaune -->
                    <Border x:Name="TextYellowBtn" BackgroundColor="#FFD600" WidthRequest="22" HeightRequest="22" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTextColorSelected" CommandParameter="#FFD600" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Blanc -->
                    <Border x:Name="TextWhiteBtn" BackgroundColor="#FFFFFF" WidthRequest="22" HeightRequest="22" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="11" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTextColorSelected" CommandParameter="#FFFFFF" /></Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>

                <!-- Séparateur vertical (visible en paysage) -->
                <BoxView x:Name="TextOptionsSeparator" WidthRequest="1" HeightRequest="20" Color="#44FFFFFF" VerticalOptions="Center" />

                <!-- Choix de taille en pixel (8, 10, 12, 14, 16, 18) + Bouton fermer -->
                <HorizontalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Center">
                    <Button x:Name="TextSize8Btn" Text="8" MinimumWidthRequest="0" WidthRequest="26" BackgroundColor="#333333" TextColor="White" FontSize="10" HeightRequest="26" Padding="0" CornerRadius="5" Clicked="OnTextSizeSelected" CommandParameter="8" />
                    <Button x:Name="TextSize10Btn" Text="10" MinimumWidthRequest="0" WidthRequest="26" BackgroundColor="#333333" TextColor="White" FontSize="10" HeightRequest="26" Padding="0" CornerRadius="5" Clicked="OnTextSizeSelected" CommandParameter="10" />
                    <Button x:Name="TextSize12Btn" Text="12" MinimumWidthRequest="0" WidthRequest="26" BackgroundColor="#333333" TextColor="White" FontSize="10" HeightRequest="26" Padding="0" CornerRadius="5" Clicked="OnTextSizeSelected" CommandParameter="12" />
                    <Button x:Name="TextSize14Btn" Text="14" MinimumWidthRequest="0" WidthRequest="26" BackgroundColor="#007ACC" TextColor="White" FontSize="10" HeightRequest="26" Padding="0" CornerRadius="5" FontAttributes="Bold" Clicked="OnTextSizeSelected" CommandParameter="14" />
                    <Button x:Name="TextSize16Btn" Text="16" MinimumWidthRequest="0" WidthRequest="26" BackgroundColor="#333333" TextColor="White" FontSize="10" HeightRequest="26" Padding="0" CornerRadius="5" Clicked="OnTextSizeSelected" CommandParameter="16" />
                    <Button x:Name="TextSize18Btn" Text="18" MinimumWidthRequest="0" WidthRequest="26" BackgroundColor="#333333" TextColor="White" FontSize="10" HeightRequest="26" Padding="0" CornerRadius="5" Clicked="OnTextSizeSelected" CommandParameter="18" />
                    <!-- Bouton fermer le panneau -->
                    <Button Text="✕" BackgroundColor="Transparent" TextColor="#AAAAAA" FontSize="14" HeightRequest="26" WidthRequest="22" Padding="0" Clicked="OnCloseTextOptionsClicked" VerticalOptions="Center" Margin="3,0,0,0" />
                </HorizontalStackLayout>
            </StackLayout>
        </Border>

        <!-- Barre d'Annotations (Bas) -->
        <Border x:Name="AnnotationBar"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                BackgroundColor="#80000000"
                HeightRequest="45"
                StrokeThickness="0"
                IsVisible="False"
                ZIndex="20">
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnAnnotationBarPanUpdated" />
            </Border.GestureRecognizers>
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" HorizontalOptions="Fill">
                <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto, Auto, Auto, Auto, Auto, Auto" ColumnSpacing="2" Padding="6,0" MinimumWidthRequest="340">
                    <Button Grid.Column="0" x:Name="HighlightBtn" Text="🖌" BackgroundColor="Transparent" TextColor="#FFD700" Clicked="OnAnnotationHighlightClicked" FontSize="18" WidthRequest="34" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" />
                    <Button Grid.Column="1" x:Name="TextAnnotationBtn" Text="T" BackgroundColor="Transparent" TextColor="White" Clicked="OnAnnotationTextClicked" FontSize="16" FontAttributes="Bold" WidthRequest="34" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" />
                    <Button Grid.Column="2" x:Name="DrawBtn" Text="✎" BackgroundColor="Transparent" TextColor="White" Clicked="OnAnnotationDrawClicked" FontSize="16" WidthRequest="34" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" />
                    <Button Grid.Column="3" Text="❏" BackgroundColor="Transparent" TextColor="White" Clicked="OnAnnotationStickersClicked" FontSize="16" WidthRequest="34" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" />
                    
                    <BoxView Grid.Column="4" Color="Transparent" />
                    
                    <!-- Boutons Undo et Redo -->
                    <Button Grid.Column="5" x:Name="UndoBtn" Text="↩" BackgroundColor="Transparent" TextColor="White" Clicked="OnUndoAnnotationClicked" FontSize="18" WidthRequest="34" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" Opacity="0.4" />
                    <Button Grid.Column="6" x:Name="RedoBtn" Text="↪" BackgroundColor="Transparent" TextColor="White" Clicked="OnRedoAnnotationClicked" FontSize="18" WidthRequest="34" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" Opacity="0.4" />

                    <!-- Bouton Reset Nettoyage complet -->
                    <Button Grid.Column="7" Text="✧" BackgroundColor="Transparent" TextColor="White" Clicked="OnResetAnnotationsClicked" FontSize="18" WidthRequest="34" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" />
                    <Button Grid.Column="8" x:Name="LockUnlockBtn" Text="🔒" BackgroundColor="#D32F2F" TextColor="White" Clicked="OnLockUnlockClicked" FontSize="16" Padding="0" WidthRequest="36" HeightRequest="34" CornerRadius="6" VerticalOptions="Center" HorizontalOptions="Center" />
                    <Button Grid.Column="9" Text="🗑" BackgroundColor="Transparent" TextColor="#FF5555" Clicked="OnDeleteSelectedAnnotationClicked" FontSize="16" WidthRequest="34" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" />
                    <Button Grid.Column="10" Text="✕" BackgroundColor="Transparent" TextColor="White" Clicked="OnCloseAnnotationBarClicked" FontSize="18" FontAttributes="Bold" WidthRequest="34" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" />
                </Grid>
            </ScrollView>
        </Border>

        <!-- Indicateur de page (tout en bas, cliquable pour changement de page direct) -->
        <Label x:Name="PageIndicator" 
               IsVisible="False" 
               HorizontalOptions="End" 
               VerticalOptions="End" 
               Margin="0, 0, 10, 5" 
               TextColor="White" 
               BackgroundColor="#80000000" 
               Padding="10,5"
               ZIndex="1000">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnGoToPageClicked" />
            </Label.GestureRecognizers>
        </Label>

        <!-- Modal Aller à la page avec option d'activation/désactivation des numéros de page -->
        <Grid x:Name="GoToPageModal"
              IsVisible="False"
              BackgroundColor="#80000000"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              ZIndex="1100">
            <Border BackgroundColor="#F51E1E24"
                    Stroke="#555555"
                    StrokeThickness="1"
                    WidthRequest="320"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding [Viewer_GoToPage_Title], Source={x:Static services:LocalizationService.Instance}}" 
                           FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                    <Label x:Name="GoToPageSubtitleLabel" Text="Page (1-1) :" TextColor="#AAAAAA" FontSize="13" />
                    <Entry x:Name="GoToPageEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#2D2D35" FontSize="15" HeightRequest="40" HorizontalTextAlignment="Center" />
                    
                    <BoxView HeightRequest="1" Color="#444444" Margin="0,2" />
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="{Binding [Viewer_ShowPageNumber_Label], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="#CCCCCC" FontSize="13" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="GoToPageShowNumberSwitch" OnColor="#007ACC" Scale="0.85" />
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,5,0,0">
                        <Button Grid.Column="0" Text="{Binding [Common_Cancel], Source={x:Static services:LocalizationService.Instance}}" 
                                BackgroundColor="#444444" TextColor="White" CornerRadius="8" HeightRequest="38" Clicked="OnGoToPageCancelClicked" />
                        <Button Grid.Column="1" Text="OK" 
                                BackgroundColor="#007ACC" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Clicked="OnGoToPageOkClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Menu Central Moderne, Compact et Défilable sur Téléphone -->
        <Border x:Name="CentralMenuOverlay" 
                IsVisible="False" 
                BackgroundColor="#F51A1A1A" 
                VerticalOptions="Center" 
                HorizontalOptions="Center" 
                Padding="16,12"
                WidthRequest="320"
                StrokeThickness="1"
                Stroke="#555555"
                ZIndex="1000">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
            <ScrollView x:Name="CentralMenuScrollView" VerticalScrollBarVisibility="Never" Orientation="Vertical">
                <VerticalStackLayout x:Name="CentralMenuContentStack" Spacing="8" Padding="0,2,4,2">
                    <Label x:Name="MenuTitleLabel" FontSize="15" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" Margin="0,0,0,4" />
                    
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Button Grid.Column="0" x:Name="RotateBtn" Text="↻ Rotation (+90°)" 
                                BackgroundColor="#333333" TextColor="White" FontSize="13" CornerRadius="10" HeightRequest="40" Clicked="OnRotateClicked" />
                        <Button Grid.Column="1" Text="📄 Page" 
                                BackgroundColor="#333333" TextColor="White" FontSize="13" CornerRadius="10" HeightRequest="40" Clicked="OnGoToPageClicked" />
                    </Grid>

                    <!-- Rétablir la taille d'origine (Zoom Reset) -->
                    <Button Text="{Binding [Viewer_Menu_ResetZoom], Source={x:Static services:LocalizationService.Instance}}" 
                            BackgroundColor="#2C3E50" 
                            TextColor="White" 
                            FontSize="13" 
                            CornerRadius="10" 
                            HeightRequest="40" 
                            Clicked="OnResetZoomClicked" />

                    <!-- Option de portée de rotation -->
                    <Grid ColumnDefinitions="*, Auto" Margin="5,0">
                        <Label x:Name="RotationScopeLabel" Text="{Binding [Viewer_Rotate_Page_Only], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="12" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="RotateAllPagesSwitch" OnColor="#007ACC" Scale="0.8" Toggled="OnRotateAllPagesToggled" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" Margin="5,0">
                        <Label Text="{Binding [Viewer_Remember_Rotation], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="SaveRotationSwitch" OnColor="#007ACC" Scale="0.8" Toggled="OnSaveRotationToggled" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#444444" Margin="0,5" />

                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6" Margin="5,0">
                        <Label Grid.Column="0" Text="{Binding [Viewer_Menu_ShowMetronome], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center" />
                        <Button Grid.Column="1" 
                                Text="⚙️" 
                                BackgroundColor="Transparent" 
                                Padding="0" 
                                WidthRequest="32" 
                                HeightRequest="32" 
                                FontSize="14" 
                                VerticalOptions="Center"
                                Clicked="OnMetronomeSettingsButtonClicked" />
                        <Switch Grid.Column="2" x:Name="MenuMetronomeSwitch" OnColor="#007ACC" Scale="0.8" VerticalOptions="Center" Toggled="OnMenuMetronomeToggled" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" Margin="5,0">
                        <Label Text="{Binding [Viewer_Menu_ShowAudio], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="MenuAudioSwitch" OnColor="#007ACC" Scale="0.8" Toggled="OnMenuAudioToggled" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" Margin="5,0">
                        <Label Text="{Binding [Viewer_Menu_ShowAnnotations], Source={x:Static services:LocalizationService.Instance}}" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="MenuAnnotationsSwitch" OnColor="#007ACC" Scale="0.8" Toggled="OnMenuAnnotationsToggled" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#444444" Margin="0,5" />

                    <Button x:Name="MenuModifyAssemblyButton"
                            Text="{Binding [Viewer_Menu_ModifyAssembly], Source={x:Static services:LocalizationService.Instance}}" 
                            BackgroundColor="#2C3E50" 
                            TextColor="White" 
                            FontSize="13" 
                            CornerRadius="10" 
                            HeightRequest="40"
                            Clicked="OnMenuModifyAssemblyClicked" />

                    <Button Text="{Binding [Viewer_Edit_Score], Source={x:Static services:LocalizationService.Instance}}" 
                            BackgroundColor="#007ACC" TextColor="White" 
                            FontAttributes="Bold" CornerRadius="10" HeightRequest="45"
                            Clicked="OnEditScoreClicked" />

                    <Button Text="{Binding [Viewer_Home], Source={x:Static services:LocalizationService.Instance}}" 
                            BackgroundColor="#E74C3C" TextColor="White" 
                            FontAttributes="Bold" CornerRadius="10" HeightRequest="45"
                            Clicked="OnBackClicked" />
                    
                    <Button Text="{Binding [Common_Close], Source={x:Static services:LocalizationService.Instance}}" 
                            BackgroundColor="Transparent" TextColor="#AAAAAA" 
                            FontSize="13" HeightRequest="35"
                            Clicked="OnCloseMenuClicked" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Zone tactile transparente du haut au centre pour ouvrir le déroulement de la setlist -->
        <ContentView x:Name="TopSetlistTouchBar"
                     VerticalOptions="Start"
                     HorizontalOptions="Center"
                     HeightRequest="60"
                     WidthRequest="350"
                     BackgroundColor="Transparent"
                     ZIndex="500"
                     IsVisible="False">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTopSetlistTouchTapped" />
            </ContentView.GestureRecognizers>
        </ContentView>

        <!-- Volet Déroulement de la Setlist (Haut de l'écran) -->
        <Grid x:Name="SetlistProgressModal"
              IsVisible="False"
              ZIndex="999"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <!-- Arrière-plan semi-transparent pour fermer en cliquant à côté -->
            <BoxView BackgroundColor="#70000000"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseSetlistProgressClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Boîte de déroulement de la setlist fixée en haut -->
            <Border x:Name="SetlistProgressOverlay"
                    VerticalOptions="Start"
                    HorizontalOptions="Center"
                    WidthRequest="480"
                    MaximumHeightRequest="420"
                    Margin="15,0,15,0"
                    Padding="16,14,16,16"
                    BackgroundColor="#F4181820"
                    Stroke="#007ACC"
                    StrokeThickness="1.5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,18,18" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,6" Radius="15" Opacity="0.75" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto, 1, *" RowSpacing="10">
                    <!-- Entête du déroulement -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="📋" FontSize="18" VerticalOptions="Center" />
                            <Label Text="Déroulement de la setlist" 
                                   TextColor="White" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Grid.Column="1" 
                               x:Name="SetlistProgressCounterLabel"
                               Text="1 / 5" 
                               TextColor="#00B4D8" 
                               FontAttributes="Bold" 
                               FontSize="13" 
                               HorizontalOptions="End" 
                               VerticalOptions="Center"
                               Margin="0,0,12,0" />

                        <Button Grid.Column="2" 
                                Text="✕" 
                                BackgroundColor="#33FFFFFF" 
                                TextColor="White" 
                                FontSize="14" 
                                FontAttributes="Bold"
                                WidthRequest="32" 
                                HeightRequest="32" 
                                CornerRadius="16"
                                Padding="0"
                                VerticalOptions="Center"
                                Clicked="OnCloseSetlistProgressClicked" />
                    </Grid>

                    <!-- Séparateur -->
                    <BoxView Grid.Row="1" HeightRequest="1" Color="#334466" />

                    <!-- Liste déroulante des partitions de la setlist -->
                    <ScrollView x:Name="SetlistProgressScrollView" Grid.Row="2" Orientation="Vertical">
                        <VerticalStackLayout x:Name="SetlistProgressStack" Spacing="6" />
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>

        <!-- Modale Moderne des Paramètres du Métronome -->
        <Grid x:Name="MetronomeSettingsModal"
              IsVisible="False"
              ZIndex="1000"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <!-- Arrière-plan semi-transparent -->
            <BoxView BackgroundColor="#80000000"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseMetronomeSettingsModalClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Boîte de dialogue moderne et épurée -->
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="390"
                    MaximumWidthRequest="430"
                    Margin="20"
                    Padding="20"
                    BackgroundColor="#1C2331"
                    Stroke="#007ACC"
                    StrokeThickness="1.5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,10" Radius="25" Opacity="0.85" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <!-- Entête : Titre & Bouton Fermer -->
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="⏱️" FontSize="22" VerticalOptions="Center" Margin="0,0,8,0" />
                        <Label Grid.Column="1" 
                               Text="Paramètres du Métronome" 
                               TextColor="White" 
                               FontAttributes="Bold" 
                               FontSize="17" 
                               VerticalOptions="Center" />
                        <Button Grid.Column="2" 
                                Text="✕" 
                                BackgroundColor="#2D3748" 
                                TextColor="#CBD5E0" 
                                FontSize="13" 
                                FontAttributes="Bold"
                                WidthRequest="32" 
                                HeightRequest="32" 
                                CornerRadius="16"
                                Padding="0"
                                VerticalOptions="Center"
                                Clicked="OnCloseMetronomeSettingsModalClicked" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#2D3748" />

                    <!-- Section TEMPO (BPM) -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="TEMPO (BPM)" TextColor="#90CDF4" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                        
                        <!-- Badge BPM dynamique & Tap Tempo -->
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <Border BackgroundColor="#0F172A" Stroke="#334155" StrokeThickness="1" Padding="12,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label x:Name="ModalMetronomeBpmLabel" 
                                       Text="120 BPM" 
                                       TextColor="#00B0FF" 
                                       FontSize="24" 
                                       FontAttributes="Bold" 
                                       HorizontalTextAlignment="Center" 
                                       VerticalTextAlignment="Center" />
                            </Border>

                            <Button Grid.Column="1" 
                                    x:Name="ModalTapTempoButton"
                                    Text="👆 Tap Tempo" 
                                    BackgroundColor="#2563EB" 
                                    TextColor="White" 
                                    FontAttributes="Bold" 
                                    FontSize="12" 
                                    HeightRequest="44"
                                    Padding="14,0"
                                    CornerRadius="10"
                                    Clicked="OnModalTapTempoClicked" />
                        </Grid>

                        <!-- Boutons d'ajustement rapide -->
                        <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="- 5" BackgroundColor="#2D3748" TextColor="White" FontAttributes="Bold" FontSize="12" HeightRequest="36" CornerRadius="8" Padding="0" Clicked="OnModalBpmMinus5Clicked" />
                            <Button Grid.Column="1" Text="- 1" BackgroundColor="#2D3748" TextColor="White" FontAttributes="Bold" FontSize="12" HeightRequest="36" CornerRadius="8" Padding="0" Clicked="OnModalBpmMinus1Clicked" />
                            <Button Grid.Column="2" Text="+ 1" BackgroundColor="#2D3748" TextColor="White" FontAttributes="Bold" FontSize="12" HeightRequest="36" CornerRadius="8" Padding="0" Clicked="OnModalBpmPlus1Clicked" />
                            <Button Grid.Column="3" Text="+ 5" BackgroundColor="#2D3748" TextColor="White" FontAttributes="Bold" FontSize="12" HeightRequest="36" CornerRadius="8" Padding="0" Clicked="OnModalBpmPlus5Clicked" />
                        </Grid>

                        <!-- Slider continu -->
                        <Slider x:Name="ModalMetronomeBpmSlider"
                                Minimum="40" 
                                Maximum="250" 
                                Value="120"
                                MinimumTrackColor="#007ACC" 
                                MaximumTrackColor="#334155" 
                                ThumbColor="#00B0FF"
                                ValueChanged="OnModalBpmSliderValueChanged" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#2D3748" />

                    <!-- Section SON & VOLUME -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="SON &amp; VOLUME" TextColor="#90CDF4" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                        
                        <!-- Toggle Son activé -->
                        <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                            <Label Text="🔊" FontSize="18" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Label Grid.Column="1" Text="Son du métronome" TextColor="White" FontSize="14" VerticalOptions="Center" />
                            <Switch Grid.Column="2" 
                                    x:Name="ModalMetronomeSoundSwitch" 
                                    OnColor="#007ACC" 
                                    ThumbColor="White" 
                                    Toggled="OnModalMetronomeSoundToggled" />
                        </Grid>

                        <!-- Contrôle du Volume -->
                        <VerticalStackLayout x:Name="ModalVolumeLayout" Spacing="6">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Grid.Column="0" Text="🔈" FontSize="14" TextColor="#A0AEC0" VerticalOptions="Center" Margin="0,0,6,0" />
                                <Label Grid.Column="1" Text="Volume sonore" TextColor="#CBD5E0" FontSize="13" VerticalOptions="Center" />
                                <Label Grid.Column="2" x:Name="ModalVolumeLabel" Text="100%" TextColor="#00B0FF" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                            </Grid>
                            
                            <Slider x:Name="ModalMetronomeVolumeSlider"
                                    Minimum="5"
                                    Maximum="100"
                                    Value="100"
                                    MinimumTrackColor="#007ACC"
                                    MaximumTrackColor="#334155"
                                    ThumbColor="#00B0FF"
                                    ValueChanged="OnModalVolumeSliderValueChanged"
                                    DragCompleted="OnModalVolumeSliderDragCompleted" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#2D3748" />

                    <!-- Section AFFICHAGE VISUEL -->
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                        <Label Text="💡" FontSize="18" VerticalOptions="Center" Margin="0,0,8,0" />
                        <Label Grid.Column="1" Text="Afficher le métronome visuel (LED)" TextColor="White" FontSize="14" VerticalOptions="Center" />
                        <Switch Grid.Column="2" 
                                x:Name="ModalMetronomeVisualSwitch" 
                                OnColor="#007ACC" 
                                ThumbColor="White" 
                                Toggled="OnModalMetronomeVisualToggled" />
                    </Grid>

                    <!-- Bouton Valider / Fermer -->
                    <Button Text="Terminer" 
                            BackgroundColor="#007ACC" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            FontSize="14" 
                            HeightRequest="44" 
                            CornerRadius="10" 
                            Margin="0,4,0,0"
                            Clicked="OnCloseMetronomeSettingsModalClicked" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Zone tactile transparente du bas pour activer les annotations (PDF & Images, même zoomés) -->
        <ContentView x:Name="BottomTouchBar"
                     VerticalOptions="End"
                     HeightRequest="80"
                     BackgroundColor="Transparent"
                     ZIndex="500">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAnnotationToggleTapped" />
            </ContentView.GestureRecognizers>
        </ContentView>
    </Grid>
</ContentPage>
