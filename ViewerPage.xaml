<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicScoreManager.ViewerPage"
             BackgroundColor="#000000"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid BackgroundColor="Black">
        <!-- L'image avec zoom (ScrollView) -->
        <ScrollView x:Name="ImageScrollView" 
                    IsVisible="False" 
                    Orientation="Both"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
            <Image x:Name="ScoreImage" 
                   Aspect="AspectFit" 
                   HorizontalOptions="Fill" 
                   VerticalOptions="Fill">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCenterTapped" />
                </Image.GestureRecognizers>
            </Image>
        </ScrollView>

        <!-- Le PDF -->
        <WebView x:Name="PdfWebView" 
                 IsVisible="False" 
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"
                 Navigated="OnPdfWebViewNavigated"
                 Navigating="OnPdfWebViewNavigating" />

        <!-- Indicateur de page -->
        <Label x:Name="PageIndicator" 
               IsVisible="False" 
               HorizontalOptions="End" 
               VerticalOptions="End" 
               Margin="20" 
               TextColor="White" 
               BackgroundColor="#80000000" 
               Padding="10,5" />

        <!-- Menu Central -->
        <Border x:Name="CentralMenuOverlay" 
                IsVisible="False" 
                BackgroundColor="#CC000000" 
                VerticalOptions="Center" 
                HorizontalOptions="Center" 
                Padding="30"
                WidthRequest="300">
            <VerticalStackLayout Spacing="15">
                <!-- Bandeau Header avec bouton Exit -->
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0">
                        <Label x:Name="MenuTitleLabel" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Start" />
                        <Label x:Name="MenuTypeLabel" FontSize="14" TextColor="LightGray" HorizontalTextAlignment="Start" />
                    </VerticalStackLayout>
                    
                    <Button Grid.Column="1" 
                            Text="✕" 
                            TextColor="White"
                            BackgroundColor="#CC0000"
                            FontAttributes="Bold"
                            FontSize="18"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="20"
                            Padding="0"
                            VerticalOptions="Start"
                            HorizontalOptions="End"
                            Clicked="OnExitApplicationClicked" />
                </Grid>

                <Button Text="Rotation 90°" Clicked="OnRotateClicked" />
                <Button Text="Retour à l'accueil" BackgroundColor="#C0392B" TextColor="White" Clicked="OnBackClicked" />
                <Button Text="Masquer Menu" Clicked="OnCloseMenuClicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
