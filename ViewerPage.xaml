<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MusicScoreManager.ViewerPage"
             BackgroundColor="#000000"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid BackgroundColor="Black">
        <!-- MediaElement pour la lecture audio et les bips -->
        <toolkit:MediaElement x:Name="AudioPlayer" IsVisible="False" />

        <!-- L'image avec zoom (ScrollView) -->
        <ScrollView x:Name="ImageScrollView" 
                    IsVisible="False" 
                    Orientation="Both"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
            <Image x:Name="ScoreImage" 
                   Aspect="AspectFit" 
                   HorizontalOptions="Fill" 
                   VerticalOptions="Fill" />
        </ScrollView>

        <!-- Zones tactiles pour les images (transparentes) -->
        <Grid x:Name="ImageTouchGrid" IsVisible="False" BackgroundColor="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <ContentView Grid.Column="0" BackgroundColor="Transparent">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPrevTapped" />
                </ContentView.GestureRecognizers>
            </ContentView>
            <Grid Grid.Column="1" RowDefinitions="*, Auto">
                <ContentView Grid.Row="0" BackgroundColor="Transparent">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCenterTapped" NumberOfTapsRequired="2" />
                        <TapGestureRecognizer Tapped="OnCenterSingleTapped" NumberOfTapsRequired="1" />
                    </ContentView.GestureRecognizers>
                </ContentView>
                <ContentView Grid.Row="1" BackgroundColor="Transparent" HeightRequest="100">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAnnotationToggleTapped" />
                    </ContentView.GestureRecognizers>
                </ContentView>
            </Grid>
            <ContentView Grid.Column="2" BackgroundColor="Transparent">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNextTapped" />
                </ContentView.GestureRecognizers>
            </ContentView>
        </Grid>

        <!-- Le PDF -->
        <WebView x:Name="PdfWebView" 
                 IsVisible="False" 
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"
                 Navigated="OnPdfWebViewNavigated"
                 Navigating="OnPdfWebViewNavigating" />

        <!-- Overlay MÉTRONOME (Haut-Droite) -->
        <Border x:Name="MetronomeOverlay" 
                IsVisible="False"
                HorizontalOptions="End" 
                VerticalOptions="Start" 
                Margin="10,5,10,0" 
                Padding="10,5"
                BackgroundColor="#80000000"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMetronomeOverlayTapped" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label x:Name="MetronomeBpmLabel" Text="120 BPM" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <BoxView x:Name="MetronomeLight" WidthRequest="20" HeightRequest="20" Color="#333333" CornerRadius="10" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- Overlay LECTEUR AUDIO (Haut) -->
        <Border x:Name="AudioPlayerOverlay" 
                IsVisible="False"
                VerticalOptions="Start" 
                HorizontalOptions="Fill"
                Margin="80,5,130,0" 
                Padding="10,0"
                BackgroundColor="#CC1E1E1E"
                StrokeThickness="1"
                Stroke="#444444"
                HeightRequest="45">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Button Grid.Column="0" Text="⏮" BackgroundColor="Transparent" TextColor="White" FontSize="16" Padding="0" Clicked="OnAudioToStartClicked" />
                <Button Grid.Column="1" x:Name="AudioPlayBtn" Text="▶" BackgroundColor="Transparent" TextColor="White" FontSize="20" Padding="0" Clicked="OnAudioPlayPauseClicked" />
                <Button Grid.Column="2" Text="⏭" BackgroundColor="Transparent" TextColor="White" FontSize="16" Padding="0" Clicked="OnAudioToEndClicked" />
                
                <Label Grid.Column="3" x:Name="AudioCurrentTimeLabel" Text="0:00" TextColor="White" FontSize="12" VerticalOptions="Center" />
                <Slider Grid.Column="4" x:Name="AudioSlider" MinimumTrackColor="#007ACC" MaximumTrackColor="#555555" ThumbColor="White" DragStarted="OnAudioSliderDragStarted" DragCompleted="OnAudioSliderDragCompleted" ValueChanged="OnAudioSliderValueChanged" VerticalOptions="Center" />
                <Label Grid.Column="5" x:Name="AudioTotalTimeLabel" Text="0:00" TextColor="White" FontSize="12" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Conteneur pour les Annotations (Stickers, etc.) -->
        <AbsoluteLayout x:Name="AnnotationsContainer" 
                        HorizontalOptions="Fill" 
                        VerticalOptions="Fill" 
                        ZIndex="10"
                        InputTransparent="False">
            <AbsoluteLayout.GestureRecognizers>
                <DropGestureRecognizer Drop="OnStickerDrop" AllowDrop="True" />
            </AbsoluteLayout.GestureRecognizers>
        </AbsoluteLayout>

        <!-- Barre de réglages Stickers (Couleur, Taille) -->
        <Border x:Name="StickerSettingsBar"
                IsVisible="False"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                BackgroundColor="#EE1E1E1E"
                HeightRequest="40"
                Margin="10,0,10,225" 
                Padding="10,0"
                StrokeThickness="1"
                Stroke="#444444"
                ZIndex="25">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                <Label Grid.Column="0" Text="Couleur:" TextColor="White" VerticalOptions="Center" Margin="0,0,10,0" />
                <HorizontalStackLayout Grid.Column="1" Spacing="15" VerticalOptions="Center">
                    <Ellipse WidthRequest="22" HeightRequest="22" Fill="White" Stroke="Gray" StrokeThickness="1">
                        <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerColorTapped" CommandParameter="White"/></Ellipse.GestureRecognizers>
                    </Ellipse>
                    <Ellipse WidthRequest="22" HeightRequest="22" Fill="Black" Stroke="Gray" StrokeThickness="1">
                        <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerColorTapped" CommandParameter="Black"/></Ellipse.GestureRecognizers>
                    </Ellipse>
                    <Ellipse WidthRequest="22" HeightRequest="22" Fill="Red">
                        <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerColorTapped" CommandParameter="Red"/></Ellipse.GestureRecognizers>
                    </Ellipse>
                    <Ellipse WidthRequest="22" HeightRequest="22" Fill="#007ACC">
                        <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerColorTapped" CommandParameter="Blue"/></Ellipse.GestureRecognizers>
                    </Ellipse>
                </HorizontalStackLayout>
                
                <Label Grid.Column="2" Text="Taille:" TextColor="White" VerticalOptions="Center" Margin="20,0,10,0" />
                <Slider Grid.Column="3" x:Name="StickerSizeSlider" Minimum="0.5" Maximum="4.0" Value="1.2" WidthRequest="150" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Sélecteur de Stickers (S'affiche au-dessus de la barre) -->
        <Border x:Name="StickerPickerOverlay"
                IsVisible="False"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                BackgroundColor="#EE000000"
                HeightRequest="150"
                Margin="10,0,10,70"
                Padding="10"
                StrokeThickness="1"
                Stroke="#444444">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            
            <VerticalStackLayout Spacing="5">
                <!-- Catégories -->
                <CollectionView x:Name="StickerCategoriesCollection"
                                HeightRequest="40"
                                SelectionMode="Single"
                                SelectionChanged="OnStickerCategoryChanged">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 4" Padding="0" BackgroundColor="#2C2C2C">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#007ACC" />
                                                <Setter TargetName="CatLabel" Property="TextColor" Value="White" />
                                                <Setter TargetName="CatLabel" Property="FontAttributes" Value="Bold" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Label x:Name="CatLabel" 
                                       Text="{Binding Name}" 
                                       TextColor="#BBBBBB" 
                                       FontSize="13" 
                                       VerticalTextAlignment="Center"
                                       Padding="12,5" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="1" Color="#444444" />

                <!-- Stickers de la catégorie -->
                <CollectionView x:Name="StickersCollection" 
                                HeightRequest="85"
                                SelectionMode="None"
                                HorizontalScrollBarVisibility="Always">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border HeightRequest="60" 
                                    Margin="5" BackgroundColor="#404040" 
                                    Padding="10,0"
                                    StrokeShape="RoundRectangle 8">
                                <Border.GestureRecognizers>
                                    <DragGestureRecognizer DragStarting="OnStickerDragStarting" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding .}" 
                                       TextColor="White" 
                                       FontSize="22" 
                                       LineBreakMode="NoWrap"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- Barre d'Annotations (Bas) -->
        <Border x:Name="AnnotationBar"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                BackgroundColor="#80000000"
                HeightRequest="45"
                StrokeThickness="0"
                IsVisible="False"
                ZIndex="20">
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnAnnotationBarPanUpdated" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto" Padding="10,0">
                <Button Grid.Column="0" Text="Texte" BackgroundColor="Transparent" TextColor="White" Clicked="OnAnnotationTextClicked" />
                <Button Grid.Column="1" Text="Dessin" BackgroundColor="Transparent" TextColor="White" Clicked="OnAnnotationDrawClicked" />
                <Button Grid.Column="2" Text="Stickers" BackgroundColor="Transparent" TextColor="White" Clicked="OnAnnotationStickersClicked" />
                <!-- Espace -->
                <BoxView Grid.Column="3" Color="Transparent" />
                <!-- Bouton Supprimer -->
                <Button Grid.Column="4" Text="Supprimer" BackgroundColor="#CCFF0000" TextColor="White" Clicked="OnDeleteSelectedAnnotationClicked" FontAttributes="Bold" />
            </Grid>
        </Border>

        <!-- Indicateur de page (tout en bas) -->
        <Label x:Name="PageIndicator" 
               IsVisible="False" 
               HorizontalOptions="End" 
               VerticalOptions="End" 
               Margin="0, 0, 10, 5" 
               TextColor="White" 
               BackgroundColor="#80000000" 
               Padding="10,5" />

        <!-- Menu Central -->
        <Border x:Name="CentralMenuOverlay" 
                IsVisible="False" 
                BackgroundColor="#CC000000" 
                VerticalOptions="Center" 
                HorizontalOptions="Center" 
                Padding="30"
                WidthRequest="350">
            <VerticalStackLayout Spacing="15">
                <Label x:Name="MenuTitleLabel" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Button x:Name="RotateBtn" Text="Rotation" BackgroundColor="#333333" TextColor="White" Clicked="OnRotateClicked" />
                    <Button Text="Aller à la page" BackgroundColor="#333333" TextColor="White" Clicked="OnGoToPageClicked" />
                </HorizontalStackLayout>

                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Mémoriser la rotation" TextColor="White" VerticalOptions="Center" />
                    <Switch Grid.Column="1" x:Name="SaveRotationSwitch" OnColor="#007ACC" Toggled="OnSaveRotationToggled" />
                </Grid>

                <BoxView HeightRequest="1" Color="#444444" />

                <!-- Toggles pour les nouvelles fonctions -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Afficher Métronome" TextColor="White" VerticalOptions="Center" />
                    <Switch Grid.Column="1" x:Name="MenuMetronomeSwitch" OnColor="#007ACC" Toggled="OnMenuMetronomeToggled" />
                </Grid>

                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Afficher Lecteur Audio" TextColor="White" VerticalOptions="Center" />
                    <Switch Grid.Column="1" x:Name="MenuAudioSwitch" OnColor="#007ACC" Toggled="OnMenuAudioToggled" />
                </Grid>

                <BoxView HeightRequest="1" Color="#444444" />

                <Button Text="Retour à l'accueil" BackgroundColor="#C0392B" TextColor="White" Clicked="OnBackClicked" />
                <Button Text="Fermer" BackgroundColor="#333333" TextColor="White" Clicked="OnCloseMenuClicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
