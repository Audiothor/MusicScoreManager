<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicScoreManager.ViewerPage"
             BackgroundColor="#000000"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Vue pour Image avec Pinch-to-Zoom basique -->
        <ScrollView x:Name="ImageScrollView" IsVisible="False">
            <Grid>
                <Image x:Name="ScoreImage" Aspect="AspectFit">
                    <Image.GestureRecognizers>
                        <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                        <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </ScrollView>

        <!-- Vue pour PDF -->
        <WebView x:Name="PdfWebView" IsVisible="False" Navigated="OnPdfWebViewNavigated" Navigating="OnPdfWebViewNavigating" />

        <!-- Zones de clics pour Images (Puisque PDF gère en JS) -->
        <Grid x:Name="ImageTouchGrid" IsVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="8*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <BoxView Grid.Row="0" Grid.Column="0" Color="Transparent" Tapped="OnPrevTapped">
                <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnPrevTapped"/></BoxView.GestureRecognizers>
            </BoxView>
            <BoxView Grid.Row="0" Grid.Column="1" Color="Transparent">
                <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCenterTapped"/></BoxView.GestureRecognizers>
            </BoxView>
            <BoxView Grid.Row="0" Grid.Column="2" Color="Transparent">
                <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnNextTapped"/></BoxView.GestureRecognizers>
            </BoxView>
            <BoxView Grid.Row="1" Grid.ColumnSpan="3" Color="Transparent">
                <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnBottomTapped"/></BoxView.GestureRecognizers>
            </BoxView>
        </Grid>

        <!-- Indicateur de page (xx/yy) -->
        <Label x:Name="PageIndicator" 
               IsVisible="False"
               HorizontalOptions="End" 
               VerticalOptions="End" 
               Margin="20"
               TextColor="White" 
               BackgroundColor="#80000000"
               Padding="10,5" />

        <!-- Menu Central Overlay -->
        <Border x:Name="CentralMenuOverlay"
                IsVisible="False"
                BackgroundColor="#CC000000"
                StrokeThickness="0"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Padding="30"
                WidthRequest="300">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="15">
                <Label x:Name="MenuTitleLabel" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" />
                <Label x:Name="MenuTypeLabel" 
                       FontSize="14" 
                       TextColor="LightGray" 
                       HorizontalTextAlignment="Center" />
                
                <BoxView HeightRequest="1" Color="#444444" Margin="0,5" />

                <Button Text="Rotation 90°" 
                        BackgroundColor="#333333"
                        TextColor="White"
                        Clicked="OnRotateClicked" />

                <Button Text="Aller à la page..." 
                        BackgroundColor="#333333"
                        TextColor="White"
                        Clicked="OnGoToPageClicked" />

                <Button Text="Retour à l'accueil" 
                        BackgroundColor="#C0392B"
                        TextColor="White"
                        FontAttributes="Bold"
                        Clicked="OnBackClicked" />

                <Button Text="Fermer" 
                        BackgroundColor="Transparent"
                        TextColor="Gray"
                        Clicked="OnCloseMenuClicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
