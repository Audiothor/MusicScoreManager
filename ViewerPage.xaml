<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:conv="clr-namespace:MusicScoreManager.Converters"
             x:Class="MusicScoreManager.ViewerPage"
             BackgroundColor="#000000"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:ScaleToFontSizeConverter x:Key="ScaleToFontSizeConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="Black">
        <!-- MediaElement pour la lecture audio et les bips -->
        <toolkit:MediaElement x:Name="AudioPlayer" IsVisible="False" />

        <!-- L'affichage de partition avec zoom unifié (PDF & Image) -->
        <Grid x:Name="ImageContainer" 
              HorizontalOptions="Fill" 
              VerticalOptions="Fill" 
              BackgroundColor="Black">
            <Grid.GestureRecognizers>
                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                <TapGestureRecognizer Tapped="OnImageSingleTapped" NumberOfTapsRequired="1" />
                <TapGestureRecognizer Tapped="OnImageDoubleTapped" NumberOfTapsRequired="2" />
                <SwipeGestureRecognizer Direction="Left" Swiped="OnImageSwipedLeft" />
                <SwipeGestureRecognizer Direction="Right" Swiped="OnImageSwipedRight" />
                <SwipeGestureRecognizer Direction="Up" Swiped="OnImageSwipedUp" />
                <SwipeGestureRecognizer Direction="Down" Swiped="OnImageSwipedDown" />
            </Grid.GestureRecognizers>
            
            <Grid x:Name="ZoomLayout"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill">

                <!-- Le PDF -->
                <WebView x:Name="PdfWebView" 
                         IsVisible="False" 
                         BackgroundColor="Black"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill"
                         Navigated="OnPdfWebViewNavigated"
                         Navigating="OnPdfWebViewNavigating" />

                <!-- L'image -->
                <Image x:Name="ScoreImage" 
                       IsVisible="False"
                       Aspect="AspectFit" 
                       HorizontalOptions="Fill" 
                       VerticalOptions="Fill"
                       BackgroundColor="White"
                       InputTransparent="True" />

                <!-- Conteneur d'annotations unifié (qui zoom, dézoome et se déplace parfaitement avec le PDF ou l'Image) -->
                <AbsoluteLayout x:Name="AnnotationsContainer" 
                                HorizontalOptions="Fill" 
                                VerticalOptions="Fill" 
                                ZIndex="10"
                                Opacity="0"
                                InputTransparent="True"
                                CascadeInputTransparent="False">
                    <AbsoluteLayout.GestureRecognizers>
                        <DropGestureRecognizer Drop="OnStickerDrop" AllowDrop="True" />
                        <TapGestureRecognizer Tapped="OnPlacementTapped" />
                        <PointerGestureRecognizer PointerPressed="OnHighlightPointerPressed" 
                                                  PointerMoved="OnHighlightPointerMoved" 
                                                  PointerReleased="OnHighlightPointerReleased" />
                    </AbsoluteLayout.GestureRecognizers>
                </AbsoluteLayout>
            </Grid>
        </Grid>

        <!-- Overlay MÉTRONOME (Haut-Droite) -->
        <Border x:Name="MetronomeOverlay" 
                IsVisible="False"
                HorizontalOptions="End" 
                VerticalOptions="Start" 
                Margin="10,5,10,0" 
                Padding="10,5"
                BackgroundColor="#80000000"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMetronomeOverlayTapped" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label x:Name="MetronomeBpmLabel" Text="120 BPM" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <BoxView x:Name="MetronomeLight" WidthRequest="20" HeightRequest="20" Color="#333333" CornerRadius="10" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- Overlay LECTEUR AUDIO Flottant & Amovible (Haut Gauche - Opposé du métronome) -->
        <Border x:Name="AudioPlayerOverlay" 
                IsVisible="False"
                VerticalOptions="Start" 
                HorizontalOptions="Start"
                Margin="10,5,0,0" 
                Padding="8,6"
                BackgroundColor="#EE1E1E1E"
                StrokeThickness="1"
                Stroke="#444444"
                WidthRequest="265"
                ZIndex="20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnAudioPlayerPanUpdated" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="3">
                <!-- Entête : Poignée de déplacement, Titre / Nom du morceau, Fermer -->
                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                    <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                        <Label Text="⠿" TextColor="#888888" FontSize="13" VerticalOptions="Center" />
                        <Label Text="🎵" FontSize="11" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Grid.Column="1" x:Name="AudioTrackNameLabel" Text="Audio" TextColor="#CCCCCC" FontSize="11" FontAttributes="Bold" LineBreakMode="TailTruncation" VerticalOptions="Center" Margin="4,0" />
                    <Button Grid.Column="2" Text="✕" TextColor="#888888" BackgroundColor="Transparent" FontSize="11" Padding="0" WidthRequest="22" HeightRequest="22" Clicked="OnAudioCloseClicked" />
                </Grid>

                <!-- Boutons de commande : Stop/Début, Reculer, Play/Pause, Avancer -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="5" HorizontalOptions="Fill">
                    <!-- Stop / Retour début -->
                    <Button Grid.Column="0" 
                            Text="⏮" 
                            ToolTipProperties.Text="Stop / Début"
                            BackgroundColor="#2D2D35" 
                            TextColor="White" 
                            FontSize="15" 
                            HeightRequest="32" 
                            Padding="0" 
                            CornerRadius="6"
                            Clicked="OnAudioToStartClicked" />

                    <!-- Reculer (-5s) -->
                    <Button Grid.Column="1" 
                            Text="⏪" 
                            ToolTipProperties.Text="Reculer de 5s"
                            BackgroundColor="#2D2D35" 
                            TextColor="White" 
                            FontSize="15" 
                            HeightRequest="32" 
                            Padding="0" 
                            CornerRadius="6"
                            Clicked="OnAudioRewindClicked" />

                    <!-- Play / Pause -->
                    <Button Grid.Column="2" 
                            x:Name="AudioPlayBtn" 
                            Text="▶" 
                            ToolTipProperties.Text="Lecture / Pause"
                            BackgroundColor="#007ACC" 
                            TextColor="White" 
                            FontSize="16" 
                            FontAttributes="Bold"
                            HeightRequest="32" 
                            Padding="0" 
                            CornerRadius="6"
                            Clicked="OnAudioPlayPauseClicked" />

                    <!-- Avancer (+5s) -->
                    <Button Grid.Column="3" 
                            Text="⏩" 
                            ToolTipProperties.Text="Avancer de 5s"
                            BackgroundColor="#2D2D35" 
                            TextColor="White" 
                            FontSize="15" 
                            HeightRequest="32" 
                            Padding="0" 
                            CornerRadius="6"
                            Clicked="OnAudioForwardClicked" />
                </Grid>

                <!-- Barre de déplacement dans le son (Slider) et durée -->
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="6" VerticalOptions="Center" Margin="0,1,0,0">
                    <Label Grid.Column="0" x:Name="AudioCurrentTimeLabel" Text="0:00" TextColor="#AAAAAA" FontSize="10" VerticalOptions="Center" />
                    <Slider Grid.Column="1" x:Name="AudioSlider" 
                            MinimumTrackColor="#007ACC" 
                            MaximumTrackColor="#555555" 
                            ThumbColor="White" 
                            HeightRequest="24"
                            DragStarted="OnAudioSliderDragStarted" 
                            DragCompleted="OnAudioSliderDragCompleted" 
                            ValueChanged="OnAudioSliderValueChanged" 
                            VerticalOptions="Center" />
                    <Label Grid.Column="2" x:Name="AudioTotalTimeLabel" Text="0:00" TextColor="#AAAAAA" FontSize="10" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Sélecteur de Stickers et Réglages (Drawer Unique) -->
        <Border x:Name="StickerPickerOverlay"
                IsVisible="False"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                BackgroundColor="#EE000000"
                HeightRequest="270"
                Margin="10,0,10,45"
                Padding="10"
                StrokeThickness="1"
                Stroke="#444444"
                ZIndex="25">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            
            <VerticalStackLayout Spacing="8">
                <!-- Réglages Stickers Fusionnés -->
                <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="8" Margin="0,0,0,5">
                    <!-- Header : Titre et Bouton Fermer -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Réglages des stickers" TextColor="#AAAAAA" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="✕" TextColor="#FF5555" BackgroundColor="Transparent" FontSize="18" FontAttributes="Bold" Padding="0" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" HorizontalOptions="Center" Clicked="OnCloseStickerPickerClicked" />
                    </Grid>

                    <!-- Ligne 1: Couleurs Texte et Fond -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Texte:" TextColor="White" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                            <Ellipse WidthRequest="22" HeightRequest="22" Fill="White" Stroke="Gray" StrokeThickness="1">
                                <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerColorTapped" CommandParameter="White"/></Ellipse.GestureRecognizers>
                            </Ellipse>
                            <Ellipse WidthRequest="22" HeightRequest="22" Fill="Black" Stroke="Gray" StrokeThickness="1">
                                <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerColorTapped" CommandParameter="Black"/></Ellipse.GestureRecognizers>
                            </Ellipse>
                            <Ellipse WidthRequest="22" HeightRequest="22" Fill="Red">
                                <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerColorTapped" CommandParameter="Red"/></Ellipse.GestureRecognizers>
                            </Ellipse>
                            <Ellipse WidthRequest="22" HeightRequest="22" Fill="#007ACC">
                                <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerColorTapped" CommandParameter="Blue"/></Ellipse.GestureRecognizers>
                            </Ellipse>
                        </HorizontalStackLayout>

                        <Label Grid.Column="2" Text="Fond:" TextColor="White" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" />
                        <HorizontalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center">
                            <Ellipse WidthRequest="22" HeightRequest="22" Fill="Transparent" Stroke="Gray" StrokeThickness="1">
                                <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerBgColorTapped" CommandParameter="Transparent"/></Ellipse.GestureRecognizers>
                            </Ellipse>
                            <Ellipse WidthRequest="22" HeightRequest="22" Fill="#333333" Stroke="Gray" StrokeThickness="1">
                                <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerBgColorTapped" CommandParameter="DarkGray"/></Ellipse.GestureRecognizers>
                            </Ellipse>
                            <Ellipse WidthRequest="22" HeightRequest="22" Fill="#FFFFE0" Stroke="Gray" StrokeThickness="1">
                                <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerBgColorTapped" CommandParameter="Ivory"/></Ellipse.GestureRecognizers>
                            </Ellipse>
                            <Ellipse WidthRequest="22" HeightRequest="22" Fill="Red">
                                <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerBgColorTapped" CommandParameter="Red"/></Ellipse.GestureRecognizers>
                            </Ellipse>
                            <Ellipse WidthRequest="22" HeightRequest="22" Fill="Yellow">
                                <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerBgColorTapped" CommandParameter="Yellow"/></Ellipse.GestureRecognizers>
                            </Ellipse>
                            <Ellipse WidthRequest="22" HeightRequest="22" Fill="#2ECC71">
                                <Ellipse.GestureRecognizers><TapGestureRecognizer Tapped="OnStickerBgColorTapped" CommandParameter="Green"/></Ellipse.GestureRecognizers>
                            </Ellipse>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Ligne 2: Taille Slider large et tactile -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Taille:" TextColor="White" VerticalOptions="Center" FontSize="13" FontAttributes="Bold" />
                        <Slider Grid.Column="1" x:Name="StickerSizeSlider" 
                                Minimum="0.5" Maximum="3.0" Value="1.0" 
                                HeightRequest="36" 
                                MinimumTrackColor="#007ACC" MaximumTrackColor="#555555" ThumbColor="White" 
                                VerticalOptions="Center" HorizontalOptions="FillAndExpand" 
                                ValueChanged="OnStickerSizeChanged" />
                    </Grid>
                </Grid>

                <BoxView HeightRequest="1" Color="#444444" />

                <!-- Catégories -->
                <CollectionView x:Name="StickerCategoriesCollection"
                                HeightRequest="40"
                                Margin="4,0"
                                SelectionMode="Single"
                                SelectionChanged="OnStickerCategoryChanged">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#2D2D35" 
                                    Padding="14,6" 
                                    Stroke="#444444"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Name}" 
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="1" Color="#444444" />

                <!-- Stickers de la catégorie -->
                <CollectionView x:Name="StickersCollection" 
                                HeightRequest="65"
                                Margin="4,0"
                                SelectionMode="Single"
                                SelectionChanged="OnStickerSelected"
                                HorizontalOptions="Fill">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="StickerBorder"
                                    Margin="2,2" 
                                    BackgroundColor="{Binding BackgroundColor}" 
                                    Padding="14,6"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="2">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="Stroke" Value="Transparent" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="Stroke" Value="#007ACC" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border.GestureRecognizers>
                                    <DragGestureRecognizer DragStarting="OnStickerDragStarting" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Text}" 
                                       TextColor="{Binding Color}" 
                                       FontSize="{Binding Scale, Converter={StaticResource ScaleToFontSizeConverter}}" 
                                       FontAttributes="Bold"
                                       LineBreakMode="NoWrap"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center"
                                       InputTransparent="True" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- Panneau d'options de surlignage (Stabilo) -->
        <Border x:Name="HighlightOptionsOverlay"
                IsVisible="False"
                VerticalOptions="End"
                HorizontalOptions="Center"
                Margin="0,0,0,45"
                BackgroundColor="#EE1E1E24"
                Stroke="#44FFFFFF"
                StrokeThickness="1"
                Padding="12,8"
                ZIndex="25">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <!-- Pastilles de couleurs (Jaune par défaut, Vert, Bleu, Rouge/Rose) -->
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <!-- Jaune (défaut) -->
                    <Border x:Name="HighlightYellowBtn" BackgroundColor="#FFFF00" WidthRequest="28" HeightRequest="28" Stroke="White" StrokeThickness="3">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnHighlightColorSelected" CommandParameter="#FFFF00" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Vert -->
                    <Border x:Name="HighlightGreenBtn" BackgroundColor="#00E676" WidthRequest="28" HeightRequest="28" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnHighlightColorSelected" CommandParameter="#00E676" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Bleu -->
                    <Border x:Name="HighlightBlueBtn" BackgroundColor="#00B0FF" WidthRequest="28" HeightRequest="28" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnHighlightColorSelected" CommandParameter="#00B0FF" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Rouge/Rose -->
                    <Border x:Name="HighlightRedBtn" BackgroundColor="#FF4081" WidthRequest="28" HeightRequest="28" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnHighlightColorSelected" CommandParameter="#FF4081" /></Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>

                <!-- Séparateur vertical -->
                <BoxView WidthRequest="1" HeightRequest="24" Color="#44FFFFFF" VerticalOptions="Center" />

                <!-- Choix de largeur de stabilo -->
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="Taille :" TextColor="#CCCCCC" FontSize="12" VerticalOptions="Center" />
                    <!-- Bouton Fin (5mm) -->
                    <Button x:Name="HighlightSizeSmallBtn" Text="5mm" BackgroundColor="#333333" TextColor="White" FontSize="11" HeightRequest="28" Padding="6,0" CornerRadius="6" Clicked="OnHighlightSizeSelected" CommandParameter="15" />
                    <!-- Bouton Moyen (10mm - Défaut) -->
                    <Button x:Name="HighlightSizeMediumBtn" Text="10mm" BackgroundColor="#007ACC" TextColor="White" FontSize="11" HeightRequest="28" Padding="6,0" CornerRadius="6" FontAttributes="Bold" Clicked="OnHighlightSizeSelected" CommandParameter="30" />
                    <!-- Bouton Large (18mm) -->
                    <Button x:Name="HighlightSizeLargeBtn" Text="18mm" BackgroundColor="#333333" TextColor="White" FontSize="11" HeightRequest="28" Padding="6,0" CornerRadius="6" Clicked="OnHighlightSizeSelected" CommandParameter="50" />
                </HorizontalStackLayout>

                <!-- Bouton fermer le panneau -->
                <Button Text="✕" BackgroundColor="Transparent" TextColor="#AAAAAA" FontSize="16" HeightRequest="28" WidthRequest="28" Padding="0" Clicked="OnCloseHighlightOptionsClicked" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Panneau d'options de dessin (Crayon) -->
        <Border x:Name="DrawOptionsOverlay"
                IsVisible="False"
                VerticalOptions="End"
                HorizontalOptions="Center"
                Margin="0,0,0,45"
                BackgroundColor="#EE1E1E24"
                Stroke="#44FFFFFF"
                StrokeThickness="1"
                Padding="12,8"
                ZIndex="25">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <!-- Pastilles de couleurs (Noir par défaut, Rouge, Bleu, Vert, Jaune, Blanc) -->
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <!-- Noir (défaut) -->
                    <Border x:Name="DrawBlackBtn" BackgroundColor="#000000" WidthRequest="26" HeightRequest="26" Stroke="White" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDrawColorSelected" CommandParameter="#000000" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Rouge -->
                    <Border x:Name="DrawRedBtn" BackgroundColor="#E53935" WidthRequest="26" HeightRequest="26" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDrawColorSelected" CommandParameter="#E53935" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Bleu -->
                    <Border x:Name="DrawBlueBtn" BackgroundColor="#1E88E5" WidthRequest="26" HeightRequest="26" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDrawColorSelected" CommandParameter="#1E88E5" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Vert -->
                    <Border x:Name="DrawGreenBtn" BackgroundColor="#43A047" WidthRequest="26" HeightRequest="26" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDrawColorSelected" CommandParameter="#43A047" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Jaune -->
                    <Border x:Name="DrawYellowBtn" BackgroundColor="#FFD600" WidthRequest="26" HeightRequest="26" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDrawColorSelected" CommandParameter="#FFD600" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Blanc -->
                    <Border x:Name="DrawWhiteBtn" BackgroundColor="#FFFFFF" WidthRequest="26" HeightRequest="26" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDrawColorSelected" CommandParameter="#FFFFFF" /></Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>

                <!-- Séparateur vertical -->
                <BoxView WidthRequest="1" HeightRequest="22" Color="#44FFFFFF" VerticalOptions="Center" />

                <!-- Choix de largeur de crayon (1mm, 2mm, 3mm, 4mm, 5mm) -->
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Button x:Name="DrawSize1Btn" Text="1mm" BackgroundColor="#333333" TextColor="White" FontSize="11" HeightRequest="28" Padding="5,0" CornerRadius="6" Clicked="OnDrawSizeSelected" CommandParameter="3" />
                    <Button x:Name="DrawSize2Btn" Text="2mm" BackgroundColor="#333333" TextColor="White" FontSize="11" HeightRequest="28" Padding="5,0" CornerRadius="6" Clicked="OnDrawSizeSelected" CommandParameter="6" />
                    <Button x:Name="DrawSize3Btn" Text="3mm" BackgroundColor="#007ACC" TextColor="White" FontSize="11" HeightRequest="28" Padding="5,0" CornerRadius="6" FontAttributes="Bold" Clicked="OnDrawSizeSelected" CommandParameter="9" />
                    <Button x:Name="DrawSize4Btn" Text="4mm" BackgroundColor="#333333" TextColor="White" FontSize="11" HeightRequest="28" Padding="5,0" CornerRadius="6" Clicked="OnDrawSizeSelected" CommandParameter="12" />
                    <Button x:Name="DrawSize5Btn" Text="5mm" BackgroundColor="#333333" TextColor="White" FontSize="11" HeightRequest="28" Padding="5,0" CornerRadius="6" Clicked="OnDrawSizeSelected" CommandParameter="15" />
                </HorizontalStackLayout>

                <!-- Bouton fermer le panneau -->
                <Button Text="✕" BackgroundColor="Transparent" TextColor="#AAAAAA" FontSize="16" HeightRequest="28" WidthRequest="28" Padding="0" Clicked="OnCloseDrawOptionsClicked" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Panneau d'options de Texte (T) -->
        <Border x:Name="TextOptionsOverlay"
                IsVisible="False"
                VerticalOptions="End"
                HorizontalOptions="Center"
                Margin="0,0,0,45"
                BackgroundColor="#EE1E1E24"
                Stroke="#44FFFFFF"
                StrokeThickness="1"
                Padding="12,8"
                ZIndex="25">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <!-- Pastilles de couleurs (Noir par défaut, Rouge, Bleu, Vert, Jaune, Blanc) -->
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <!-- Noir (défaut) -->
                    <Border x:Name="TextBlackBtn" BackgroundColor="#000000" WidthRequest="26" HeightRequest="26" Stroke="White" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTextColorSelected" CommandParameter="#000000" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Rouge -->
                    <Border x:Name="TextRedBtn" BackgroundColor="#E53935" WidthRequest="26" HeightRequest="26" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTextColorSelected" CommandParameter="#E53935" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Bleu -->
                    <Border x:Name="TextBlueBtn" BackgroundColor="#1E88E5" WidthRequest="26" HeightRequest="26" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTextColorSelected" CommandParameter="#1E88E5" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Vert -->
                    <Border x:Name="TextGreenBtn" BackgroundColor="#43A047" WidthRequest="26" HeightRequest="26" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTextColorSelected" CommandParameter="#43A047" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Jaune -->
                    <Border x:Name="TextYellowBtn" BackgroundColor="#FFD600" WidthRequest="26" HeightRequest="26" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTextColorSelected" CommandParameter="#FFD600" /></Border.GestureRecognizers>
                    </Border>
                    <!-- Blanc -->
                    <Border x:Name="TextWhiteBtn" BackgroundColor="#FFFFFF" WidthRequest="26" HeightRequest="26" Stroke="Transparent" StrokeThickness="2">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTextColorSelected" CommandParameter="#FFFFFF" /></Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>

                <!-- Séparateur vertical -->
                <BoxView WidthRequest="1" HeightRequest="22" Color="#44FFFFFF" VerticalOptions="Center" />

                <!-- Choix de taille en pixel (8, 10, 12, 14, 16, 18) -->
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Button x:Name="TextSize8Btn" Text="8" BackgroundColor="#333333" TextColor="White" FontSize="11" HeightRequest="28" Padding="5,0" CornerRadius="6" Clicked="OnTextSizeSelected" CommandParameter="8" />
                    <Button x:Name="TextSize10Btn" Text="10" BackgroundColor="#333333" TextColor="White" FontSize="11" HeightRequest="28" Padding="5,0" CornerRadius="6" Clicked="OnTextSizeSelected" CommandParameter="10" />
                    <Button x:Name="TextSize12Btn" Text="12" BackgroundColor="#333333" TextColor="White" FontSize="11" HeightRequest="28" Padding="5,0" CornerRadius="6" Clicked="OnTextSizeSelected" CommandParameter="12" />
                    <Button x:Name="TextSize14Btn" Text="14" BackgroundColor="#007ACC" TextColor="White" FontSize="11" HeightRequest="28" Padding="5,0" CornerRadius="6" FontAttributes="Bold" Clicked="OnTextSizeSelected" CommandParameter="14" />
                    <Button x:Name="TextSize16Btn" Text="16" BackgroundColor="#333333" TextColor="White" FontSize="11" HeightRequest="28" Padding="5,0" CornerRadius="6" Clicked="OnTextSizeSelected" CommandParameter="16" />
                    <Button x:Name="TextSize18Btn" Text="18" BackgroundColor="#333333" TextColor="White" FontSize="11" HeightRequest="28" Padding="5,0" CornerRadius="6" Clicked="OnTextSizeSelected" CommandParameter="18" />
                </HorizontalStackLayout>

                <!-- Bouton fermer le panneau -->
                <Button Text="✕" BackgroundColor="Transparent" TextColor="#AAAAAA" FontSize="16" HeightRequest="28" WidthRequest="28" Padding="0" Clicked="OnCloseTextOptionsClicked" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Barre d'Annotations (Bas) -->
        <Border x:Name="AnnotationBar"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                BackgroundColor="#80000000"
                HeightRequest="45"
                StrokeThickness="0"
                IsVisible="False"
                ZIndex="20">
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnAnnotationBarPanUpdated" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto, Auto, Auto, Auto, Auto, Auto" Padding="8,0">
                <Button Grid.Column="0" x:Name="HighlightBtn" Text="🖌" BackgroundColor="Transparent" TextColor="#FFD700" Clicked="OnAnnotationHighlightClicked" FontSize="18" WidthRequest="38" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Grid.Column="1" x:Name="TextAnnotationBtn" Text="T" BackgroundColor="Transparent" TextColor="White" Clicked="OnAnnotationTextClicked" FontSize="16" FontAttributes="Bold" WidthRequest="38" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Grid.Column="2" x:Name="DrawBtn" Text="✎" BackgroundColor="Transparent" TextColor="White" Clicked="OnAnnotationDrawClicked" FontSize="16" WidthRequest="38" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Grid.Column="3" Text="❏" BackgroundColor="Transparent" TextColor="White" Clicked="OnAnnotationStickersClicked" FontSize="16" WidthRequest="38" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" />
                
                <BoxView Grid.Column="4" Color="Transparent" />
                
                <!-- Boutons Undo et Redo -->
                <Button Grid.Column="5" x:Name="UndoBtn" Text="↩" BackgroundColor="Transparent" TextColor="White" Clicked="OnUndoAnnotationClicked" FontSize="18" WidthRequest="38" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" Opacity="0.4" />
                <Button Grid.Column="6" x:Name="RedoBtn" Text="↪" BackgroundColor="Transparent" TextColor="White" Clicked="OnRedoAnnotationClicked" FontSize="18" WidthRequest="38" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" Opacity="0.4" />

                <!-- Bouton Reset Nettoyage complet -->
                <Button Grid.Column="7" Text="✧" BackgroundColor="Transparent" TextColor="White" Clicked="OnResetAnnotationsClicked" FontSize="18" WidthRequest="38" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Grid.Column="8" x:Name="LockUnlockBtn" Text="🔒" BackgroundColor="#D32F2F" TextColor="White" Clicked="OnLockUnlockClicked" FontSize="16" Padding="0" WidthRequest="40" HeightRequest="34" CornerRadius="6" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Grid.Column="9" Text="🗑" BackgroundColor="Transparent" TextColor="#FF5555" Clicked="OnDeleteSelectedAnnotationClicked" FontSize="16" WidthRequest="38" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Grid.Column="10" Text="✕" BackgroundColor="Transparent" TextColor="White" Clicked="OnCloseAnnotationBarClicked" FontSize="18" FontAttributes="Bold" WidthRequest="38" HeightRequest="36" Padding="0" VerticalOptions="Center" HorizontalOptions="Center" />
            </Grid>
        </Border>

        <!-- Indicateur de page (tout en bas, cliquable pour changement de page direct) -->
        <Label x:Name="PageIndicator" 
               IsVisible="False" 
               HorizontalOptions="End" 
               VerticalOptions="End" 
               Margin="0, 0, 10, 5" 
               TextColor="White" 
               BackgroundColor="#80000000" 
               Padding="10,5"
               ZIndex="1000">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnGoToPageClicked" />
            </Label.GestureRecognizers>
        </Label>

        <!-- Menu Central Moderne et Compact -->
        <Border x:Name="CentralMenuOverlay" 
                IsVisible="False" 
                BackgroundColor="#F51A1A1A" 
                VerticalOptions="Center" 
                HorizontalOptions="Center" 
                Padding="20"
                WidthRequest="320"
                StrokeThickness="1"
                Stroke="#555555"
                ZIndex="1000">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="12">
                <Label x:Name="MenuTitleLabel" FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" Margin="0,0,0,5" />
                
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Button Grid.Column="0" x:Name="RotateBtn" Text="↻ Rotation (+90°)" 
                            BackgroundColor="#333333" TextColor="White" FontSize="13" CornerRadius="10" HeightRequest="40" Clicked="OnRotateClicked" />
                    <Button Grid.Column="1" Text="📄 Page" 
                            BackgroundColor="#333333" TextColor="White" FontSize="13" CornerRadius="10" HeightRequest="40" Clicked="OnGoToPageClicked" />
                </Grid>

                <!-- Rétablir la taille d'origine (Zoom Reset) -->
                <Button Text="🔍 Rétablir la taille d'origine (100%)" 
                        BackgroundColor="#2C3E50" 
                        TextColor="White" 
                        FontSize="13" 
                        CornerRadius="10" 
                        HeightRequest="40" 
                        Clicked="OnResetZoomClicked" />

                <!-- Option de portée de rotation -->
                <Grid ColumnDefinitions="*, Auto" Margin="5,0">
                    <Label x:Name="RotationScopeLabel" Text="Appliquer à cette page uniquement" TextColor="#AAAAAA" FontSize="12" VerticalOptions="Center" />
                    <Switch Grid.Column="1" x:Name="RotateAllPagesSwitch" OnColor="#007ACC" Scale="0.8" Toggled="OnRotateAllPagesToggled" />
                </Grid>

                <Grid ColumnDefinitions="*, Auto" Margin="5,0">
                    <Label Text="Mémoriser les rotations" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center" />
                    <Switch Grid.Column="1" x:Name="SaveRotationSwitch" OnColor="#007ACC" Scale="0.8" Toggled="OnSaveRotationToggled" />
                </Grid>

                <BoxView HeightRequest="1" Color="#444444" Margin="0,5" />

                <Grid ColumnDefinitions="*, Auto" Margin="5,0">
                    <Label Text="Afficher Métronome" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center" />
                    <Switch Grid.Column="1" x:Name="MenuMetronomeSwitch" OnColor="#007ACC" Scale="0.8" Toggled="OnMenuMetronomeToggled" />
                </Grid>

                <Grid ColumnDefinitions="*, Auto" Margin="5,0">
                    <Label Text="Afficher Lecteur Audio" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center" />
                    <Switch Grid.Column="1" x:Name="MenuAudioSwitch" OnColor="#007ACC" Scale="0.8" Toggled="OnMenuAudioToggled" />
                </Grid>

                <Grid ColumnDefinitions="*, Auto" Margin="5,0">
                    <Label Text="Afficher les annotations" TextColor="#AAAAAA" FontSize="13" VerticalOptions="Center" />
                    <Switch Grid.Column="1" x:Name="MenuAnnotationsSwitch" OnColor="#007ACC" Scale="0.8" Toggled="OnMenuAnnotationsToggled" />
                </Grid>

                <BoxView HeightRequest="1" Color="#444444" Margin="0,5" />

                <Button x:Name="MenuModifyAssemblyButton"
                        Text="📑 Modifier l'assemblage PDF" 
                        BackgroundColor="#2C3E50" 
                        TextColor="White" 
                        FontSize="13" 
                        CornerRadius="10" 
                        HeightRequest="40"
                        Clicked="OnMenuModifyAssemblyClicked" />

                <Button Text="✏️ Modifier la partition" 
                        BackgroundColor="#007ACC" TextColor="White" 
                        FontAttributes="Bold" CornerRadius="10" HeightRequest="45"
                        Clicked="OnEditScoreClicked" />

                <Button Text="Retour à l'accueil" 
                        BackgroundColor="#E74C3C" TextColor="White" 
                        FontAttributes="Bold" CornerRadius="10" HeightRequest="45"
                        Clicked="OnBackClicked" />
                
                <Button Text="Fermer" 
                        BackgroundColor="Transparent" TextColor="#AAAAAA" 
                        FontSize="13" HeightRequest="35"
                        Clicked="OnCloseMenuClicked" />
            </VerticalStackLayout>
        </Border>

        <!-- Zone tactile transparente du haut au centre pour ouvrir le déroulement de la setlist -->
        <ContentView x:Name="TopSetlistTouchBar"
                     VerticalOptions="Start"
                     HorizontalOptions="Center"
                     HeightRequest="60"
                     WidthRequest="350"
                     BackgroundColor="Transparent"
                     ZIndex="500"
                     IsVisible="False">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTopSetlistTouchTapped" />
            </ContentView.GestureRecognizers>
        </ContentView>

        <!-- Volet Déroulement de la Setlist (Haut de l'écran) -->
        <Grid x:Name="SetlistProgressModal"
              IsVisible="False"
              ZIndex="999"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <!-- Arrière-plan semi-transparent pour fermer en cliquant à côté -->
            <BoxView BackgroundColor="#70000000"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseSetlistProgressClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Boîte de déroulement de la setlist fixée en haut -->
            <Border x:Name="SetlistProgressOverlay"
                    VerticalOptions="Start"
                    HorizontalOptions="Center"
                    WidthRequest="480"
                    MaximumHeightRequest="420"
                    Margin="15,0,15,0"
                    Padding="16,14,16,16"
                    BackgroundColor="#F4181820"
                    Stroke="#007ACC"
                    StrokeThickness="1.5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,18,18" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,6" Radius="15" Opacity="0.75" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto, 1, *" RowSpacing="10">
                    <!-- Entête du déroulement -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="📋" FontSize="18" VerticalOptions="Center" />
                            <Label Text="Déroulement de la setlist" 
                                   TextColor="White" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Grid.Column="1" 
                               x:Name="SetlistProgressCounterLabel"
                               Text="1 / 5" 
                               TextColor="#00B4D8" 
                               FontAttributes="Bold" 
                               FontSize="13" 
                               HorizontalOptions="End" 
                               VerticalOptions="Center"
                               Margin="0,0,12,0" />

                        <Button Grid.Column="2" 
                                Text="✕" 
                                BackgroundColor="#33FFFFFF" 
                                TextColor="White" 
                                FontSize="14" 
                                FontAttributes="Bold"
                                WidthRequest="32" 
                                HeightRequest="32" 
                                CornerRadius="16"
                                Padding="0"
                                VerticalOptions="Center"
                                Clicked="OnCloseSetlistProgressClicked" />
                    </Grid>

                    <!-- Séparateur -->
                    <BoxView Grid.Row="1" HeightRequest="1" Color="#334466" />

                    <!-- Liste déroulante des partitions de la setlist -->
                    <ScrollView x:Name="SetlistProgressScrollView" Grid.Row="2" Orientation="Vertical">
                        <VerticalStackLayout x:Name="SetlistProgressStack" Spacing="6" />
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>

        <!-- Zone tactile transparente du bas pour activer les annotations (PDF & Images, même zoomés) -->
        <ContentView x:Name="BottomTouchBar"
                     VerticalOptions="End"
                     HeightRequest="80"
                     BackgroundColor="Transparent"
                     ZIndex="500">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAnnotationToggleTapped" />
            </ContentView.GestureRecognizers>
        </ContentView>
    </Grid>
</ContentPage>
