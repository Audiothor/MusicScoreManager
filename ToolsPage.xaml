<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MusicScoreManager.Models"
             x:Class="MusicScoreManager.ToolsPage"
             BackgroundColor="#121212"
             Title="Outils">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Margin="20">
            
            <!-- Chapitre 1 : Étiquettes -->
            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0"
                       Text="Étiquettes" 
                       TextColor="#007ACC" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       VerticalOptions="Center" />

                <Button Grid.Column="1"
                        Text="+"
                        FontSize="24"
                        FontAttributes="Bold"
                        WidthRequest="44"
                        HeightRequest="44"
                        CornerRadius="22"
                        BackgroundColor="#007ACC"
                        TextColor="White"
                        Clicked="OnAddTagClicked" />
            </Grid>

            <SearchBar x:Name="SearchTagBar"
                       Placeholder="Rechercher une étiquette..."
                       PlaceholderColor="#888888"
                       TextColor="#FFFFFF"
                       BackgroundColor="#1E1E1E"
                       TextChanged="OnSearchTagBarTextChanged" />

            <CollectionView x:Name="TagsCollectionView"
                            HeightRequest="220"
                            SelectionMode="Single"
                            SelectionChanged="OnTagSelected">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Tag">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Renommer" 
                                               BackgroundColor="#1E88E5" 
                                               Invoked="OnRenameTagInvoked" 
                                               CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Supprimer" 
                                               BackgroundColor="#E53935" 
                                               Invoked="OnDeleteTagInvoked" 
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Stroke="#333333" 
                                    StrokeThickness="1" 
                                    BackgroundColor="#1E1E1E" 
                                    Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto, *">
                                    <BoxView Grid.Column="0"
                                             Color="{Binding ColorHex}"
                                             WidthRequest="14"
                                             HeightRequest="14"
                                             CornerRadius="7"
                                             VerticalOptions="Center"
                                             Margin="0,0,12,0" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Name}" 
                                           FontSize="15" 
                                           TextColor="White" 
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                        <Label Text="Aucune étiquette n'a été créée."
                               TextColor="#888888"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <BoxView HeightRequest="1" Color="#333333" Margin="0,5" />

            <!-- Chapitre 2 : Importation de Packages (.msmsetlist / .msmscore) -->
            <Label Text="Paquets et Archives" 
                   TextColor="#007ACC" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   Margin="0,5,0,0" />

            <Border BackgroundColor="#1E1E1E" Padding="15" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Importer une archive ou setlist partagée" 
                           TextColor="White" 
                           FontAttributes="Bold" />
                    <Label Text="Importez un fichier '.msmsetlist', '.msmscore' ou '.msmscores' exporté depuis un autre appareil pour intégrer automatiquement les partitions, métadonnées, annotations et setlists." 
                           TextColor="#888888" 
                           FontSize="12" />
                    <Button Text="📥 Importer un paquet (.msmsetlist / .msmscore)"
                            BackgroundColor="#2ECC71"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="46"
                            CornerRadius="8"
                            Clicked="OnImportPackageClicked" />
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="1" Color="#333333" Margin="0,5" />

            <!-- Chapitre 3 : Gestion des sauvegardes -->
            <Label Text="Gestion des sauvegardes" 
                   TextColor="#007ACC" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   Margin="0,5,0,0" />

            <Border BackgroundColor="#1E1E1E" Padding="15" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15">
                    <Label Text="Paramètres de sauvegarde automatique" 
                           TextColor="#AAAAAA" 
                           FontAttributes="Bold" />
                    
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" 
                               Text="Intervalle (jours)" 
                               TextColor="White" 
                               VerticalOptions="Center" />
                        <Entry Grid.Row="0" Grid.Column="1" 
                               x:Name="IntervalEntry" 
                               Text="30"
                               WidthRequest="80" 
                               Keyboard="Numeric" 
                               TextColor="White"
                               HorizontalTextAlignment="Center"
                               BackgroundColor="#333333" />
                        
                        <Label Grid.Row="1" Grid.Column="0" 
                               Text="Nombre de copies à garder" 
                               TextColor="White" 
                               VerticalOptions="Center" />
                        <Entry Grid.Row="1" Grid.Column="1" 
                               x:Name="MaxKeepEntry" 
                               Text="6"
                               WidthRequest="80" 
                               Keyboard="Numeric" 
                               TextColor="White"
                               HorizontalTextAlignment="Center"
                               BackgroundColor="#333333" />
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
                        <Button Grid.Column="0" 
                                Text="Annuler" 
                                BackgroundColor="#444444" 
                                TextColor="White" 
                                Clicked="OnCancelSettingsClicked" />
                        <Button Grid.Column="1" 
                                Text="Enregistrer" 
                                BackgroundColor="#28A745" 
                                TextColor="White" 
                                Clicked="OnSaveSettingsClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Sauvegarder la base de données maintenant"
                    BackgroundColor="#007ACC"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Clicked="OnBackupClicked" />

            <Border Stroke="#D35400" StrokeThickness="1" BackgroundColor="#2D1A05" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label Text="⚠️ Avertissement" TextColor="#D35400" FontAttributes="Bold" />
                    <Label x:Name="BackupWarningLabel" 
                           TextColor="#E67E22" 
                           FontSize="12" 
                           LineBreakMode="WordWrap"
                           Text="La sauvegarde ne concerne que la base de données. Vos fichiers ne sont pas inclus." />
                </VerticalStackLayout>
            </Border>

            <Label Text="Historique des sauvegardes" 
                   TextColor="#AAAAAA" 
                   Margin="0,10,0,0" />
            
            <Label x:Name="FolderPathLabel" 
                   TextColor="#666666" 
                   FontSize="10" 
                   LineBreakMode="CharacterWrap" />

            <CollectionView x:Name="BackupsCollectionView" HeightRequest="250" Margin="0,10">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15" Padding="0,10">
                            <Label Grid.Column="0" 
                                   Text="📦" 
                                   FontSize="24" 
                                   VerticalOptions="Center" />
                            
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding DisplayDate}" 
                                       TextColor="White" 
                                       FontAttributes="Bold" 
                                       FontSize="14" />
                                <Label Text="{Binding DisplaySize}" 
                                       TextColor="#888888" 
                                       FontSize="12" />
                            </VerticalStackLayout>

                            <Button Grid.Column="2" 
                                    Text="Restaurer" 
                                    BackgroundColor="#333333" 
                                    TextColor="#007ACC" 
                                    FontSize="12"
                                    HeightRequest="36"
                                    Clicked="OnItemRestoreClicked" 
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Aucune sauvegarde disponible." 
                           TextColor="#666666" 
                           HorizontalOptions="Center" 
                           Margin="0,20" />
                </CollectionView.EmptyView>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
