<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicScoreManager.ToolsPage"
             BackgroundColor="#121212"
             Title="Outils">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Margin="20">
                <!-- En-tête -->
                <VerticalStackLayout HorizontalOptions="Center" Margin="0,5,0,10" Spacing="4">
                    <Label Text="Outils &amp; Utilitaires" 
                           TextColor="White" 
                           FontSize="22" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="Boîte à outils pour assembler, organiser et sécuriser vos partitions" 
                           TextColor="#888888" 
                           FontSize="13" 
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Liste des outils (même ergonomie que Paramètres) -->
                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    
                    <VerticalStackLayout>
                        <!-- 1. Créateur & Assemblage de partitions PDF -->
                        <Grid Padding="15" BackgroundColor="Transparent" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolsPdfAssemblerTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="📑" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Créateur &amp; Assemblage PDF" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Assembler photos, modifier l'ordre des pages, pivoter, page blanche" TextColor="#888888" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>
                        
                        <BoxView HeightRequest="1" Color="#333333" />
                        
                        <!-- 2. Gestion des étiquettes -->
                        <Grid Padding="15" BackgroundColor="Transparent" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolsTagsTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="🏷️" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Gestion des étiquettes" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Créer, attribuer des couleurs, renommer et organiser vos tags" TextColor="#888888" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#333333" />

                        <!-- 3. Imports de Setlists ou Partitions -->
                        <Grid Padding="15" BackgroundColor="Transparent" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolsImportPackageTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="📦" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Imports de paquets &amp; setlists" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Importer des archives partagées (.msmsetlist, .msmscore)" TextColor="#888888" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#333333" />

                        <!-- 4. Gestion des doublons -->
                        <Grid Padding="15" BackgroundColor="Transparent" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolsDuplicatesTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="🔍" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Gestion des doublons" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Détecter les fichiers identiques par SHA-256 et nettoyer" TextColor="#888888" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#333333" />

                        <!-- 5. Gestion des sauvegardes -->
                        <Grid Padding="15" BackgroundColor="Transparent" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolsBackupsTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="💾" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Gestion des sauvegardes" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Sauvegarde automatique, manuelle et restauration de la base" TextColor="#888888" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
