<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.ToolsPage"
             BackgroundColor="#121212"
             Title="{Binding [Nav_Tools], Source={x:Static services:LocalizationService.Instance}}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Margin="20">
                <!-- En-tête -->
                <VerticalStackLayout HorizontalOptions="Center" Margin="0,5,0,10" Spacing="4">
                    <Label Text="{Binding [Tools_Header_Title], Source={x:Static services:LocalizationService.Instance}}" 
                           TextColor="White" 
                           FontSize="22" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding [Tools_Header_Subtitle], Source={x:Static services:LocalizationService.Instance}}" 
                           TextColor="#888888" 
                           FontSize="13" 
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Liste des outils (même ergonomie que Paramètres) -->
                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    
                    <VerticalStackLayout>
                        <!-- 1. Créateur & Assemblage de partitions PDF -->
                        <Grid Padding="15" BackgroundColor="Transparent" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolsPdfAssemblerTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="📑" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding [Tools_PdfAssembler_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding [Tools_PdfAssembler_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>
                        
                        <BoxView HeightRequest="1" Color="#333333" />
                        
                        <!-- 2. Transfert Wi-Fi Direct (P2P) -->
                        <Grid Padding="15" BackgroundColor="Transparent" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolsWifiTransferTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="📡" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding [Tools_WifiTransfer_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding [Tools_WifiTransfer_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#333333" />

                        <!-- 3. Gestion des étiquettes -->
                        <Grid Padding="15" BackgroundColor="Transparent" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolsTagsTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="🏷️" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding [Tools_Tags_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding [Tools_Tags_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#333333" />

                        <!-- 4. Imports de Setlists ou Partitions -->
                        <Grid Padding="15" BackgroundColor="Transparent" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolsImportPackageTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="📦" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding [Tools_ImportPackage_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding [Tools_ImportPackage_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#333333" />

                        <!-- 5. Gestion des doublons -->
                        <Grid Padding="15" BackgroundColor="Transparent" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolsDuplicatesTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="🔍" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding [Tools_Duplicates_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding [Tools_Duplicates_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#333333" />

                        <!-- 6. Gestion des sauvegardes -->
                        <Grid Padding="15" BackgroundColor="Transparent" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolsBackupsTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="💾" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding [Tools_Backups_Title], Source={x:Static services:LocalizationService.Instance}}" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding [Tools_Backups_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" TextColor="#888888" FontSize="20" HorizontalOptions="End" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
