<?xml version="1.0" encoding="utf-8" ?>
<resources>
    <style name="Maui.MainTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#007ACC</item>
        <item name="colorPrimaryDark">#005999</item>
        <item name="colorAccent">#FFFFFF</item>
        <item name="colorControlActivated">#FFFFFF</item>
        <item name="colorControlNormal">#888888</item>
        <item name="android:colorControlActivated">#FFFFFF</item>
        <item name="android:colorControlNormal">#888888</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="alertDialogTheme">@style/CustomAlertDialogTheme</item>
        <item name="android:alertDialogTheme">@style/CustomAlertDialogTheme</item>
        <item name="bottomNavigationStyle">@style/CustomBottomNavigationStyle</item>
    </style>

    <style name="CustomBottomNavigationStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/BottomNavActiveTextAppearance</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavInactiveTextAppearance</item>
    </style>

    <style name="BottomNavActiveTextAppearance" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BottomNavInactiveTextAppearance" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomAlertDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorAccent">#FFFFFF</item>
        <item name="colorPrimary">#007ACC</item>
        <item name="colorControlActivated">#FFFFFF</item>
        <item name="colorControlNormal">#888888</item>
        <item name="android:colorControlActivated">#FFFFFF</item>
        <item name="android:colorControlNormal">#888888</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:textColorAlertDialogListItem">#FFFFFF</item>
    </style>
</resources>
