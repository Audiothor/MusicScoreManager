<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.SettingsSetlistsPage"
             BackgroundColor="#121212"
             Title="{Binding [Settings_Setlists_Title], Source={x:Static services:LocalizationService.Instance}}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header personnalisé avec bouton Retour -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="{Binding [Common_Back], Source={x:Static services:LocalizationService.Instance}}" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold" 
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" 
                    Text="{Binding [Settings_Setlists_Title], Source={x:Static services:LocalizationService.Instance}}" 
                    TextColor="White" 
                    FontSize="18" 
                    FontAttributes="Bold" 
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    Margin="0,0,80,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Margin="20">
                
                <Label Text="{Binding [Settings_Scores_Section_Organization], Source={x:Static services:LocalizationService.Instance}}" 
                       TextColor="#007ACC" 
                       FontSize="18" 
                       FontAttributes="Bold" />

                <!-- Option : Tri par défaut des setlists -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding [Settings_Setlists_Default_Sort], Source={x:Static services:LocalizationService.Instance}}" 
                           TextColor="White" 
                           FontSize="16" />
                    <Label Text="{Binding [Settings_Setlists_Default_Sort_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                           TextColor="#888888" 
                           FontSize="12" />
                    <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="10,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Picker x:Name="DefaultSortPicker"
                                TextColor="White"
                                TitleColor="#888888"
                                SelectedIndexChanged="OnDefaultSortChanged" />
                    </Border>
                </VerticalStackLayout>

                <!-- Option : Setlists terminées en bas -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center" Margin="0,5,0,0">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{Binding [Settings_Setlists_Done_At_Bottom], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="White" 
                               FontSize="16" />
                        <Label Text="{Binding [Settings_Setlists_Done_At_Bottom_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="#888888" 
                               FontSize="12" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" 
                            x:Name="DoneAtBottomSwitch"
                            OnColor="#007ACC"
                            ThumbColor="White"
                            Toggled="OnDoneAtBottomToggled" />
                </Grid>

                <BoxView HeightRequest="1" Color="#333333" />

                <Label Text="{Binding [Settings_Setlists_Default_Behavior], Source={x:Static services:LocalizationService.Instance}}" 
                       TextColor="#007ACC" 
                       FontSize="18" 
                       FontAttributes="Bold" />

                <!-- Option : Lecture en continu par défaut -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{Binding [Settings_Setlists_Continuous], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="White" 
                               FontSize="16" />
                        <Label Text="{Binding [Settings_Setlists_Continuous_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="#888888" 
                               FontSize="12" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" 
                            x:Name="DefaultContinuousSwitch"
                            OnColor="#007ACC"
                            ThumbColor="White"
                            Toggled="OnDefaultContinuousToggled" />
                </Grid>

                <BoxView HeightRequest="1" Color="#333333" />

                <!-- Option : Retour à la setlist en fin de partition (si non continu) -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{Binding [Settings_Setlists_Return_End], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="White" 
                               FontSize="16" />
                        <Label Text="{Binding [Settings_Setlists_Return_End_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="#888888" 
                               FontSize="12" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" 
                            x:Name="ReturnToSetlistSwitch"
                            OnColor="#007ACC"
                            ThumbColor="White"
                            Toggled="OnReturnToSetlistToggled" />
                </Grid>

                <BoxView HeightRequest="1" Color="#333333" />

                <!-- Option : Afficher le déroulement de la setlist -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{Binding [Settings_Setlists_Show_Progress], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="White" 
                               FontSize="16" />
                        <Label Text="{Binding [Settings_Setlists_Show_Progress_Desc], Source={x:Static services:LocalizationService.Instance}}" 
                               TextColor="#888888" 
                               FontSize="12" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" 
                            x:Name="ShowSetlistProgressSwitch"
                            OnColor="#007ACC"
                            ThumbColor="White"
                            Toggled="OnShowSetlistProgressToggled" />
                </Grid>

                <BoxView HeightRequest="1" Color="#333333" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
