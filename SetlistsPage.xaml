<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MusicScoreManager.Models"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.SetlistsPage"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="15,15,15,15" ColumnSpacing="10">
            <SearchBar Grid.Column="0"
                       x:Name="SearchSetlistBar"
                       Placeholder="Rechercher une Setlist..."
                       PlaceholderColor="#888888"
                       TextColor="#FFFFFF"
                       BackgroundColor="#1E1E1E"
                       TextChanged="OnSearchBarTextChanged" />
            
            <Button Grid.Column="1"
                    Text="⇅"
                    FontSize="20"
                    FontAttributes="Bold"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="#333333"
                    TextColor="White"
                    Clicked="OnSortClicked" />

            <Button Grid.Column="2"
                    Text="+"
                    FontSize="24"
                    FontAttributes="Bold"
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="#007ACC"
                    TextColor="White"
                    Clicked="OnAddSetlistClicked" />
        </Grid>

        <!-- Filtres par Statut -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" Margin="15,0,15,10" HeightRequest="40">
            <HorizontalStackLayout x:Name="StatusFiltersStack" Spacing="10" VerticalOptions="Center" />
        </ScrollView>

        <CollectionView Grid.Row="2"
                        x:Name="SetlistsCollectionView"
                        Margin="15,0"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Setlist">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Renommer" 
                                           BackgroundColor="LightBlue" 
                                           Invoked="OnRenameSetlistInvoked" 
                                           CommandParameter="{Binding .}" />
                                <SwipeItem Text="Supprimer" 
                                           BackgroundColor="Red" 
                                           Invoked="OnDeleteSetlistInvoked" 
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Stroke="#333333" 
                                StrokeThickness="1" 
                                BackgroundColor="#1E1E1E" 
                                Padding="15">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSetlistTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, *">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Name}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="White" 
                                       VerticalOptions="Center" 
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />

                                <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5" VerticalOptions="Center" Margin="10,0,0,0">
                                    <Label Text="🔒" 
                                           TextColor="#DC3545" 
                                           FontSize="14" 
                                           IsVisible="{Binding IsLocked}" 
                                           VerticalOptions="Center" />

                                    <Border BackgroundColor="{Binding StatusColor}"
                                            Padding="8,2"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="5" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding StatusText}" 
                                               TextColor="White" 
                                               FontSize="10" 
                                               FontAttributes="Bold" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Button Grid.Row="0" Grid.Column="2"
                                        Text="⋮" 
                                        FontSize="24" 
                                        TextColor="#888888" 
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        WidthRequest="50"
                                        HeightRequest="50"
                                        Padding="0"
                                        VerticalOptions="Center" 
                                HorizontalOptions="End"
                                        Clicked="OnSetlistMenuTapped"
                                        CommandParameter="{Binding .}" />
                                       
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                       Text="{Binding DateCreated, StringFormat='Créé le {0:dd/MM/yyyy}'}" 
                                       FontSize="12" 
                                       TextColor="#888888" 
                                       Margin="0,5,0,0"/>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="Aucune Setlist trouvée."
                           TextColor="#888888"
                           HorizontalOptions="Center" />
                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
        <!-- Modal Options d'envoi / export Setlist -->
        <ContentView x:Name="SetlistOptionsOverlay" 
                      Grid.RowSpan="3"
                      IsVisible="False" 
                      BackgroundColor="#A0000000" 
                      ZIndex="1004">
            <Border BackgroundColor="#1E1E1E" 
                    Stroke="#007ACC"
                    StrokeThickness="1.5"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    WidthRequest="350"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15">
                    <Label x:Name="SetlistOptionsTitle" 
                           Text="Options de partage" 
                           TextColor="White" 
                           FontAttributes="Bold" 
                           FontSize="18" 
                           HorizontalOptions="Center" />
                    
                    <Label Text="Choisissez les éléments à inclure dans le package :" 
                           TextColor="#AAAAAA" 
                           FontSize="13" />

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="OptAnnotationsCheckBox" IsChecked="True" Color="#007ACC" />
                        <Label Text="Inclure les annotations (doigtés, etc.)" TextColor="White" VerticalOptions="Center" FontSize="13" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox x:Name="OptAudioCheckBox" IsChecked="True" Color="#007ACC" />
                        <Label Text="Inclure les pistes audio rattachées" TextColor="White" VerticalOptions="Center" FontSize="13" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#333333" Margin="0,5" />

                    <Button Text="📡 Envoyer en Wi-Fi Direct (P2P)"
                            BackgroundColor="#007ACC"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="44"
                            CornerRadius="8"
                            Clicked="OnOptionsSendWifiClicked" />

                    <Button Text="📦 Exporter en fichier (.msmsetlist)"
                            BackgroundColor="#2ECC71"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="44"
                            CornerRadius="8"
                            Clicked="OnOptionsExportFileClicked" />

                    <Button Text="Annuler"
                            BackgroundColor="Transparent"
                            TextColor="#888888"
                            HeightRequest="36"
                            Clicked="OnOptionsCancelClicked" />
                </VerticalStackLayout>
            </Border>
        </ContentView>

        <!-- Overlay Envoi Wi-Fi Direct & Diffusion Groupe Setlist -->
        <ContentView x:Name="WifiOverlay" 
                      Grid.RowSpan="3"
                      IsVisible="False" 
                      BackgroundColor="#A0000000" 
                      ZIndex="1005">
            <Border BackgroundColor="#1E1E1E" 
                    Stroke="#333333"
                    StrokeThickness="1"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    WidthRequest="380"
                    HeightRequest="650"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto, *, Auto" RowSpacing="15">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <Label Text="📡 Envoi Wi-Fi Direct Setlist" 
                               TextColor="White" 
                               FontAttributes="Bold" 
                               FontSize="18" 
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="✕"
                               TextColor="#888888"
                               FontSize="20"
                               Padding="5">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWifiCloseOverlayClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Content Area -->
                    <Grid Grid.Row="1">
                        <!-- Mode Envoi (Recherche et Liste d'appareils) -->
                        <Grid x:Name="WifiSendingView" RowDefinitions="Auto, *, Auto, Auto" RowSpacing="10" IsVisible="True">
                            <VerticalStackLayout Grid.Row="0" Spacing="4">
                                <Label Text="Appareils Wi-Fi Direct détectés :" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                <Label Text="Cliquez sur un destinataire pour lui envoyer la setlist." TextColor="#888888" FontSize="11" />
                                <ActivityIndicator x:Name="WifiScanSpinner" IsRunning="True" Color="#007ACC" HeightRequest="18" WidthRequest="18" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                            
                            <ListView Grid.Row="1" 
                                      x:Name="WifiDevicesListView" 
                                      BackgroundColor="Transparent"
                                      SeparatorColor="#333333"
                                      HasUnevenRows="True"
                                      ItemSelected="OnWifiDeviceSelected">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="services:WifiDeviceInfo">
                                        <ViewCell>
                                            <Grid ColumnDefinitions="Auto, *, Auto" Padding="10,6" ColumnSpacing="10">
                                                <Label Grid.Column="0" Text="📱" FontSize="20" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                                    <Label Text="{Binding IpAddress}" TextColor="#888888" FontSize="11" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="2" 
                                                        Text="Envoyer" 
                                                        BackgroundColor="#007ACC" 
                                                        TextColor="White" 
                                                        FontSize="12" 
                                                        FontAttributes="Bold" 
                                                        HeightRequest="34" 
                                                        CornerRadius="6" 
                                                        Clicked="OnSendSetlistToDeviceButtonClicked" 
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Bouton Diffusion Groupe QR Code -->
                            <Button Grid.Row="2" 
                                    x:Name="ToggleGroupShareButton"
                                    Text="📲 Mode Diffusion Groupe (QR Code)"
                                    BackgroundColor="#2C2C2C"
                                    BorderColor="#FF3366"
                                    BorderWidth="1"
                                    TextColor="#FF3366"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="42"
                                    Clicked="OnToggleGroupShareClicked" />
                            
                            <Button Grid.Row="3" 
                                    Text="🔄 Relancer la recherche"
                                    BackgroundColor="#1A1A1A"
                                    TextColor="#AAAAAA"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    Clicked="OnWifiRescanClicked" />
                        </Grid>

                        <!-- Vue Partage de Groupe QR Code (Leader) -->
                        <VerticalStackLayout x:Name="WifiGroupQrView" Spacing="12" IsVisible="False" VerticalOptions="Center">
                            <Label Text="Scannez pour télécharger la Setlist" TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                            <Border Stroke="#007ACC" StrokeThickness="2" BackgroundColor="White" Padding="8" WidthRequest="220" HeightRequest="220" HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Image x:Name="QrCodeImageView" WidthRequest="200" HeightRequest="200" Aspect="AspectFit" />
                            </Border>
                            <Label x:Name="QrGroupInfoLabel" Text="En attente de musiciens..." TextColor="#2ECC71" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label x:Name="QrGroupUrlLabel" Text="http://..." TextColor="#888888" FontSize="11" HorizontalOptions="Center" />
                            <Button Text="Fermer le partage de groupe"
                                    BackgroundColor="#CC2929"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="40"
                                    Clicked="OnStopGroupShareClicked" />
                        </VerticalStackLayout>

                        <!-- Mode Transfert en cours -->
                        <VerticalStackLayout x:Name="WifiTransferProgressView" Spacing="16" IsVisible="False" VerticalOptions="Center">
                            <ActivityIndicator IsRunning="True" Color="#007ACC" HeightRequest="50" WidthRequest="50" HorizontalOptions="Center" />
                            <Label x:Name="WifiTransferStatusLabel" 
                                   Text="Transfert en cours... 0%" 
                                   TextColor="White" 
                                   FontAttributes="Bold" 
                                   FontSize="15" 
                                   HorizontalOptions="Center" 
                                   HorizontalTextAlignment="Center" />
                            <ProgressBar x:Name="WifiTransferProgressBar" Progress="0" ProgressColor="#007ACC" HeightRequest="8" HorizontalOptions="Fill" />
                            <Label x:Name="WifiTransferSpeedLabel" Text="0.0 Mo/s" TextColor="#00B0FF" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Footer -->
                    <Label Grid.Row="2"
                           Text="Wi-Fi Direct P2P &amp; Local Hotspot (Haute Vitesse)"
                           TextColor="#555555"
                           FontSize="10"
                           HorizontalOptions="Center" />
                </Grid>
            </Border>
        </ContentView>
    </Grid>

</ContentPage>
