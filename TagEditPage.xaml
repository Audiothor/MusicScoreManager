<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicScoreManager.TagEditPage"
             BackgroundColor="#121212"
             Title="Éditer l'étiquette">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Margin="20">
            <Label Text="Nom de l'étiquette" TextColor="#AAAAAA" />
            <Entry x:Name="NameEntry" 
                   TextColor="White" 
                   BackgroundColor="#1E1E1E" 
                   ClearButtonVisibility="WhileEditing" />

            <Label Text="Couleur" TextColor="#AAAAAA" />
            
            <FlexLayout x:Name="ColorsFlexLayout" Wrap="Wrap" JustifyContent="SpaceEvenly">
                <!-- Les couleurs seront injectées ici depuis le code-behind -->
            </FlexLayout>

            <Button Text="Enregistrer" 
                    BackgroundColor="#007ACC" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,20,0,0"
                    Clicked="OnSaveClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
