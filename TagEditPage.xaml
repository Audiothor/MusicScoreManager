<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicScoreManager.TagEditPage"
             BackgroundColor="#121212"
             Title="Éditer l'étiquette">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Margin="20">
            <Label Text="Nom de l'étiquette" TextColor="#AAAAAA" />
            <Entry x:Name="NameEntry" 
                   TextColor="White" 
                   BackgroundColor="#1E1E1E" 
                   ClearButtonVisibility="WhileEditing" />

            <Label Text="Couleurs de base" TextColor="#AAAAAA" />
            
            <FlexLayout x:Name="ColorsFlexLayout" Wrap="Wrap" JustifyContent="SpaceEvenly">
                <!-- Les couleurs seront injectées ici depuis le code-behind -->
            </FlexLayout>

            <Label Text="Couleur personnalisée (RGB)" TextColor="#AAAAAA" Margin="0,10,0,0" />
            
            <Grid ColumnDefinitions="40, *, 40" RowDefinitions="Auto, Auto, Auto" RowSpacing="10" ColumnSpacing="10">
                <Label Grid.Row="0" Grid.Column="0" Text="R" VerticalOptions="Center" TextColor="Red" />
                <Slider Grid.Row="0" Grid.Column="1" x:Name="RedSlider" Minimum="0" Maximum="255" DragCompleted="OnSliderValueChanged" />
                <Label Grid.Row="0" Grid.Column="2" Text="{Binding Source={x:Reference RedSlider}, Path=Value, StringFormat='{0:F0}'}" VerticalOptions="Center" />

                <Label Grid.Row="1" Grid.Column="0" Text="G" VerticalOptions="Center" TextColor="Green" />
                <Slider Grid.Row="1" Grid.Column="1" x:Name="GreenSlider" Minimum="0" Maximum="255" DragCompleted="OnSliderValueChanged" />
                <Label Grid.Row="1" Grid.Column="2" Text="{Binding Source={x:Reference GreenSlider}, Path=Value, StringFormat='{0:F0}'}" VerticalOptions="Center" />

                <Label Grid.Row="2" Grid.Column="0" Text="B" VerticalOptions="Center" TextColor="Blue" />
                <Slider Grid.Row="2" Grid.Column="1" x:Name="BlueSlider" Minimum="0" Maximum="255" DragCompleted="OnSliderValueChanged" />
                <Label Grid.Row="2" Grid.Column="2" Text="{Binding Source={x:Reference BlueSlider}, Path=Value, StringFormat='{0:F0}'}" VerticalOptions="Center" />
            </Grid>

            <Border x:Name="ColorPreview" HeightRequest="40" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label Text="Aperçu" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontAttributes="Bold" />
            </Border>

            <Button Text="Enregistrer" 
                    BackgroundColor="#007ACC" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,20,0,0"
                    Clicked="OnSaveClicked" />

            <Button x:Name="DeleteButton"
                    Text="Supprimer l'étiquette" 
                    BackgroundColor="#C0392B" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,0,0,20"
                    IsVisible="False"
                    Clicked="OnDeleteClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
