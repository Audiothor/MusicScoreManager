<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
		<!-- On définit les versions Android AVANT tout le reste -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36.0</TargetPlatformVersion>

		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0;net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<AssemblyName>MusicScoreManager</AssemblyName>
		<ApplicationTitle>MusicScoreManager</ApplicationTitle>
		<ApplicationId>com.audiothor.musicscoremanager</ApplicationId>
		<ApplicationIdGuid>3E6F90A1-B8D2-4E05-98E3-C9E2BCBE0F1F</ApplicationIdGuid>

		<ApplicationDisplayVersion>3.2.3</ApplicationDisplayVersion>
		<ApplicationVersion>32003</ApplicationVersion>
		<!-- Version actuelle : v3.2.3 "Optimisation de l'ouverture des paramètres d'application (chargement asynchrone et feedback instantané)" -->

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);IDE0028;IDE0300;IDE0301;IDE0305;IDE0290;IDE0005;IDE0090</NoWarn>
		
		<!-- Support universel : ARM32, ARM64 et x64 (émulateur) -->
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm;android-arm64;android-x64</RuntimeIdentifiers>
		<AndroidPackageFormats Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">aab;apk</AndroidPackageFormats>
	</PropertyGroup>

	<!-- Signature Android Release automatique avec le keystore officiel -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and Exists('$(MSBuildProjectDirectory)\keystore\musicscoremanager-release.keystore')">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(MSBuildProjectDirectory)\keystore\musicscoremanager-release.keystore</AndroidSigningKeyStore>
		<AndroidSigningStorePass>MSM_Secured_KeyStore_2026_Audiothor!#</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>musicscoremanager</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>MSM_Secured_KeyStore_2026_Audiothor!#</AndroidSigningKeyPass>
	</PropertyGroup>

	<!-- Optimisations et Obscurcissement R8 DEX pour Google Play (Seuil d'obscurcissement > 25%) -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidEnableCodeShrinking>true</AndroidEnableCodeShrinking>
		<AndroidLinkTool>r8</AndroidLinkTool>
		<AndroidCreateProguardMappingFile>true</AndroidCreateProguardMappingFile>
		<AndroidEnableProguardMapping>true</AndroidEnableProguardMapping>
	</PropertyGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<ProguardConfiguration Include="Platforms\Android\proguard.cfg" />
	</ItemGroup>



	<!-- Branding : Icône et Splash Screen -->
	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundScale="0.65" Color="#121212" />
		<MauiSplashScreen Include="Resources\Splash\app_splash_padded.png" Color="#1A2736" BaseSize="256,256" />
	</ItemGroup>

	<PropertyGroup>
		<!-- Chemins SDK Android / Java par défaut si non fournis en ligne de commande -->
		<AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('C:\Users\comme\AppData\Local\Android\Sdk')">C:\Users\comme\AppData\Local\Android\Sdk</AndroidSdkDirectory>
		<JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('C:\Program Files\Android\Android Studio\jbr')">C:\Program Files\Android\Android Studio\jbr</JavaSdkDirectory>

		<!-- Désactiver les avertissements d'audit pour les paquets transitifs -->
		<NuGetAudit>false</NuGetAudit>
		<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
		<NoWarn>$(NoWarn);NU1900;NU1902;NU1903;CS0618;XC0025;XC0022;CA1416;CA1422</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="14.1.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.41" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
		<PackageReference Include="SixLabors.ImageSharp" Version="2.1.9" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.core" Version="2.1.10" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />
		<PackageReference Include="SQLitePCLRaw.provider.dynamic_cdecl" Version="2.1.10" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<EmbeddedResource Include="Resources\Raw\Languages\*.json" LogicalName="Languages.%(Filename)%(Extension)" />
		<None Update="Resources\Raw\Languages\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>