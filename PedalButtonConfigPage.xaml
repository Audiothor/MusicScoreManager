<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MusicScoreManager.Models"
             xmlns:services="clr-namespace:MusicScoreManager.Services"
             x:Class="MusicScoreManager.PedalButtonConfigPage"
             BackgroundColor="#121212"
             Title="{Binding [Pedal_Config_Title], Source={x:Static services:LocalizationService.Instance}}">

    <Grid RowDefinitions="Auto, *">
        <!-- En-tête -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="12,10" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0" 
                    Text="{Binding [Common_Cancel], Source={x:Static services:LocalizationService.Instance}}" 
                    BackgroundColor="Transparent" 
                    TextColor="#007ACC" 
                    FontAttributes="Bold" 
                    Clicked="OnCancelClicked" />

            <Label Grid.Column="1" 
                   Text="{Binding [Pedal_Config_Title], Source={x:Static services:LocalizationService.Instance}}" 
                   TextColor="White" 
                   FontSize="17" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Center" />

            <Button Grid.Column="2" 
                    Text="{Binding [Pedal_Config_Save], Source={x:Static services:LocalizationService.Instance}}" 
                    BackgroundColor="#007ACC" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="13"
                    Padding="14,6"
                    CornerRadius="8"
                    Clicked="OnSaveClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18" Padding="16">

                <!-- A. NOM DU BOUTON / PÉDALE -->
                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding [Pedal_Config_Section_Name], Source={x:Static services:LocalizationService.Instance}}" TextColor="#007ACC" FontSize="15" FontAttributes="Bold" />
                        <Label Text="{Binding [Pedal_Config_Section_Name_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="12" />
                        <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#2A2A2A" Padding="12,0" Margin="0,4,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry x:Name="ButtonLabelEntry" 
                                   TextColor="White" 
                                   FontSize="15" 
                                   Placeholder="{Binding [Pedal_Config_Name_Placeholder], Source={x:Static services:LocalizationService.Instance}}" 
                                   PlaceholderColor="#777777" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- B. DÉTECTION DU SIGNAL (Bluetooth / MIDI) -->
                <Border x:Name="SignalBorderCard" Stroke="#007ACC" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="{Binding [Pedal_Config_Section_Signal], Source={x:Static services:LocalizationService.Instance}}" TextColor="#007ACC" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            <Border Grid.Column="1" x:Name="ListeningBadge" Stroke="#4CAF50" StrokeThickness="1" BackgroundColor="#1B3820" Padding="8,3">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label x:Name="ListeningLabel" Text="{Binding [Pedal_Config_Listening], Source={x:Static services:LocalizationService.Instance}}" TextColor="#81C784" FontSize="11" FontAttributes="Bold" />
                            </Border>
                        </Grid>

                        <Label Text="{Binding [Pedal_Config_Signal_Prompt], Source={x:Static services:LocalizationService.Instance}}" TextColor="#CCCCCC" FontSize="13" />

                        <!-- Zone d'affichage de la touche capturée -->
                        <Border x:Name="DetectedKeyBox" Stroke="#444444" StrokeThickness="1" BackgroundColor="#252525" Padding="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label x:Name="DetectedKeyLabel" 
                                           Text="{Binding [Pedal_Config_Press_Prompt], Source={x:Static services:LocalizationService.Instance}}" 
                                           TextColor="#4FC3F7" 
                                           FontSize="18" 
                                           FontAttributes="Bold" />
                                    <Label Grid.Column="1" 
                                           x:Name="DetectedSourceLabel" 
                                           Text="Bluetooth HID / MIDI" 
                                           TextColor="#888888" 
                                           FontSize="12" 
                                           VerticalOptions="Center" />
                                </Grid>
                                <Label x:Name="DetectedDetailsLabel" 
                                       Text="{Binding [Pedal_Config_Code_Not_Detected], Source={x:Static services:LocalizationService.Instance}}" 
                                       TextColor="#AAAAAA" 
                                       FontSize="13" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Option manuelle de secours pour tester sans pédale branchée -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,0">
                            <Label Text="{Binding [Pedal_Config_Manual_Or], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="12" VerticalOptions="Center" />
                            <Border Grid.Column="1" Stroke="#444444" StrokeThickness="1" BackgroundColor="#2A2A2A" Padding="8,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Picker x:Name="ManualKeyPicker" 
                                        TextColor="#CCCCCC" 
                                        Title="{Binding [Pedal_Config_Manual_Title], Source={x:Static services:LocalizationService.Instance}}" 
                                        TitleColor="#777777" 
                                        FontSize="12" 
                                        SelectedIndexChanged="OnManualKeyPickerChanged" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- C. TYPE D'APPUI (Simple vs Long) -->
                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding [Pedal_Config_Section_Press], Source={x:Static services:LocalizationService.Instance}}" TextColor="#007ACC" FontSize="15" FontAttributes="Bold" />
                        <Label Text="{Binding [Pedal_Config_Section_Press_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="12" />

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <!-- Option Appui simple -->
                            <Button Grid.Column="0" 
                                    x:Name="SimplePressBtn"
                                    Text="{Binding [Pedal_Config_Press_Simple], Source={x:Static services:LocalizationService.Instance}}" 
                                    BackgroundColor="#007ACC" 
                                    TextColor="White" 
                                    FontAttributes="Bold" 
                                    HeightRequest="46" 
                                    CornerRadius="8" 
                                    Clicked="OnSimplePressSelected" />

                            <!-- Option Appui long -->
                            <Button Grid.Column="1" 
                                    x:Name="LongPressBtn"
                                    Text="{Binding [Pedal_Config_Press_Long], Source={x:Static services:LocalizationService.Instance}}" 
                                    BackgroundColor="#2A2A2A" 
                                    TextColor="#888888" 
                                    BorderColor="#444444" 
                                    BorderWidth="1" 
                                    FontAttributes="Bold" 
                                    HeightRequest="46" 
                                    CornerRadius="8" 
                                    Clicked="OnLongPressSelected" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- D. ASSIGNATION DE L'ACTION (13 choix stricts) -->
                <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding [Pedal_Config_Section_Action], Source={x:Static services:LocalizationService.Instance}}" TextColor="#007ACC" FontSize="15" FontAttributes="Bold" />
                        <Label Text="{Binding [Pedal_Config_Section_Action_Desc], Source={x:Static services:LocalizationService.Instance}}" TextColor="#888888" FontSize="12" />

                        <Border Stroke="#444444" StrokeThickness="1" BackgroundColor="#2A2A2A" Padding="12,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Picker x:Name="ActionPicker" 
                                    TextColor="#81C784" 
                                    FontSize="15" 
                                    FontAttributes="Bold" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Bouton final Enregistrer -->
                <Button Text="{Binding [Pedal_Config_Save_Pedal], Source={x:Static services:LocalizationService.Instance}}" 
                        BackgroundColor="#007ACC" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        HeightRequest="48" 
                        CornerRadius="10" 
                        Margin="0,10,0,20"
                        Clicked="OnSaveClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
